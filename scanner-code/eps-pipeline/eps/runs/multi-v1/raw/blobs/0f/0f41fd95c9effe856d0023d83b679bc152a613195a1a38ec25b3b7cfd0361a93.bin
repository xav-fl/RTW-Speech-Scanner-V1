-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/stephanie-peacock","api_url":"https://www.gov.uk/api/content/government/people/stephanie-peacock","base_path":"/government/people/stephanie-peacock","content_id":"611cafa0-1b96-45fa-8a8a-7d254cba6ffb","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T10:26:24Z","schema_name":"person","title":"Stephanie Peacock MP","web_url":"https://www.gov.uk/government/people/stephanie-peacock","withdrawn":false},{"api_path":"/api/content/government/people/calvin-bailey","api_url":"https://www.gov.uk/api/content/government/people/calvin-bailey","base_path":"/government/people/calvin-bailey","content_id":"3042fdf6-d770-4324-b9e0-66d9fa922c71","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-06-18T08:37:42Z","schema_name":"person","title":"Calvin Bailey MBE MP","web_url":"https://www.gov.uk/government/people/calvin-bailey","withdrawn":false},{"api_path":"/api/content/government/people/douglas-alexander","api_url":"https://www.gov.uk/api/content/government/people/douglas-alexander","base_path":"/government/people/douglas-alexander","content_id":"93f2d702-c240-4895-bbdd-bde1d2fbc16d","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-09-05T19:03:52Z","schema_name":"person","title":"The Rt Hon Douglas Alexander MP","web_url":"https://www.gov.uk/government/people/douglas-alexander","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1423","api_path":"/api/content/government/organisations/scotland-office","api_url":"https://www.gov.uk/api/content/government/organisations/scotland-office","base_path":"/government/organisations/scotland-office","content_id":"63953ed9-98ac-4d08-a1b9-8ea38dbd0832","details":{"acronym":"","brand":"scotland-office","default_news_image":null,"logo":{"crest":"so","formatted_title":"Scotland Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Scotland Office","web_url":"https://www.gov.uk/government/organisations/scotland-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--330","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--330","base_path":"/government/ministers/parliamentary-under-secretary-of-state--330","content_id":"d0c9cce0-0a80-4167-9fd4-89c73e2a2d6f","details":{"body":"\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-23T10:23:40Z","schema_name":"role","title":"Parliamentary Under-Secretary of State","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--330","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--337","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--337","base_path":"/government/ministers/parliamentary-under-secretary-of-state--337","content_id":"00cbf342-8468-4d10-9ad3-6779f173ee3e","details":{"body":"\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-23T11:48:06Z","schema_name":"role","title":"Parliamentary Under-Secretary of State","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--337","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-scotland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-scotland","base_path":"/government/ministers/secretary-of-state-for-scotland","content_id":"845e65ce-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Scotland is the UK Government Cabinet Minister representing Scotland. They act as the custodian of the Scottish devolution settlement, represent Scottish interests within the UK Government, and advocate for the UK Government’s policies in Scotland. </p>\n\n<p>They also promote partnership between the UK Government and the Scottish Government, as well as relations between the UK and Scottish Parliaments.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Industrial Strategy Delivery</li>\n  <li>Local Growth and City Deals Strategy</li>\n  <li>Data, Digital and AI</li>\n  <li>Investment, Economy and Fiscal</li>\n  <li>Defence</li>\n  <li>Energy and North Sea Policy</li>\n  <li>Brand Scotland Programme</li>\n  <li>International &amp; Trade Missions</li>\n  <li>Constitutional and Devolution Policy</li>\n  <li>UK Internal Market</li>\n  <li>Intergovernmental Relations</li>\n  <li>Home Affairs</li>\n  <li>Corporate</li>\n</ul>\n","role_payment_type":null,"seniority":24,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T13:41:13Z","schema_name":"role","title":"Secretary of State for Scotland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-scotland","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/national-events-and-ceremonies","api_url":"https://www.gov.uk/api/content/society-and-culture/national-events-and-ceremonies","base_path":"/society-and-culture/national-events-and-ceremonies","content_id":"3506d46e-62d7-4602-93f5-fcb9bb2aade8","details":{"internal_name":"National events and ceremonies [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:31:27Z","schema_name":"taxon","title":"Society and culture","web_url":"https://www.gov.uk/society-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:12:17Z","schema_name":"taxon","title":"National events and ceremonies","web_url":"https://www.gov.uk/society-and-culture/national-events-and-ceremonies","withdrawn":false},{"api_path":"/api/content/society-and-culture/sports-and-leisure","api_url":"https://www.gov.uk/api/content/society-and-culture/sports-and-leisure","base_path":"/society-and-culture/sports-and-leisure","content_id":"f9e476ef-654d-41ec-97d9-2b6842d4361d","details":{"internal_name":"Sports and leisure [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links"