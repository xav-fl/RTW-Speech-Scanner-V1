{"analytics_identifier":null,"base_path":"/government/publications/dfe-update-22-july-2026","content_id":"6f9bfd8b-2583-45cc-9e85-94b9d91f60ef","description":"Latest information and actions from the Department for Education about funding, assurance and resource management, for academies, local authorities and further education providers.","details":{"attachments":[{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372752","isbn":"","title":"DfE Update further education: 22 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-22-july-2026/dfe-update-further-education-22-july-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372755","isbn":"","title":"DfE Update academies: 22 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-22-july-2026/dfe-update-academies-22-july-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372757","isbn":"","title":"DfE Update local authorities: 22 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-22-july-2026/dfe-update-local-authorities-22-july-2026"}],"body":"<div class=\"govspeak\"><h2 id=\"latest-for-further-education\">Latest for further education</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Final request to upload your subcontracting standard evidence by Monday 31 August 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>2025 to 2026 qualification achievement rates guidance published</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Update to college financial planning handbook</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit technical funding guide from August 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship workforce development resources</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Skills Bootcamp eligibility extended for young people</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-academies\">Latest for academies</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Complete your academies budget forecast return form by Thursday 24 September 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Prepare for the school estate management standards annual return</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit technical funding guide from August 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship workforce development resources</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Skills Bootcamp eligibility extended for young people</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help shape a new service for buying management information systems</td>\n    </tr>\n    <tr>\n      <td>Events and Webinars</td>\n      <td>Academies chart of accounts technical updates for 2026 to 2027, Tuesday 4 August 2026</td>\n    </tr>\n    <tr>\n      <td>Events and Webinars</td>\n      <td>Academies chart of accounts technical updates for 2026 to 2027, Thursday 6 August 2026</td>\n    </tr>\n    <tr>\n      <td>Events and Webinars</td>\n      <td>Budget forecast return weekly sector calls</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-local-authorities\">Latest for local authorities</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Final request to upload your subcontracting standard evidence by Monday 31 August 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Prepare for the school estate management standards annual return</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit funding rules for 2026 to 2027</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship unit technical funding guide from August 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Apprenticeship workforce development resources</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Skills Bootcamp eligibility extended for young people</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help shape a new service for buying management information systems</td>\n    </tr>\n  </tbody>\n</table>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-07-22T14:28:47Z"}],"document_type_label":"Correspondence","emphasised_organisations":["ebd15ade-73b2-4eaf-b1c3-43034a42eb37"],"featured_attachments":["9372752","9372755","9372757"],"first_public_at":"2026-07-22T15:28:47.000+01:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotla