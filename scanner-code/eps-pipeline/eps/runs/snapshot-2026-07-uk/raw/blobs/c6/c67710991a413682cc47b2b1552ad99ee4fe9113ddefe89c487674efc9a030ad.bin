cd68-dc0c-4041-9c3a-df59a5357c23","details":{"acronym":"AGO","brand":"attorney-generals-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5cd1619de5274a34eb6b9945/s960_Courts_of_Justice_new.jpg","url":"https://assets.publishing.service.gov.uk/media/5cd1619d40f0b6332070f272/s300_Courts_of_Justice_new.jpg"},"logo":{"crest":"single-identity","formatted_title":"Attorney <br/>General&#39;s <br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Attorney General's Office","web_url":"https://www.gov.uk/government/organisations/attorney-generals-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/solicitor-general","api_url":"https://www.gov.uk/api/content/government/ministers/solicitor-general","base_path":"/government/ministers/solicitor-general","content_id":"845e6af3-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Solicitor General supports the Attorney across a range of responsibilities. This includes:</p>\n\n<ul>\n  <li>Responsibility for matters delegated by the Attorney General, including deputising for the Attorney at the Parliamentary Business and Legislation Cabinet Committee</li>\n  <li>Providing support to the Attorney General in their superintendence of the Government Legal Department, the Crown Prosecution Service, HM Crown Prosecution Service Inspectorate and the Serious Fraud Office</li>\n  <li>Supporting the Attorney General in their public interest functions</li>\n  <li>Promoting the rule of law at home and internationally</li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-22T13:25:44Z","schema_name":"role","title":"Solicitor General","web_url":"https://www.gov.uk/government/ministers/solicitor-general","withdrawn":false}],"taxo