ion":[{"analytics_identifier":"D16","api_path":"/api/content/government/organisations/home-office","api_url":"https://www.gov.uk/api/content/government/organisations/home-office","base_path":"/government/organisations/home-office","content_id":"06056197-bc69-4147-aa28-070bca132178","details":{"acronym":"Home Office","brand":"home-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/669fa7f5ce1fd0da7b592afc/s960_2MS_Home_Office_sign_-_landscape.jpg","url":"https://assets.publishing.service.gov.uk/media/669fa7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--204","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--204","base_path":"/government/ministers/minister-of-state--204","content_id":"aafeb26d-f833-4d2f-a0a3-7ec56abf922e","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>police accountability and system reform – professional standards, performance, culture  </li>\n  <li>police resourcing and efficiency – neighbourhood policing guarantee, savings, funding </li>\n  <li>public order, major events, civil contingencies </li>\n  <li>Emergency Services Mobile Communication Programme </li>\n  <li>criminal justice system </li>\n  <li>Early intervention and Young Futures   </li>\n  <li>crime prevention: safer streets, including drugs and county lines, alcohol and licensing, anti-social behaviour, neighbourhood crime, firearms, child criminal exploitation and hate crime.</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-31T14:18:35Z","schema_name":"role","title":"Minister of State (Minister for Policing and Crime)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--204","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/knife-gun-and-gang-crime","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/knife-gun-and-gang-crime","base_path":"/crime-justice-and-law/knife-gun-and-gang-crime","content_id":"587fd3ee-c009-4a49-8b30-557300c55bd1","details":{"internal_name":"Knife, gun and gang crime [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Knife, gun and gang crime","web_url":"https://www.gov.uk/crime-justice-and-law/knife-gun-and-gang-crime","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-10T09:53:00+01:00","publishing_app":"whitehall","publishing_requ