t":"2026-07-13T16:15:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784117106.881-10.13.21.168-150240","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK sanctions Iran-linked criminal group that publicly claimed responsibility for recent attacks on Jewish locations","updated_at":"2026-09-15T08:59:48+01:00","withdrawn_notice":{}}