:"live","public_updated_at":"2018-09-03T15:41:05Z","schema_name":"taxon","title":"Trade and investment","web_url":"https://www.gov.uk/business-and-industry/trade-and-investment","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:06Z","schema_name":"taxon","title":"Exporting","web_url":"https://www.gov.uk/business-and-industry/exporting","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:06Z","schema_name":"taxon","title":"Export finance","web_url":"https://www.gov.uk/business-and-industry/export-finance","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-23T11:57:27+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784804247.266-10.13.21.19-2652","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK Export Finance backs sustainable fuel to drive growth and cut emissions","updated_at":"2026-09-14T11:48:56+01:00","withdrawn_notice":{}}