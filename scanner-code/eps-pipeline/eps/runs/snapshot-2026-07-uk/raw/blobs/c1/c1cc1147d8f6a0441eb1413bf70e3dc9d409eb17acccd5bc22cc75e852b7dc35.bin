omepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.gov.uk/international","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:14:19Z","schema_name":"taxon","title":"International aid and development","web_url":"https://www.gov.uk/international/international-aid-and-development","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-27T10:27:50+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785849553.550-10.13.20.90-713833","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK strengthens commitment to global development as Foreign Secretary becomes UK Governor to the World Bank","updated_at":"2026-09-15T09:01:31+01:00","withdrawn_notice":{}}