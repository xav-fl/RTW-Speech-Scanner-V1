"schema_name":"person","title":"The Rt Hon Ed Miliband MP","web_url":"https://www.gov.uk/government/people/ed-miliband","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--214","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--214","base_path":"/government/ministers/minister-of-state--214","content_id":"d1b61a2a-4fc4-4450-8fac-ff5b161358c3","details":{"body":"<p>The Minister of State has responsibility for:</p>\n\n<ul>\n  <li>\n    <p>Africa  </p>\n  </li>\n  <li>\n    <p>development and humanitarian   </p>\n  </li>\n  <li>\n    <p>international finance  </p>\n  </li>\n  <li>\n    <p>climate and energy security</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-29T09:36:55Z","schema_name":"role","title":"Minister of State for International Development","web_url":"https://www.gov.uk/government/ministers/minister-of-state--214","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba75a-42bd-4e1e-984c-2bddb6b41951","details":{"internal_name":"Foreign affairs [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8