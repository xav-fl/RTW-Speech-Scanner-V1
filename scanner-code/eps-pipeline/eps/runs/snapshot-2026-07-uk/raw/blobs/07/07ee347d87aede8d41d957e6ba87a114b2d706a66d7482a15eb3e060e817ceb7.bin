sets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"government":[{"api_path":"/api/content/government/2026-burnham-labour-government","api_url":"https://www.gov.uk/api/content/government/2026-burnham-labour-government","base_path":"/government/2026-burnham-labour-government","content_id":"1fb8162a-7f42-4a44-ae9b-42e8d8f36807","details":{"current":true,"ended_on":null,"started_on":"2026-07-20T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2026 Burnham Labour government","web_url":"https://www.gov.uk/government/2026-burnham-labour-government"}],"organisations":[{"analytics_identifier":"D10","api_path":"/api/content/government/organisations/department-for-work-pensions","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-work-pensions","base_path":"/government/organisations/department-for-work-pensions","content_id":"b548a09f-8b35-4104-89f4-f1a40bf3136d","details":{"acronym":"DWP","brand":"department-for-work-pensions","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dab1e5274a7908e35204/s960_dwp-caxton-house-logo-960.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dab040f0b649cfaf7b4b/s300_dwp-caxton-house-logo-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Work &amp; <br/>Pensions"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Work and Pensions","web_url":"https://www.gov.uk/government/organisations/department-for-work-pensions","withdrawn":false},{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D10","api_path":"/api/content/government/organisations/department-for-work-pensions","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-work-pensions","base_path":"/government/organisations/department-for-work-pensions","content_id":"b548a09f-8b35-4104-89f4-f1a40bf3136d","details":{"acronym":"DWP","brand":"department-for-work-pensions","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dab1e5274a7908e35204/s960_dwp-caxton-house-logo-960.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dab040f0b649cfaf7b4b/s300_dwp-caxton-house-logo-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Work &amp; <br/>Pensions"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Work and Pensions","web_url":"https://www.gov.uk/government/organisations/department-for-work-pensions","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/apprenticeships-traineeships-and-internships","api_url":"https://www.gov.uk/api/content/education/apprenticeships-traineeships-and-internships","base_path":"/education/apprenticeships-traineeships-and-internships","content_id":"aaeb7f58-d410-4c42-8775-05b0bdeceeea","description":"Finding an apprenticeship, internship or traineeship plus guidance for employers on offering training opportunities.","details":{"internal_name":"Apprenticeships, traineeships and internships","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-05-30T09:56:25Z","schema_name":"taxon","title":"Apprenticeships, traineeships and internships","web_url":"https://www.gov.uk/education/apprenticeships-traineeships-and-internships","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-28T16:00:02+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785251004.915-10.13.21.128-519963","publishing_scheduled_at":"2026-07-28T16:00:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Government invests in young people with more opportunities close to home","updated_at":"2026-09-24T16:54:26+01:00","withdrawn_notice":{}}