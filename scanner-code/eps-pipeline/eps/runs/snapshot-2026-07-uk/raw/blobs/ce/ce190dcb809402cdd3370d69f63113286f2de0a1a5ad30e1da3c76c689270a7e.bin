/stephen-kinnock","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--182","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--182","base_path":"/government/ministers/minister-of-state--182","content_id":"d80f7787-0357-4f2f-b08d-f1244296cf7c","details":{"body":"<p>The Minister of State for Care is responsible for:</p>\n\n<ul>\n  <li>adult social care</li>\n  <li>neighbourhood health</li>\n  <li>primary care\n    <ul>\n      <li>general practice</li>\n      <li>dentistry</li>\n      <li>pharmacy</li>\n      <li>eyecare</li>\n    </ul>\n  </li>\n  <li>community healthcare</li>\n  <li>frailty and dementia</li>\n  <li>end of life and palliative care</li>\n  <li>men’s health</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-06-05T10:06:37Z","schema_name":"role","title":"Minister of State for Care","web_url":"https://www.gov.uk/government/ministers/minister-of-state--182","withdrawn":false}],"taxons":[{"api_path":"/api/content/health-and-social-care/health-workforce","api_url":"https://www.gov.uk/api/content/health-and-social-care/health-workforce","base_path":"/health-and-social-care/health-workforce","content_id":"1309a4b3-17b5-40ec-9747-16cd2ef65dc6","description":"","details":{"internal_name":"Health workforce","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/health-and-social-care/national-health-service","api_url":"https://www.gov.uk/api/content/health-and-social-care/national-health-service","base_path":"/health-and-social-care/national-health-service","content_id":"f3dcc290-752f-4bbe-b379-9155d919a58d","details":{"internal_name":"National Health Service (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/health-and-social-care","api_url":"https://www.gov.uk/api/content/health-and-social-care","base_path":"/health-and-social-care","content_id":"8124ead8-8ebc-4faf-88ad-dd5cbcc92ba8","description":"","details":{"internal_name":"Health and social care","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:51Z","schema_name":"taxon","title":"Health and social care","web_url":"https://www.gov.uk/health-and-social-care","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T12:56:21Z","schema_name":"taxon","title":"National Health Service","web_url":"https://www.gov.uk/health-and-social-care/national-health-service","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-02-05T14:56:16Z","schema_name":"taxon","title":"Health workforce","web_url":"https://www.gov.uk/health-and-social-care/health-workforce","withdrawn":false},{"api_path":"/api/content/health-and-social-care/social-care","api_url":"https://www.gov.uk/api/content/health-and-social-care/social-care","base_path":"/health-and-social-care/social-care","content_id":"7d67047c-bf22-4c34-b566-b46d6973f961","details":{"internal_name":"Social care (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/health-and-social-care","api_url":"https://www.gov.uk/api/content/health-and-social-care","base_path":"/health-and-social-care","content_id":"8124ead8-8ebc-4faf-88ad-dd5cbcc92ba8","description":"","details":{"internal_name":"Health and social care","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:51Z","schema_name":"taxon","title":"Health and social care","web_url":"https://www.gov.uk/health-and-social-care","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T12:56:16Z","schema_name":"taxon","title":"Social care","web_url":"https://www.gov.uk/health-and-social-care/social-care","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-16T09:15:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784215109.960-10.13.20.148-2390","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Care workers to be represented in fair pay agreements","updated_at":"2026-09-22T11:13:00+01:00","withdrawn_notice":{}}