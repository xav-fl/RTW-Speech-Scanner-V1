2026_community_update_Urdu.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":197722,"filename":"July_2026_community_update_Urdu.pdf","id":"9366094","isbn":"","number_of_pages":2,"title":"Grenfell Tower community update: July 2026 - Urdu","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/6a3e4fdceaee00074150f612/July_2026_community_update_Urdu.pdf"},{"accessible":true,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"6a3e4fecd52550a19950f5e3","filename":"July_2026_community_update_Vietnamese.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":183081,"filename":"July_2026_community_update_Vietnamese.pdf","id":"9366095","isbn":"","number_of_pages":3,"title":"Grenfell Tower community update: July 2026 - Vietnamese","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/6a3e4fecd52550a19950f5e3/July_2026_community_update_Vietnamese.pdf"}],"body":"<div class=\"govspeak\"><p>The government recognises that Grenfell Tower has a deep personal significance to those most affected by the tragedy and that all work at the Grenfell Tower site is sensitive.</p>\n\n<p>We continue to share information about the Tower, and listen to bereaved families, survivors, and residents in the immediate community. </p>\n\n<p>In this community update, we provide information about how the government and its contractors are taking down Grenfell Tower with respect and care.</p>\n\n<p>It also includes information on dust, noise and vibration monitoring.<br>\nThe update is translated into 12 languages.</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-07-01T09:00:01Z"}],"document_type_label":"Correspondence","emphasised_organisations":["1390d07f