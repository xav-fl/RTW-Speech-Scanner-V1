axon","title":"Science and innovation","web_url":"https://www.gov.uk/business-and-industry/science-and-innovation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2022-03-08T11:13:39Z","schema_name":"taxon","title":"Artificial intelligence","web_url":"https://www.gov.uk/business-and-industry/artificial-intelligence","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-24T14:20:16+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784899215.997-10.13.22.186-2330","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"AI to power change at the heart of government as Lord Vallance appointed chair of new PM AI Taskforce","updated_at":"2026-09-10T10:50:37+01:00","withdrawn_notice":{}}