nt/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/wes-streeting","api_url":"https://www.gov.uk/api/content/government/people/wes-streeting","base_path":"/government/people/wes-streeting","content_id":"4e204b10-26bd-4865-bb74-dd530152a006","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T10:01:19Z","schema_name":"person","title":"The Rt Hon Wes Streeting MP","web_url":"https://www.gov.uk/government/people/wes-streeting","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/international-defence-commitments","api_url":"https://www.gov.uk/api/content/defence/international-defence-commitments","base_path":"/defence/international-defence-commitments","content_id":"9f183c2c-2256-42d7-a12d-ced7b7f24195","description":"What the government’s doing about international defence commitments\r\n","details":{"internal_name":"International defence commitments (level 2) [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"International defence commitments","web_url":"https://www.gov.uk/defence/international-defence-commitments","withdrawn":false}],"world_locations":[{"analytics_identifier":"WL154","content_id":"5e9f274b-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{},"locale":"en","public_updated_at":"2022-02-23T11:37:06Z","schema_name":"world_location","title":"Ukraine","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-24T08:00:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785149141.910-10.13.22.182-421095","publishing_scheduled_at":"2026-07-24T08:00:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":1,"schema_name":"news_article","title":"UK takes command of multinational force for Ukraine","updated_at":"2026-09-10T10:48:25+01:00","withdrawn_notice":{}}