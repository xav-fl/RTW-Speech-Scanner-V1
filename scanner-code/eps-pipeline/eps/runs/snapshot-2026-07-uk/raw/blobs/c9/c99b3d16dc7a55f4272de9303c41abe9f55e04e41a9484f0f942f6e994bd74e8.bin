ets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false},{"analytics_identifier":"D1380","api_path":"/api/content/government/organisations/department-for-energy-security-and-net-zero","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-energy-security-and-net-zero","base_path":"/government/organisations/department-for-energy-security-and-net-zero","content_id":"6315817c-ef11-4905-bb4d-b6dca8e9052c","details":{"acronym":"DESNZ","brand":"department-for-energy-security-net-zero","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/656df1fd1104cf000dfa74a1/s960_whitehall-place-exterior-960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/656df1fd0f12ef07a53e01be/s300_whitehall-place-exterior-960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Energy Security<br/>&amp; Net Zero"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Energy Security and Net Zero","web_url":"https://www.gov.uk/government/organisations/department-for-energy-security-and-net-zero","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/andy-burnham","api_url":"https://www.gov.uk/api/content/government/people/andy-burnham","base_path":"/government/people/andy-burnham","content_id":"762a5ae3-c159-4fb4-8f4e-a828e41f77b3","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T11:15:02Z","schema_name":"person","title":"The Rt Hon Andy Burnham MP","web_url":"https://www.gov.uk/government/people/andy-burnham","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"OT532","api_path":"/api/content/government/organisations/prime-ministers-office-10-downing-street","api_url":"https://www.gov.uk/api/content/government/organisations/prime-ministers-office-10-downing-street","base_path":"/government/organisations/prime-ministers-office-10-downing-street","content_id":"705dbea4-8bd7-422e-ba9c-254557f77f81","details":{"acronym":"Number 10","brand":"prime-ministers-office-10-downing-street","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37daeaed915d5a5f96602b/s960_number10.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dae940f0b649cceb1841/s300_number10.jpg"},"logo":{"crest":"eo","formatted_title":"Prime Minister&#39;s Office <br/>10 Downing Street"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Prime Minister's Office, 10 Downing Street","web_url":"https://www.gov.uk/government/organisations/prime-ministers-office-10-downing-street","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/household-energy","api_url":"https://www.gov.uk/api/content/housing-local-and-community/household-energy","base_path":"/housing-local-and-community/household-energy","content_id":"6bb7a2d2-1693-4682-a52c-a17d7fca9c3e","description":"","details":{"internal_name":"Household energy","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T12:08:15Z","schema_name":"taxon","title":"Household energy","web_url":"https://www.gov.uk/housing-local-and-community/household-energy","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-21T06:05:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784627713.587-10.13.20.44-2760","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"New PM cuts tax on household electricity bills to give breathing space on cost of living","updated_at":"2026-09-16T12:40:16+01:00","withdrawn_notice":{}}