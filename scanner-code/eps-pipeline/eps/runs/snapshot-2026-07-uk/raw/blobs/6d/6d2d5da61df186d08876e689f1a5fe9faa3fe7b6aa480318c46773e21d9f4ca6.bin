,"withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":14,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/childcare-parenting/youth-employment-and-social-issues","api_url":"https://www.gov.uk/api/content/childcare-parenting/youth-employment-and-social-issues","base_path":"/childcare-parenting/youth-employment-and-social-issues","content_id":"43fcdde6-59c5-487f-a969-a046b334cbec","description":"Developing social and emotional skills, improving outcomes, guidance for local authorities on reporting data.","details":{"internal_name":"Youth employment and social issues","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting","api_url":"https://www.gov.uk/api/content/childcare-parenting","base_path":"/childcare-parenting","content_id":"206b7f3a-49b5-476f-af0f-fd27e2a68473","description":"Financial support, finding and providing childcare, pregnancy and birth, adoption and fostering, looked-after children, safeguarding.","details":{"internal_name":"Parenting, childcare and childrens services","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-07-27T13:29:23Z","schema_name":"taxon","title":"Parenting, childcare and children's services ","web_url":"https://www.gov.uk/childcare-parenting","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-07-27T13:41:46Z","schema_name":"taxon","title":"Youth employment and social issues","web_url":"https://www.gov.uk/childcare-parenting/youth-employment-and-social-issues","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-02T00:01:03+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782931968.421-10.13.22.246-2539","publishing_scheduled_at":"2026-07-02T00:01:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":3,"schema_name":"news_article","title":"Councils supported to identify and support vulnerable teenagers","updated_at":"2026-09-24T16:57:51+01:00","withdrawn_notice":{}}