overnment/people/rachel-reeves","api_url":"https://www.gov.uk/api/content/government/people/rachel-reeves","base_path":"/government/people/rachel-reeves","content_id":"18ff123b-9f73-4e6d-98a2-a693ecefbc37","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:48:57Z","schema_name":"person","title":"The Rt Hon Rachel Reeves MP","web_url":"https://www.gov.uk/government/people/rachel-reeves","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/chancellor-of-the-exchequer","api_url":"https://www.gov.uk/api/content/government/ministers/chancellor-of-the-exchequer","base_path":"/government/ministers/chancellor-of-the-exchequer","content_id":"845e5c6b-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Chancellor of the Exchequer is the government’s chief financial minister and is responsible for growing the UK economy, raising revenue through taxation or borrowing and for controlling public spending. He has overall responsibility for the work of the Treasury. </p>\n\n<p>The Chancellor’s responsibilities cover:  </p>\n\n<ul>\n  <li>\n    <p>Economic and fiscal policy (including presenting the annual Budget) </p>\n  </li>\n  <li>\n    <p>Oversight of the monetary framework, including setting the inflation remit, and liaison with the Governor of the Bank of England on monetary policy </p>\n  </li>\n  <li>\n    <p>UK growth and productivity, including working across government on innovation, new technologies, skills, labour markets, migration and competition.   </p>\n  </li>\n  <li>\n    <p>UK public financial institutions  </p>\n  </li>\n  <li>\n    <p>Capital markets and listings </p>\n  </li>\n  <li>\n    <p>Leading on international economic and financial affairs including at the G7 and G20 and acting as the UK Governor of the IMF, EBRD and AIIB.  </p>\n  </li>\n  <li>\n    <p>Economic security and resilience policy </p>\n  </li>\n  <li>\n    <p>International defence and security financing</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:12:00Z","schema_name":"role","title":"Chancellor of the Exchequer","web_url":"https://www.gov.uk/government/ministers/chancellor-of-the-exchequer","withdrawn":false}],"taxons":[{"api_path":"/api/content/business-and-industry/financial-services","api_url":"https://www.gov.uk/api/content/business-and-industry/financial-services","base_path":"/business-and-industry/financial-services","content_id":"d7e02519-b7ba-4297-80a8-01cd0e5f2cb2","details":{"internal_name":"Financial services ","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Business and industry","web_url":"https://www.gov.uk/business-and-industry","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T20:10:12Z","schema_name":"taxon","title":"Financial services","web_url":"https://www.gov.uk/business-and-industry/financial-services","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-13T17:12:57+01:00","publishing_app":"whitehall","publishing_request_id":"22-1783959177.201-10.13.21.95-2808","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"publication","title":"Recommendations for the Financial Conduct Authority: November 2024","updated_at":"2026-09-10T10:48:13+01:00","withdrawn_notice":{}}