/654bbccfe70413000dfc4a51/s300_dft-gmh-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Transport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--343","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--343","base_path":"/government/ministers/parliamentary-under-secretary-of-state--343","content_id":"7beaa3b6-e04d-482d-b478-2facf481b201","details":{"body":"<p>The Minister for Aviation, Maritime and Logistics is responsible for:</p>\n\n<ul>\n  <li>aviation</li>\n  <li>freight and borders</li>\n  <li>Heathrow expansion</li>\n  <li>international</li>\n  <li>maritime</li>\n  <li>security and resilience</li>\n  <li>sustainable aviation fuel (<abbr title=\"sustainable aviation fuel\">SAF</abbr>)</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-19T13:55:24Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Aviation, Maritime and Logistics)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--343","withdrawn":false}],"taxons":[{"api_path":"/api/content/transport/aviation","api_url":"https://www.gov.uk/api/content/transport/aviation","base_path":"/transport/aviation","content_id":"51efa3dd-e9bc-42b2-aa26-06bf5f543015","description":"Aviation and airspace policy, airport expansion, airline routes, passenger experience and air accidents.","details":{"internal_name":"Aviation","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon",