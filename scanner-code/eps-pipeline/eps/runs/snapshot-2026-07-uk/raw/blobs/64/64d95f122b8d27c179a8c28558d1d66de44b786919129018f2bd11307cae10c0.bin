urity </li>\n  <li>trade remedies </li>\n  <li>sanctions  </li>\n  <li>import / export controls </li>\n</ul>\n\n<p>Public bodies:  </p>\n\n<ul>\n  <li>Trade Remedies Authority  </li>\n  <li>UK Export Finance</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-18T12:38:46Z","schema_name":"role","title":"Minister of State (Minister for Trade)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--206","withdrawn":false}],"taxons":[{"api_path":"/api/content/business-and-industry/free-trade","api_url":"https://www.gov.uk/api/content/business-and-industry/free-trade","base_path":"/business-and-industry/free-trade","content_id":"00eb9a66-ca33-4515-b425-b01bffc43ff1","details":{"internal_name":"Free trade [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry/trade-and-investment","api_url":"https://www.gov.uk/api/content/business-and-industry/trade-and-investment","base_path":"/business-and-industry/trade-and-investment","content_id":"ed2ca1f7-5463-4eda-9324-b597e269e242","details":{"internal_name":"Trade and investment","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00