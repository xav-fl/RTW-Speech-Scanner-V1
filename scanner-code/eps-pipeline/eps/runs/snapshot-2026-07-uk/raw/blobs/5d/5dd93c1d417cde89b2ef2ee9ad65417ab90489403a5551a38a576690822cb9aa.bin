k/government/news/uk-financial-system-strengthened-with-new-safeguards-for-major-technology-providers","withdrawn":false}]},"locale":"en","public_updated_at":"2026-07-15T08:43:58Z","schema_name":"document_collection","title":"Mansion House 2026","web_url":"https://www.gov.uk/government/collections/mansion-house-2026","withdrawn":false}],"emphasised_organisations":[{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/rachel-blake","api_url":"https://www.gov.uk/api/content/government/people/rachel-blake","base_path":"/government/people/rachel-blake","content_id":"5fe382f9-0688-4a37-ac84-4097dd71e6c3","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T08:45:32Z","schema_name":"person","title":"Rachel Blake MP","web_url":"https://www.gov.uk/government/people/rachel-blake","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/economic-secretary-to-the-treasury--3","api_url":"https://www.gov.uk/api/content/government/ministers/economic-secretary-to-the-treasury--3","base_path":"/government/ministers/economic-secretary-to-the-treasury--3","content_id":"60e177b0-be7e-4b6b-a0e8-8291952cefa8","details":{"body":"<p>The Economic Secretary to the Treasury (EST) is the City Minister and is responsible for financial services policy, reform and regulation. She is also responsible for some specific elements of tax policy. EST also supports the Chancellor on multilateral international policy and engagement.  </p>\n\n<ul>\n  <li>\n    <p>Specific financial services responsibilities include: </p>\n  </li>\n  <li>\n    <p>Engagement with the financial services sector </p>\n  </li>\n  <li>\n    <p>Financial conduct and financial stability, including relationships with the FCA and PRA </p>\n  </li>\n  <li>\n    <p>Competitiveness and growth of the financial services sector </p>\n  </li>\n  <li>\n    <p>Banking and consumer credit </p>\n  </li>\n  <li>\n    <p>Insurance and pensions markets </p>\n  </li>\n  <li>\n    <p>Financial inclusion and capability </p>\n  </li>\n  <li>\n    <p>Sustainable finance </p>\n  </li>\n  <li>\n    <p>Fintech, digitalisation and cryptoassets </p>\n  </li>\n  <li>\n    <p>International financial services policy </p>\n  </li>\n  <li>\n    <p>Cash and Payments including Royal Mint </p>\n  </li>\n  <li>\n    <p>Elements of tax policy including financial services tax, ISAs and savings tax  </p>\n  </li>\n  <li>\n    <p>Financial sanctions and countering economic crime, including the Office for Financial Sanctions Implementation (OFSI) </p>\n  </li>\n  <li>\n    <p>Supporting the Chancellor on international policy work, including: </p>\n  </li>\n  <li>\n    <p>Multilateral development banks </p>\n  </li>\n  <li>\n    <p>Ukraine –  financing, sanctions, economic pressure  </p>\n  </li>\n  <li>\n    <p>G20 presidency planning </p>\n  </li>\n  <li>\n    <p>Trade </p>\n  </li>\n  <li>\n    <p>Women in Finance, Women in the economy and the gender pay gap  </p>\n  </li>\n  <li>\n    <p>The Treasury’s interest in Overseas Territories and Crown Dependencies issues</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:16:20Z","schema_name":"role","title":"Economic Secretary to the Treasury","web_url":"https://www.gov.uk/government/ministers/economic-secretary-to-the-treasury--3","withdrawn":false}],"taxons":[{"api_path":"/api/content/business/financial-services-regulation","api_url":"https://www.gov.uk/api/content/business/financial-services-regulation","base_path":"/business/financial-services-regulation","content_id":"9e7ea8b0-dc6d-4d16-a659-58f3f7248792","details":{"internal_name":"Financial services regulation [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry/financial-services","api_url":"https://www.gov.uk/api/content/business-and-industry/financial-services","base_path":"/business-and-industry/financial-services","content_id":"d7e02519-b7ba-4297-80a8-01cd0e5f2cb2","details":{"internal_name":"Financial services ","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Business and industry","web_url":"https://www.gov.uk/business-and-industry","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T20:10:12Z","schema_name":"taxon","title":"Financial services","web_url":"https://www.gov.uk/business-and-industry/financial-services","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:05Z","schema_name":"taxon","title":"Financial services regulation","web_url":"https://www.gov.uk/business/financial-services-regulation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-10T11:06:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783678264.168-10.13.22.200-2594","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK financial system strengthened with new safeguards for major technology providers","updated_at":"2026-09-10T10:50:52+01:00","withdrawn_notice":{}}