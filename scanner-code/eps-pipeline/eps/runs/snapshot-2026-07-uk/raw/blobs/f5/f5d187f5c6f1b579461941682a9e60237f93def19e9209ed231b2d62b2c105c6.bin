,"scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Businesses across Britain sign up to Cyber Resilience Pledge as ministers urge firms to strengthen cyber defences","updated_at":"2026-09-10T10:48:06+01:00","withdrawn_notice":{}}