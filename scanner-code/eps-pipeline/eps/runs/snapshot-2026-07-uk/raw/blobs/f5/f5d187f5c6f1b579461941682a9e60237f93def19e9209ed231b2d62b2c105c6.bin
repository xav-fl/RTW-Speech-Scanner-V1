o":{"crest":"single-identity","formatted_title":"Department for<br/>Science, Innovation<br/>&amp; Technology"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/organisations/department-for-science-innovation-and-technology","withdrawn":false},{"analytics_identifier":"OT1211","api_path":"/api/content/government/organisations/national-cyber-security-centre","api_url":"https://www.gov.uk/api/content/government/organisations/national-cyber-security-centre","base_path":"/government/organisations/national-cyber-security-centre","content_id":"268e0f61-a32c-4cfb-8c89-96a504919b35","details":{"acronym":"NCSC","brand":"foreign-commonwealth-office","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"NCSC"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"https://www.ncsc.gov.uk/"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"National Cyber Security Centre","web_url":"https://www.gov.uk/government/organisations/national-cyber-security-centre","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/liz-kendall","api_url":"https://www.gov.uk/api/content/government/people/liz-kendall","base_path":"/government/people/liz-kendall","content_id":"54fcf58c-1a33-4e1a-8312-7c396cbad1e5","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:12:57Z","schema_name":"person","title":"The Rt Hon Liz Kendall MP","web_url":"https://www.gov.uk/government/people/liz-kendall","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1381","api_path":"/api/content/government/organisations/department-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-science-innovation-and-technology","base_path":"/government/organisations/department-for-science-innovation-and-technology","content_id":"c352c234-8083-47ec-8a4b-0edd45c31263","details":{"acronym":"DSIT","brand":"department-for-science-innovation-technology","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/68a86caf969253904d1557b7/s960_DSIT_GovUK.png","url":"https://assets.publishing.service.gov.uk/media/68a86caf960e2d135b4c8da5/s300_DSIT_GovUK.png"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Science, Innovation<br/>&amp; Technology"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/organisations/department-for-science-innovation-and-technology","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","base_path":"/government/ministers/secretary-of-state-for-science-innovation-and-technology","content_id":"ea18a87c-95fa-44c0-b769-e0056c2b03bc","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Science, Innovation and Technology. See junior ministers roles for individual portfolio areas.</p>\n\n<ul>\n  <li><a href=\"https://www.gov.uk/government/people/patrick-vallance\">Minister of State for Science, Research and Innovation</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/ian-murray\">Minister of State</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/kanishka-narayan\">Parliamentary Under Secretary of State</a></li>\n</ul>\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","