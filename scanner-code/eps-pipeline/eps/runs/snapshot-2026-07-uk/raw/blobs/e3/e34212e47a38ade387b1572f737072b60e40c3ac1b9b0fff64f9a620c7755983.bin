fice","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-the-home-department","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-the-home-department","base_path":"/government/ministers/secretary-of-state-for-the-home-department","content_id":"845e5d77-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Home Office business, including:</p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio</li>\n  <li>oversight of the ministerial team</li>\n  <li>Home Office business in Cabinet</li>\n  <li>membership of the National Security Council (NSC)</li>\n  <li>responsibility for public appointments relating to the work of the department</li>\n  <li>oversight of the Security Service</li>\n</ul>\n","role_payment_type":null,"seniority":10,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T11:48:27Z","schema_name":"role","title":"Secretary of State for the Home Department","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-the-home-department","withdrawn":false}],"taxons":[{"api_path":"/api/content/government/national-security","api_url":"https://www.gov.uk/api/content/government/national-security","base_path":"/government/national-security","content_id":"8a98b827-82ad-49b4-819e-82c208c551c4","details":{"internal_name":"National security [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/government/all","content_id":"e48ab80a-de80-4e83-bf59-26316856a5f9","description":"","details":{"internal_name":"Government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"