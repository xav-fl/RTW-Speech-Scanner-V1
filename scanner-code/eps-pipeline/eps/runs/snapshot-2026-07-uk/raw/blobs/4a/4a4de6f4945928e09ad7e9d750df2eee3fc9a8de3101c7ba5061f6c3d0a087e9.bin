-for-transport","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/654bbccfe2e16a000d42abe1/s960_dft-gmh-960.jpg","url":"https://assets.publishing.service.gov.uk/media/654bbccfe70413000dfc4a51/s300_dft-gmh-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Transport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/heidi-alexander","api_url":"https://www.gov.uk/api/content/government/people/heidi-alexander","base_path":"/government/people/heidi-alexander","content_id":"7ed59a39-adef-4a91-901b-6b7cb35d0864","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-07-08T17:52:42Z","schema_name":"person","title":"The Rt Hon Heidi Alexander MP","web_url":"https://www.gov.uk/government/people/heidi-alexander","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D9","api_path":"/api/content/government/organisations/department-for-transport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-transport","base_path":"/government/organisations/department-for-transport","content_id":"4c717efc-f47b-478e-a76d-ce1ae0af1946","details":{"acronym":"DfT","brand":"department-for-transport","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/654bbccfe2e16a000d42abe1/s960_dft-gmh-960.jpg","url":"https://assets.publishing.service.gov.uk/media/654bbccfe70413000dfc4a51/s300_dft-gmh-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Transport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-transport","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-transport","base_path":"/government/ministers/secretary-of-state-for-transport","content_id":"845e6453-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Department for Transport business, including: </p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio and oversight of the ministerial team </li>\n  <li>delivering the transport priorities of the government: making transport cheaper, greener, and more reliable </li>\n  <li>ensuring the transport network is safe and accessible </li>\n  <li>corporate functions such as oversight of departmental finance and public appointments</li>\n</ul>\n\n","role_payment_type":null,"seniority":19,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-11T12:46:45Z","schema_name":"role","title":"Secretary of State for Transport","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-transport","withdrawn":false}],"taxons":[{"api_path":"/api/content/transport/aviation-and-europe","api_url":"https://www.gov.uk/api/content/transport/aviation-and-europe","base_path":"/transport/aviation-and-europe","content_id":"8c9eb069-4c80-4200-a661-99fece37c52e","description":"Aviation operations and agreements with European countries.","details":{"internal_name":"Aviation and Europe","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/transport/aviation","api_url":"https://www.gov.uk/api/content/transport/aviation","base_path":"/transport/aviation","content_id":"51efa3dd-e9bc-42