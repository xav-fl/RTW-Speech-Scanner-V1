"/api/content/government/people/yvette-cooper","api_url":"https://www.gov.uk/api/content/government/people/yvette-cooper","base_path":"/government/people/yvette-cooper","content_id":"e3145327-542d-43d8-9c4e-f6908f265478","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T19:08:19Z","schema_name":"person","title":"The Rt Hon Yvette Cooper MP","web_url":"https://www.gov.uk/government/people/yvette-cooper","withdrawn":false},{"api_path":"/api/content/government/people/alex-davies-jones","api_url":"https://www.gov.uk/api/content/government/people/alex-davies-jones","base_path":"/government/people/alex-davies-jones","content_id":"2f7b87d3-f096-4cfe-9c56-b6038b048241","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-26T14:56:40Z","schema_name":"person","title":"Alex Davies-Jones MP","web_url":"https://www.gov.uk/government/people/alex-davies-jones","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-health-and-social-care","base_path":"/government/ministers/secretary-of-state-for-health-and-social-care","content_id":"25fa7393-375b-46ef-ab91-1b2bb9ef0e7f","details":{"body":"<p>The Secretary of State is responsible for the work of the Department of Health and Social Care, including:</p>\n\n<ul>\n  <li>overall financial control and oversight of NHS delivery and performance</li>\n  <li>oversight of social care policy</li>\n</ul>\n","role_payment_type":null,"seniority":12,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2018-01-23T10:09:56Z","schema_name":"role","title":"Secretary of State for Health and Social Care","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-health-and-social-care","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--320","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--320","base_path":"/government/ministers/parliamentary-under-secretary-of-state--320","content_id":"27eea154-8060-4e7b-8e02-c1423ad2f03e","details":{"body":"<ul>\n  <li>Violence Against Women and Girls (VAWG)</li>\n  <li>Criminal Law</li>\n  <li>Victims, Witnesses and Vulnerabilities</li>\n  <li>Criminal Injuries Compensation Authority</li>\n  <li>Rape and Serious Sexual Offences (RASSO)</li>\n  <li>Hillsborough Law</li>\n  <li>Death Management, Inquiries and Coroners</li>\n  <li>Probate (excluding fees)</li>\n  <li>Miscarriages of Justice</li>\n  <li>Criminal Cases Review Commission</li>\n  <li>International Justice (including Private International Law and Rule of Law)</li>\n  <li>Devolution and the Union</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-09-09T10:08:51Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Victims, Violence Against Women and Girls (VAWG) and International Justice)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--320","withdrawn":false}],"taxons":[{"api_path":"/api/content/health-and-social-care","api_url":"https://www.gov.uk/api/content/health-and-social-care","base_path":"/health-and-social-care","content_id":"8124ead8-8ebc-4faf-88ad-dd5cbcc92ba8","description":"","details":{"internal_name":"Health and social care","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:51Z","schema_name":"taxon","title":"Health and social care","web_url":"https://www.gov.uk/health-and-social-care","withdrawn":false},{"api_path":"/api/content/crime-justice-and-law/crime-prevention","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/crime-prevention","base_path":"/crime-justice-and-law/crime-prevention","content_id":"7f4eaf37-60f8-4d8c-a968-7829098e05ff","details":{"internal_name":"Crime prevention (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:51Z","schema_name":"taxon","title":"Crime prevention","web_url":"https://www.gov.uk/crime-justice-and-law/crime-prevention","withdrawn":false},{"api_path":"/api/content/life-circumstances/death","api_url":"https://www.gov.uk/api/content/life-circumstances/death","base_path":"/life-circumstances/death","content_id":"0fffa994-b76d-4539-8bf9-2a6c6751580d","details":{"internal_name":"Death and bereavement [M]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/life-circumstances","api_url":"https://www.gov.uk/api/content/life-circumstances","base_path":"/life-circumstances","content_id":"20086ead-41fc-49cf-8a62-d4e1126f41fc","description":"","details":{"internal_name":"Life circumstances","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:33:11Z","schema_name":"taxon","title":"Life circumstances","web_url":"https://www.gov.uk/life-circumstances","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T08:43:13Z","schema_name":"taxon","title":"Death and bereavement","web_url":"https://www.gov.uk/life-circumstances/death","withdrawn":false},{"api_path":"/api/content/business-and-industry/business-regulation","api_url":"https://www.gov.uk/api/content/business-and-industry/business-regulation","base_path":"/business-and-industry/business-regulation","content_id":"33bc0eed-62c7-4b0b-9a93-626c9e10c025","details":{"internal_name":"Business regulation [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Business and industry","web_url":"https://www.gov.uk/business-and-industry","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:03Z","schema_name":"taxon","title":"Business regulation","web_url":"https://www.gov.uk/business-and-industry/business-regulation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-31T14:39:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785769103.390-10.13.20.90-2649","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Government takes action to crack down on rogue funeral operators","updated_at":"2026-09-10T10:47:53+01:00","withdrawn_notice":{}}