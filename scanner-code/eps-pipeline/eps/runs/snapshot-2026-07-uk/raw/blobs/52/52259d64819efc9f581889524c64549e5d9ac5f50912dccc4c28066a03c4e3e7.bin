":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Business and industry","web_url":"https://www.gov.uk/business-and-industry","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Running a business","web_url":"https://www.gov.uk/business-and-industry/running-a-business","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-08T00:01:00+01:00","publishing_app":"whitehall","publishing_request_id":"22-1783500703.649-10.13.22.18-2650","publishing_scheduled_at":"2026-07-08T00:01:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":5,"schema_name":"news_article","title":"Research shows backing female-led businesses is good for growth","updated_at":"2026-09-22T11:14:51+01:00","withdrawn_notice":{}}