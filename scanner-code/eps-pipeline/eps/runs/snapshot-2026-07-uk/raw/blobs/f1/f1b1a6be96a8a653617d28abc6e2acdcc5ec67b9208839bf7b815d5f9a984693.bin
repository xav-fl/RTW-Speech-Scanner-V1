nment/government-spending","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-01T11:04:03+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782900243.394-10.13.21.164-2890","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Green Book changes to drive investment in all parts of UK","updated_at":"2026-09-10T10:47:57+01:00","withdrawn_notice":{}}