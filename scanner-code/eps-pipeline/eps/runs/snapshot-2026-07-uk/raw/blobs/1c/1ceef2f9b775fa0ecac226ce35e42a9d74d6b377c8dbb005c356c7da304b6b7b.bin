ps://www.gov.uk/government/ministers/minister-of-state--207","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/military-recruitment-training-operations","api_url":"https://www.gov.uk/api/content/defence/military-recruitment-training-operations","base_path":"/defence/military-recruitment-training-operations","content_id":"4b9f1f6f-0c16-4a99-94e5-e58a3fba461f","details":{"internal_name":"Military recruitment, training and operations [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"Military recruitment, training and operations","web_url":"https://www.gov.uk/defence/military-recruitment-training-operations","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-13T16:00:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783960661.492-10.13.22.75-2399","publishing_scheduled_at":"2026-07-13T16:00:00+01:0