Vienna, Austria. The UK Delegation is co-located in the British Embassy, Vienna.</p>\n","role_payment_type":null},"document_type":"ambassador_role","links":{},"locale":"en","public_updated_at":"2022-09-13T12:47:01Z","schema_name":"role","title":"Head of UK Delegation to the OSCE, Vienna","withdrawn":false}],"speaker":[{"api_path":"/api/content/government/people/neil-holland","api_url":"https://www.gov.uk/api/content/government/people/neil-holland","base_path":"/government/people/neil-holland","content_id":"85400a40-c0f1-11e4-8223-005056011aef","document_type":"person","links":{},"locale":"en","public_updated_at":"2023-06-06T08:47:33Z","schema_name":"person","title":"Neil Holland","web_url":"https://www.gov.uk/government/people/neil-holland","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba75a-42bd-4e1e-984c-2bddb6b41951","details":{"internal_name":"Foreign affairs [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8835-b3b51ae1c8b2","description":"","details":{"internal_name":"International","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.