ps://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false}],"speaker":[{"api_path":"/api/content/government/people/ed-miliband","api_url":"https://www.gov.uk/api/content/government/people/ed-miliband","base_path":"/government/people/ed-miliband","content_id":"0fdeeed1-bdca-46f9-b6f2-1aade6bf10e0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:56:00Z","schema_name":"person","title":"The Rt Hon Ed Miliband MP","web_url":"https://www.gov.uk/government/people/ed-miliband","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba