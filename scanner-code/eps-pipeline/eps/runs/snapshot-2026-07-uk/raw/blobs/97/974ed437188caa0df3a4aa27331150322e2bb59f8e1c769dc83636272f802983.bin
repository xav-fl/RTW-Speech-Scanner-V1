","withdrawn":false},{"api_path":"/api/content/government/speeches/statement-from-ed-miliband-on-his-appointment-as-foreign-secretary.ru","api_url":"https://www.gov.uk/api/content/government/speeches/statement-from-ed-miliband-on-his-appointment-as-foreign-secretary.ru","base_path":"/government/speeches/statement-from-ed-miliband-on-his-appointment-as-foreign-secretary.ru","content_id":"db2c6036-9242-43c5-a0e7-6bbb9b591f38","document_type":"speech","links":{},"locale":"ru","public_updated_at":"2026-07-21T16:34:00Z","schema_name":"speech","title":"Заявление Эда Милибэнда по случаю его назначения министром иностранных дел Великобритании","web_url":"https://www.gov.uk/government/speeches/statement-from-ed-miliband-on-his-appointment-as-foreign-secretary.ru","withdrawn":false}],"government":[{"api_path":"/api/content/government/2026-burnham-labour-government","api_url":"https://www.gov.uk/api/content/government/2026-burnham-labour-government","base_path":"/government/2026-burnham-labour-government","content_id":"1fb8162a-7f42-4a44-ae9b-42e8d8f36807","details":{"current":true,"ended_on":null,"started_on":"2026-07-20T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2026 Burnham Labour government","web_url":"https://www.gov.uk/government/2026-burnham-labour-government"}],"organisations":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s