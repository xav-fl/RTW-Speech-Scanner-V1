38dcea696db8","details":{"body":"<p>The Minister for Sport, Tourism, Civil Society and Youth is responsible for:</p>\n\n<ul>\n  <li>Sport</li>\n  <li>Tourism </li>\n  <li>Civil society</li>\n  <li>Youth</li>\n  <li>Loneliness and social connection</li>\n  <li>Impact Economy</li>\n  <li>Ceremonials</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-11T14:25:22Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Sport, Tourism, Civil Society and Youth)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state-minister-for-sport-tourism-civil-society-and-youth","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/young-people","api_url":"https://www.gov.uk/api/content/society-and-culture/young-people","base_path":"/society-and-culture/young-people","content_id":"ae747de8-96ad-4f66-9d6d-4d5c357e9956","description":"","details":{"internal_name":"Young people [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:31:27Z","schema_name":"taxon","title":"Society and culture","web_url":"https://www.gov.uk/society-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-20T13:33:00Z","schema_name":"taxon","title":"Young people","web_url":"https://www.gov.uk/society-and-culture/young-people","withdrawn":false}],"topical_events":[{"api_path":"/api/content/government/topical-events/youth-matters-national-youth-strategy","api_url":"https://www.gov.uk/api/content/government/topical-events/youth-matters-national-youth-strategy","base_path":"/government/topical-events/youth-matters-national-youth-strategy","content_id":"ff9ba344-64fd-486c-a03e-9720fef678ea","document_type":"topical_event","links":{},"locale":"en","public_updated_at":"2026-08-20T14:44:20Z","schema_name":"topical_event","title":"Youth Matters: National Youth Strategy","web_url":"https://www.gov.uk/government/topical-events/youth-matters-national-youth-strategy","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-22T17:02:49+01:00","publishing_app":"whitehall","publishing_request_id":"21-1787148216.549-10.13.20.197-630943","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Power of Youth Charter gives young people a voice in government","updated_at":"2026-09-17T13:29:48+01:00","withdrawn_notice":{}}