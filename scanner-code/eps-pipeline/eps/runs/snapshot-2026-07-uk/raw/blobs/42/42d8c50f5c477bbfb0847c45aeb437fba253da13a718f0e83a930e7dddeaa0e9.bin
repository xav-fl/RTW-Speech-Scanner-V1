rl":"https://www.gov.uk/government/organisations/department-for-business-and-trade","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state--2","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state--2","base_path":"/government/ministers/secretary-of-state--2","content_id":"5cb74a2c-7e9f-444a-8347-d944cc05b606","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Business and Trade. Responsibilities include:</p>\n\n<ul>\n  <li>overall responsibility for delivery and strategy</li>\n  <li>cross-government business engagement</li>\n  <li>public appointments</li>\n  <li>FTA negotiations, mandates, and decisions</li>\n  <li>WTO, G7, and G20 ministerial meetings</li>\n  <li>overseas network​</li>\n</ul>\n","role_payment_type":null,"seniority":19,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-06T11:08:19Z","schema_name":"role","title":"Secretary of State for Business and Trade","web_url":"https://www.gov.uk/government/ministers/secretary-of-state--2","withdrawn":false}],"taxons":[{"api_path":"/api/content/business-and-industry/trade-and-investment","api_url":"https://www.gov.uk/api/content/business-and-industry/trade-and-investment","base_path":"/business-and-industry/trade-and-investment","content_id":"ed2ca1f7-5463-4eda-9324-b597e269e242","details":{"internal_name":"Trade and investment","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/"