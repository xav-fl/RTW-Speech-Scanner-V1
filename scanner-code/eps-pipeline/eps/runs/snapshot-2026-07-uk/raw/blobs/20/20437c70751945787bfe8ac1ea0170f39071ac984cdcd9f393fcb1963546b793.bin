tus":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Wales Office","web_url":"https://www.gov.uk/government/organisations/wales-office","withdrawn":false},{"analytics_identifier":"D19","api_path":"/api/content/government/organisations/northern-ireland-office","api_url":"https://www.gov.uk/api/content/government/organisations/northern-ireland-office","base_path":"/government/organisations/northern-ireland-office","content_id":"234148b2-66d6-457c-9d06-2bf2b98533ca","details":{"acronym":"NIO","brand":"northern-ireland-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/6708fb1c366f494ab2e7b725/s960_NIO_Gov.uk_banner.png","url":"https://assets.publishing.service.gov.uk/media/6708fb1de84ae1fd8592f1ec/s300_NIO_Gov.uk_banner.png"},"logo":{"crest":"single-identity","formatted_title":"Northern<br/>Ireland<br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Northern Ireland Office","web_url":"https://www.gov.uk/government/organisations/northern-ireland-office","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false},{"analytics_identifier":"D1423","api_path":"/api/content/government/organisations/scotland-office","api_url":"https://www.gov.uk/api/content/government/organisations/scotland-office","base_path":"/government/organisations/scotland-office","content_id":"63953ed9-98ac-4d08-a1b9-8ea38dbd0832","details":{"acronym":"","brand":"scotland-office","default_news_image":null,"logo":{"crest":"so","formatted_title":"Scotland Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Scotland Office","web_url":"https://www.gov.uk/government/organisations/scotland-office","withdrawn":false},{"analytics_identifier":"OT1422","api_path":"/api/content/government/organisations/wales-office","api_url":"https://www.gov.uk/api/content/government/organisations/wales-office","base_path":"/government/organisations/wales-office","content_id":"99a5828c-79dd-4533-ab18-18069be289cf","details":{"acronym":"","brand":"wales-office","default_news_image":null,"logo":{"crest":"