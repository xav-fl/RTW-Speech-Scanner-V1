 emergencies</li>\n  <li>water</li>\n  <li>clean air and noise</li>\n  <li>environmental regulation (including chemicals, contaminated land and Registration, Evaluation and Authorisation of Chemicals (<abbr title=\"Registration, Evaluation and Authorisation of Chemicals\">REACH</abbr>))</li>\n  <li>pesticides</li>\n  <li>Net Zero, climate change and adaptation</li>\n  <li>domestic and international marine</li>\n  <li>lead for Environment Agency</li>\n  <li>lead for Consumer Council for Water</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-24T10:12:48Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Water and Flooding)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--270","withdrawn":false}],"taxons":[{"api_path":"/api/content/government/digital-accessibility","api_url":"https://www.gov.uk/api/content/government/digital-accessibility","base_path":"/government/digital-accessibility","content_id":"ab82cf21-da63-4d7c-8289-7b5506f6ea71","description":"","details":{"internal_name":"Digital accessibility (government technology and digital services)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/government-technology-and-digital-services","api_url":"https://www.gov.uk/api/content/government/government-technology-and-digital-services","base_path":"/government/government-technology-and-digital-services","content_id":"90c9b9f1-0a4f-4639-b1e9-2bfb23d611bd","details":{"internal_name":"Government technology and digital services","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/governme