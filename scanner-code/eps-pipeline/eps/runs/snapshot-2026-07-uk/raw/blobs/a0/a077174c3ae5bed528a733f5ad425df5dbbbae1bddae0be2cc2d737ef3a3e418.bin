13.20.220-2350","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK and EU strike Russian cyber networks with new sanctions","updated_at":"2026-09-15T08:49:53+01:00","withdrawn_notice":{}}