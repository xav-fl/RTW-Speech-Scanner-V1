{"analytics_identifier":null,"base_path":"/government/publications/dfe-update-15-july-2026","content_id":"2a72e572-7217-4d88-ae83-c126e35e2afa","description":"Latest information and actions from the Department for Education about funding, assurance and resource management, for academies, local authorities and further education providers.","details":{"attachments":[{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372730","isbn":"","title":"DfE Update further education: 15 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-15-july-2026/dfe-update-further-education-15-july-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372733","isbn":"","title":"DfE Update academies: 15 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-15-july-2026/dfe-update-academies-15-july-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9372734","isbn":"","title":"DfE Update local authorities: 15 July 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-15-july-2026/dfe-update-local-authorities-15-july-2026"}],"body":"<div class=\"govspeak\"><h2 id=\"latest-for-further-education\">Latest for further education</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Continue providing free school meals and free meals in further education where eligibility checks are outstanding</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Further Education Workforce Data Collection opens on Friday 31 July</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free courses for jobs engineering and manufacturing package</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Further education estate management standards publication</td>\n    </tr>\n    <tr>\n      <td>Reminder</td>\n      <td>Register now on the new Teachers’ Pensions Employer Portal</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of our funding service</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-academies\">Latest for academies</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Give your views through the early years funding consultation 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Give your views through the ‘Upfront funding for mainstream schools’ consultation</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Continue providing free school meals and free meals in further education where eligibility checks are outstanding</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Publication of the academy trust handbook 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Breakfast clubs grant 2026 to 2027 academic year</td>\n    </tr>\n    <tr>\n      <td>Reminder</td>\n      <td>Register now on the new Teachers’ Pensions Employer Portal</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of our funding service</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-local-authorities\">Latest for local authorities</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Give your views through the early years funding consultation 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Give your views through the ‘Upfront funding for mainstream schools’ consultation</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Continue providing free school meals and free meals in further education where eligibility checks are outstanding</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Early years teachers’ pay grant</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Further Education Workforce Data Collection opens on Friday 31 July</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free courses for jobs engineering and manufacturing package</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Breakfast clubs grant 2026 to 2027 academic year</td>\n    </tr>\n    <tr>\n      <td>Reminder</td>\n      <td>Register now on the new Teachers’ Pensions Employer Portal</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of our funding service</td>\n    </tr>\n  </tbody>\n</table>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-07-15T13:27:01Z"}],"document_type_label":"Correspondence","emphasised_organisations":["ebd15ade-73b2-4eaf-b1c3-43034a42eb37"],"featured_attachments":["9372730","9372733","9372734"],"first_public_at":"2026-07-15T14:27:01.000+01:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotland"},"wales":{"alternative_url":"","applicable":false,"label":"Wales"}},"political":false,"tags":{"browse_pages":[]}},"document_type":"correspondence","first_published_at":"2026-07-15T14:27:01+01:00","links":{"available_translations":[{"api_path":"/api/content/government/publications/dfe-update-15-july-2026","api_url":"https://www.gov.uk/api/content/government/publications/dfe-update-15-july-2026","base_path":"/government/publications/dfe-update-15-july-2026","content_id":"2a72e572-7217-4d88-ae83-c126e35e2afa","document_typ