fault_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--188","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--188","base_path":"/government/ministers/minister-of-state--188","content_id":"82762ea4-bd8c-427b-8c36-28160e5ef1a8","details":{"body":"<p>The Minister of State for Health (Secondary Care) is responsible for:</p>\n\n<ul>\n  <li>NHS secondary care</li>\n  <li>NHS workforce</li>\n  <li>NHS capital, land and estates</li>\n  <li>NHS finance</li>\n  <li>urgent and emergency care</li>\n  <li>health and social care integration</li>\n  <li>hospital discharge</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-06-05T10:54:33Z","schema_name":"role","title":"Minister of State for Health (Secondary Care)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--188","withdrawn":false}],"taxons":[{"api_path":"/api/content/health-and-social-care/health-workforce","api_url":"https://www.gov.uk/api/content/health-and-social-care/health-workforce","base_path":"/health-and-social-care/health-workforce","content_id":"1309a4b3-17b5-40ec-9747-16cd2ef65dc6","description":"","details":{"internal_name":"Health workforce","notes_for_editors":"","visible_to_dep