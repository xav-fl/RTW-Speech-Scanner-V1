-for-environment-food-rural-affairs","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D7","api_path":"/api/content/government/organisations/department-for-environment-food-rural-affairs","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-environment-food-rural-affairs","base_path":"/government/organisations/department-for-environment-food-rural-affairs","content_id":"de4e9dc6-cca4-43af-a594-682023b84d6c","details":{"acronym":"Defra","brand":"department-for-environment-food-rural-affairs","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dad140f0b649cceb1813/s960_defra-sign-grey.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dad1ed915d5a62fdc6d6/s300_defra-sign-grey.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Environment,<br/>Food &amp; Rural Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Environment, Food & Rural Affairs","web_url":"https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/emma-reynolds--2","api_url":"https://www.gov.uk/api/content/government/people/emma-reynolds--2","base_path":"/government/people/emma-reynolds--2","content_id":"b2e4f332-b4f0-4ef2-9ebe-09ee356a1752","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:40:29Z","schema_name":"person","title":"The Rt Hon Emma Reynolds MP","web_url":"https://www.gov.uk/government/people/emma-reynolds--2","withdrawn":false},{"api_path":"/api/content/government/people/ed-miliband","api_url":"https://www.gov.uk/api/content/government/people/ed-miliband","base_path":"/government/people/ed-miliband","content_id":"0fdeeed1-bdca-46f9-b6f2-1aade6bf10e0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:56:00Z","schema_name":"person","title":"The Rt Hon Ed Miliband MP","web_url":"https://www.gov.uk/government/people/ed-miliband","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D7","api_path":"/api/content/government/organisations/department-for-environment-food-rural-affairs","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-environment-food-rural-affairs","base_path":"/government/organisations/department-for-environment-food-rural-affairs","content_id":"de4e9dc6-cca4-43af-a594-682023b84d6c","details":{"acronym":"Defra","brand":"department-for-environment-food-rural-affairs","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dad140f0b649cceb1813/s960_defra-sign-grey.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dad1ed915d5a62fdc6d6/s300_defra-sign-grey.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Environment,<br/>Food &amp; Rural Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Environment, Food & Rural Affairs","web_url":"https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","base_path":"/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","content_id":"845e649f-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for the Environment, Food and Rural Affairs.</p>\n\n<p>She has specific responsibilities for:</p>\n\n<ul>\n  <li>budget, including Official Development Assistance (<abbr title=\"Official Development Assistance\">ODA</abbr>)</li>\n  <li>international relations</li>\n  <li>senior appointments</li>\n  <li>economic growth</li>\n</ul>\n\n","role_payment_type":null,"seniority":22,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-20T12:24:30Z","schema_name":"role","title":"Secretary of State for Environment, Food and Rural Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state","base_path":"/government/ministers/secretary-of-state","content_id":"acde07a8-5971-4b2c-a34c-5ad9eed5ef9d","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Energy Security and Net Zero.</p>\n","role_payment_type":null,"seniority":20,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2023-02-28T11:43:03Z","schema_name":"role","title":"Secretary of State for Energy Security and Net Zero","web_url":"https://www.gov.uk/government/ministers/secretary-of-state","withdrawn":false}],"taxons":[{"api_path":"/api/content/environment/wildlife-animals-biodiversity-and-ecosystems","api_url":"https