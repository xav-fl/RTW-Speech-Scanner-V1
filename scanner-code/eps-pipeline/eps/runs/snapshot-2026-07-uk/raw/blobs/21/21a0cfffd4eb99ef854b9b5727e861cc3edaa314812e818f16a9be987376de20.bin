a1752","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:40:29Z","schema_name":"person","title":"The Rt Hon Emma Reynolds MP","web_url":"https://www.gov.uk/government/people/emma-reynolds--2","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D7","api_path":"/api/content/government/organisations/department-for-environment-food-rural-affairs","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-environment-food-rural-affairs","base_path":"/government/organisations/department-for-environment-food-rural-affairs","content_id":"de4e9dc6-cca4-43af-a594-682023b84d6c","details":{"acronym":"Defra","brand":"department-for-environment-food-rural-affairs","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dad140f0b649cceb1813/s960_defra-sign-grey.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dad1ed915d5a62fdc6d6/s300_defra-sign-grey.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Environment,<br/>Food &amp; Rural Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Environment, Food & Rural Affairs","web_url":"https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","base_path":"/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","content_id":"845e649f-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for the Environment, Food and Rural Affairs.</p>\n\n<p>She has specific responsibilities for:</p>\n\n<ul>\n  <li>budget, including Official Development Assistance (<abbr title=\"Official Development Assistance\">ODA</abbr>)</li>\n  <li>international relations</li>\n  <li>senior appointments</li>\n  <li>economic growth</li>\n</ul>\n\n","role_payment_type":null,"seniority":22,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-20T12:24:30Z","schema_name":"role","title":"Secretary of State for Environment, Food and Rural Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","withdrawn":false}],"taxons":[{"api_path":"/api/content/environment/pets","api_url":"https://www.gov.uk/api/content/environment/pets","base_path":"/environment/pets","content_id":"0990f0d5-b8d9-431b-b252-66ab664acf1b","description":"","details":{"internal_name":"Pets [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment/wildlife-animals-biodiversity-and-ecosystems","api_url":"https://www.gov.uk/api/content/environment/wildlife-animals-biodiversity-and-ecosystems","base_path":"/environment/wildlife-animals-biodiversity-and-ecosystems","content_id":"695dc6f2-27cc-4d8b-adc4-8d07c2bff748","description":"","details":{"internal_name":"Wildlife, animals, biodiversity and ecosystems","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment","api_url":"https://www.gov.uk/api/content/environment","base_path":"/environment","content_id":"3cf97f69-84de-41ae-bc7b-7e2cc238fa58","description":"","details":{"internal_name":"Environment","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T13:39:00Z","schema_name":"taxon","title":"Environment","web_url":"https://www.gov.uk/environment","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T10:53:02Z","schema_name":"taxon","title":"Wildlife, animals, biodiversity and ecosystems","web_url":"https://www.gov.uk/environment/wildlife-animals-biodiversity-and-ecosystems","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-20T13:50:24Z","schema_name":"taxon","title":"Pets","web_url":"https://www.gov.uk/environment/pets","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-09T00:01:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783589509.671-10.13.20.31-2378","publishing_scheduled_at":"2026-07-09T00:01:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":5,"schema_name":"news_article","title":"Cheaper vet fees and new ombudsman in biggest reforms to vet sector in half a century","updated_at":"2026-09-10T10:49:36+01:00","withdrawn_notice":{}}