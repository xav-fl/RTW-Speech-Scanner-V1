Transport","web_url":"https://www.gov.uk/transport","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-14T09:27:18Z","schema_name":"taxon","title":"Maritime and shipping","web_url":"https://www.gov.uk/transport/maritime-and-shipping","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-14T09:27:18Z","schema_name":"taxon","title":"Wrecks","web_url":"https://www.gov.uk/transport/wrecks","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-14T11:24:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784026171.287-10.13.20.148-2619","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Safe removal of masts from historic WWII shipwreck carrying wartime explosives begins","updated_at":"2026-09-17T12:30:12+01:00","withdrawn_notice":{}}