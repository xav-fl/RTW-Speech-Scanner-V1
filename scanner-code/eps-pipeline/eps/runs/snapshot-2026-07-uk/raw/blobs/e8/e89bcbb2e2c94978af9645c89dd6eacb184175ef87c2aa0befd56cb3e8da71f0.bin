me-and-coastguard-agency","content_id":"23a24aa8-1711-42b6-bf6b-47af0f230295","details":{"acronym":"MCA","brand":"department-for-transport","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/62e3849dd3bf7f75b10cf8bd/s960_coastguard-coordination-centre.jpg","url":"https://assets.publishing.service.gov.uk/media/62e3849ed3bf7f75bb0e4449/s300_coastguard-coordination-centre.jpg"},"logo":{"crest":"single-identity","formatted_title":"Maritime &amp;<br/>Coastguard <br/>Agency"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Maritime and Coastguard Agency","web_url":"https://www.gov.uk/government/organisations/maritime-and-coastguard-agency","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/keir-mather","api_url":"https://www.gov.uk/api/content/government/people/keir-mather","base_path":"/government/people/keir-mather","content_id":"6cfb87fe-5a4c-46e1-acf7-7a57e17a1adf","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-09-08T07:07:02Z","schema_name":"person","title":"Keir Mather MP","web_url":"https://www.gov.uk/government/people/keir-mather","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D9","api_path":"/api/content/government/organisations/department-for-transport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-transport","base_path":"/government/organisations/department-for-transport","content_id":"4c717efc-f47b-478e-a76d-ce1ae0af1946","details":{"acronym":"DfT","brand":"department-for-transport","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/654bbccfe2e16a000d42abe1/s960_dft-gmh-960.jpg","url":"https://assets.publishing.service.gov.uk/media/654bbccfe70413000dfc4a51/s300_dft-gmh-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Transport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--300","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--300","base_path":"/government/ministers/parliamentary-under-secretary-of-state--300","content_id":"f24f02f6-57a8-41f5-bf40-584fb798cad1","details":{"body":"<p>The Minister for Aviation, Maritime and Decarbonisation is responsible for:   </p>\n\n<ul>\n  <li>aviation and airport expansion </li>\n  <li>maritime </li>\n  <li>decarbonisation and electric vehicles (<abbr title=\"electric vehicles\">EVs</abbr>) </li>\n  <li>freight and borders </li>\n  <li>international</li>\n  <li>security</li>\n</ul>\n\n<p>The <a href=\"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--343\">Minister for Aviation, Maritime and Logistics</a> replaced this role on 22 July 2026.</p>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-19T13:42:09Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Aviation, Maritime and Decarbonisation) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--300","withdrawn":false}],"taxons":[{"api_path":"/api/content/transport/maritime-safety","api_url":"https://www.gov.uk/api/content/transport/maritime-safety","base_path":"/transport/maritime-safety","content_id":"f7071a5c-d6dc-4f2e-b83d-83414ae15536","description":"Safe operation of vessels and ports, safety standards, life saving appliances, insurance, codes of practice and how to ship dangerous goods.","details":{"internal_name":"Maritime safety ","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/transport/maritime-and-shipping","api_url":"https://www.gov.uk/api/content/transport/maritime-and-shipping","base_path":"/transport/maritime-and-shipping","content_id":"4a9ab4d7-0d03-4c61-9e16-47787cbf53cd","description":"Shipping, ports and harbours, security, safety at sea, crew training and certifications, sea passengers and vessel registration.","details":{"internal_name":"Maritime and shipping","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/transport","api_url":"https://www.gov.uk/api/content/transport","base_path":"/transport","content_id":"a4038b29-b332-4f13-98b1-1c9709e216bc","description":"Aviation, roads, rail, maritime, driving, freight, public transport, safety, environment and transport accessibility.","details":{"internal_name":"Transport","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-15T14:31:46Z","schema_name":"taxon","title":"Transport","web_url":"https://www.gov.uk/transport","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-14T09:27:18Z","schema_name":"taxon","title":"Maritime and shipping","web_url":"https://www.gov.uk/transport/maritime-and-shipping","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-14T09:27:18Z","schema_name":"taxon","title":"Mari