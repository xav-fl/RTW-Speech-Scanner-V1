entity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false},{"analytics_identifier":"PB481","api_path":"/api/content/government/organisations/nhs-england","api_url":"https://www.gov.uk/api/content/government/organisations/nhs-england","base_path":"/government/organisations/nhs-england","content_id":"f07b4bb8-8af6-42da-a161-3d90027e980c","details":{"acronym":"","brand":"department-of-health-social-care","default_news_image":null,"logo":{"crest":"no-identity","formatted_title":"NHS England"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"http://www.england.nhs.uk/"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"NHS England","web_url":"https://www.gov.uk/government/organisations/nhs-england","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/james-murray","api_url":"https://www.gov.uk/api/content/government/people/james-murray","base_path":"/government/people/james-murray","content_id":"ac0e5e69-9c5d-4b52-8ef5-5f6dec83d8df","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T08:29:43Z","schema_name":"person","title":"The Rt Hon James Murray MP","web_url":"https://www.gov.uk/government/people/james-murray","withdrawn":false},{"api_path":"/api/content/government/people/sharon-hodgson","api_url":"https://www.gov.uk/api/content/government/people/sharon-hodgson","base_path":"/government/people/sharon-hodgson","content_id":"65b1563b-13dd-4916-b4a7-6f78b5f90812","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:12:43Z","schema_name":"person","title":"Sharon Hodgson MP","web_url":"https://www.gov.uk/government/people/sharon-hodgson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-health-and-social-care","base_path":"/government/ministers/secretary-of-state-for-health-and-social-care","content_id":"25fa7393-375b-46ef-ab91-1b2bb9ef0e7f","details":{"body":"<p>The Secretary of State is responsible for the work of the Department of Health and Social Care, including:</p>\n\n<ul>\n  <li>overall financial control and oversight of NHS delivery and performance</li>\n  <li>oversight of social care policy</li>\n</ul>\n","role_payment_type":null,"seniority":12,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2018-01-23T10:09:56Z","schema_name":"role","title":"Secretary of State for Health and Social Care","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-health-and-social-care","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--306","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--306","base_path":"/government/ministers/parliamentary-under-secretary-of-state--306","content_id":"cffc1bca-624e-42f0-80e5-e6edce2d8313","details":{"body":"<p>The Parliamentary Under-Secretary of State for Public Health and Prevention is responsible for:</p>\n\n<ul>\n  <li>health protection</li>\n  <li>sexual health and HIV</li>\n  <li>health improvement</li>\n  <li>children’s health</li>\n  <li>major and long-term conditions</li>\n  <li>secondary prevention</li>\n  <li>screening</li>\n  <li>health inequalities</li>\n  <li>work and health</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-06-05T10:08:37Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Public Health and Prevention ​","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--306","withdrawn":false}],"taxons":[{"api_path":"/api/content/health-and-social-care/national-health-service","api_url":"https://www.gov.uk/api/content/health-and-social-care/national-health-service","base_path":"/health-and-social-care/national-health-service","content_id":"f3dcc290-752f-4bbe-b379-9155d919a58d","details":{"internal_name":"National Health Service (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/health-and-social-care","api_url":"https://www.gov.uk/api/content/health-and-social-care","base_path":"/health-and-social-care","content_id":"8124ead8-8ebc-4faf-88ad-dd5cbcc92ba8","descripti