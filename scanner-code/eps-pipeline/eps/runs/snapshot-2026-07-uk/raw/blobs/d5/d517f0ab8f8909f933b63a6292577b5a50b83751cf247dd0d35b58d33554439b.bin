Social Council, and working on issues such as security and conflict, human rights, sustainable development and climate change.  The DPR is also responsible for the daily management of the Mission.</p>\n","role_payment_type":null},"document_type":"ambassador_role","links":{},"locale":"en","public_updated_at":"2026-07-29T16:11:29Z","schema_name":"role","title":"Deputy Permanent Representative, UK Mission to the UN, New York","withdrawn":false}],"speaker":[{"api_path":"/api/content/government/people/kate-foster","api_url":"https://www.gov.uk/api/content/government/people/kate-foster","base_path":"/government/people/kate-foster","content_id":"a39a20f9-f8ee-4662-84b9-39cd76aaed63","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-01T14:35:38Z","schema_name":"person","title":"Kate Foster OBE","web_url":"https://www.gov.uk/government/people/kate-foster","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba75a-42bd-4e1e-984c-2bddb6b41951","details":{"internal_name":"Foreign affairs [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8835-b3b51ae1c8b2","description":"","details":{"internal_name":"International","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"loc