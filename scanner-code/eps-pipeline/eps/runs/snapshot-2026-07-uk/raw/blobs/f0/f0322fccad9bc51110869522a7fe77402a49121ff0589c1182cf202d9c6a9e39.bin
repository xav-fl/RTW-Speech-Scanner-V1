{"analytics_identifier":null,"base_path":"/government/news/fcdo-statement-on-democratic-governance-civic-space-and-human-rights-in-nicaragua","content_id":"004d340e-35df-47c5-8142-5ae43d824ea5","description":"An FCDO statement on recent declarations by the Nicaraguan authorities about elections.","details":{"attachments":[],"body":"<div class=\"govspeak\"><h4 id=\"an-fcdo-spokesperson-said\">An FCDO spokesperson said:</h4>\n\n<blockquote>\n  <p class=\"last-child\">The UK Government remains deeply concerned by the continued deterioration of democratic governance, civic space and human rights in Nicaragua. </p>\n</blockquote>\n\n<blockquote>\n  <p class=\"last-child\">Recent declarations by the Nicaraguan authorities about elections represent a further assault on democratic principles and the Nicaraguan people’s right to choose their leaders freely and fairly </p>\n</blockquote>\n\n<blockquote>\n  <p class=\"last-child\">We urge the Nicaraguan authorities to uphold their international human rights commitments, restore democratic guarantees, and create the conditions for meaningful political participation, peaceful dissent and respect for fundamental freedoms.</p>\n</blockquote>\n\n<div class=\"address\"><div class=\"adr org fn\"><p>\nMedia enquiries<br>Email <a href=\"mailto:newsdesk@fcdo.gov.uk\">newsdesk@fcdo.gov.uk</a><br>Telephone 020 7008 3100<br>Email the FCDO Newsdesk (monitored 24 hours a day) in the first instance, and we will respond as soon as possible.\n</p></div></div>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-07-28T21:11:17Z"}],"emphasised_organisations":["f9fcf3fe-2751-4dca-97ca-becaeceb4b26"],"images":[{"caption":null,"content_type":"image/jpeg","sources":{"s216":"https://assets.publishing.service.gov.uk/media/621e4de5d3bf7f4f0b29b67c/s216_fcdo-main-building.jpg","s300":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg","s465":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f549069a6616/s465_fcdo-main-building.jpg","s630":"https://assets.publishing.service.gov.uk/media/621e4de4d3bf7f4f0743dc7c/s630_fcdo-main-building.jpg","s712":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710acb2557a/s712_fcdo-main-building.jpg","s960":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg"},"type":"lead"}],"political":true},"document_type":"press_release","first_published_at":"2026-07-28T22:11:17+01:00","links":{"available_translations":[{"api_path":"/api/content/government/news/fcdo-statement-on-democratic-governance-civic-space-and-human-rights-in-nicaragua","api_url":"https://www.gov.uk/api/content/government/news/fcdo-statement-on-democratic-governance-civic-space-and-human-rights-in-nicaragua","base_path":"/government/news/fcdo-statement-on-democratic-governance-civic-space-and-human-rights-in-nicaragua","content_id":"004d340e-35df-47c5-8142-5ae43d824ea5","document_type":"press_release","links":{},"locale":"en","public_updated_at":"2026-07-28T21:11:17Z","schema_name":"news_article","title":"FCDO statement on democratic governance, civic space and human rights in Nicaragua","web_url":"https://www.gov.uk/government/news/fcdo-statement-on-democratic-governance-civic-space-and-human-rights-in-nicaragua","withdrawn":false}],"emphasised_organisations":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.