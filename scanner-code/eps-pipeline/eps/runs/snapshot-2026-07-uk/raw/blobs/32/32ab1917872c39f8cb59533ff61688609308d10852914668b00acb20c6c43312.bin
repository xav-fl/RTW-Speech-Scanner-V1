":false}],"world_locations":[{"analytics_identifier":"WL43","content_id":"5e9efc06-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{"world_location_news":[{"analytics_identifier":"WL43","api_path":"/api/content/world/eritrea/news","api_url":"https://www.gov.uk/api/content/world/eritrea/news","base_path":"/world/eritrea/news","content_id":"b3a97ad4-9254-4548-b15d-4f4cba899d0a","description":"Updates, news and events from the UK government in Eritrea","document_type":"world_location_news","links":{},"locale":"en","public_updated_at":"2017-08-15T14:41:32Z","schema_name":"world_location_news","title":"Eritrea and the UK","web_url":"https://www.gov.uk/world/eritrea/news","withdrawn":false}]},"locale":"en","public_updated_at":"2017-08-15T14:41:32Z","schema_name":"world_location","title":"Eritrea","withdrawn":false},{"analytics_identifier":"WL150","api_path":"/api/content/world/uk-mission-to-the-wto-un-and-other-international-organisations-geneva","api_url":"https://www.gov.uk/api/content/world/uk-mission-to-the-wto-un-and-other-international-organisations-geneva","base_path":"/world/uk-mission-to-the-wto-un-and-other-international-organisations-geneva","content_id":"5e9f266d-7706-11e4-a3cb-005056011aef","description":"Updates, news and events from the UK government in UK Mission to the WTO, UN and Other International Organisations (Geneva)","document_type":"world_location_news","links":{},"locale":"en","public_updated_at":"2025-07-03T14:03:34Z","schema_name":"world_location_news","title":"UK Mission to the WTO, UN and other international organisations (Geneva)","web_url":"https://www.gov.uk/world/uk-mission-to-the-wto-un-and-other-international-organisations-geneva","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-07T09:51:04+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783425372.098-10.13.21.194-9539","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,