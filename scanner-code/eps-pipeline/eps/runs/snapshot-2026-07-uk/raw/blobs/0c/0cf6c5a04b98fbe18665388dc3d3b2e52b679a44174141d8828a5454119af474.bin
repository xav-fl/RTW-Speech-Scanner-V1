:"person","title":"The Rt Hon Shabana Mahmood MP","web_url":"https://www.gov.uk/government/people/shabana-mahmood","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D16","api_path":"/api/content/government/organisations/home-office","api_url":"https://www.gov.uk/api/content/government/organisations/home-office","base_path":"/government/organisations/home-office","content_id":"06056197-bc69-4147-aa28-070bca132178","details":{"acronym":"Home Office","brand":"home-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/669fa7f5ce1fd0da7b592afc/s960_2MS_Home_Office_sign_-_landscape.jpg","url":"https://assets.publishing.service.gov.uk/media/669fa7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-the-home-department","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-the-home-department","base_path":"/government/ministers/secretary-of-state-for-the-home-department","content_id":"845e5d77-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Home Office business, including:</p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio</li>\n  <li>oversight of the ministerial team</li>\n  <li>Home Office business in Cabinet</li>\n  <li>membership of the National Security Council (NSC)</li>\n  <li>responsibility for public appointments relating to the work of the department</li>\n  <li>oversight of the Security Service</li>\n</ul>\n","role_payment_type":null,"seniority":10,"whip_organisatio