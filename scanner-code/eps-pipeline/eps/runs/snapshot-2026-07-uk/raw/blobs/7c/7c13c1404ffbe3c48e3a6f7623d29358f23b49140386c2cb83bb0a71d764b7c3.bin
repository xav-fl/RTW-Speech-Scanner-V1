dy","api_url":"https://www.gov.uk/api/content/government/people/emma-hardy","base_path":"/government/people/emma-hardy","content_id":"d0d49672-5b29-4b82-9e2e-2b50ecd3d232","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T10:04:15Z","schema_name":"person","title":"Emma Hardy MP","web_url":"https://www.gov.uk/government/people/emma-hardy","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--283","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--283","base_path":"/government/ministers/parliamentary-under-secretary-of-state--283","content_id":"4b727a0e-2461-438c-af4b-841397d6b8d3","details":{"body":"<ul>\n  <li>Indo-Pacific</li>\n  <li>growth</li>\n  <li>global tech and artificial intelligence</li>\n  <li>departmental operations (including Legal)</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-30T11:32:28Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Indo-Pacific)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--283","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--270","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--270","base_path":"/government/ministers/parliamentary-under-secretary-of-state--270","content_id":"7353409d-327c-402c-8851-7e833e72f114","details":{"body":"<p>Emma is responsible for:</p>\n\n<ul>\n  <li>floods and emergencies</li>\n  <li>water</li>\n  <li>clean air and noise</li>\n  <li>environmental regulation (including chemicals, contaminated land and Registration, Evaluation and Authorisation of Chemicals (<abbr title=\"Registration, Evaluation and Authorisation of Chemicals\">REACH</abbr>))</li>\n  <li>pesticides</li>\n  <li>Net Zero, climate change and adaptation</li>\n  <li>domestic and international marine</li>\n  <li>lead for Environment Agency</li>\n  <li>lead for Consumer Council for Water</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-24T10:12:48Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Water and Flooding)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--270","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba75a-42bd-4e1e-984c-2bddb6b41951","