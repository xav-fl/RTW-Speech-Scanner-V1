shing_request_id":"21-1784215895.594-10.13.21.168-241288","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Government secures the future of Dartmoor’s iconic ponies","updated_at":"2026-09-10T10:49:35+01:00","withdrawn_notice":{}}