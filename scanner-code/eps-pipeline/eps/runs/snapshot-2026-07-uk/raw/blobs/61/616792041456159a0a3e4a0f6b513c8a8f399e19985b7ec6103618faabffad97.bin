,"withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:05Z","schema_name":"taxon","title":"Trade and investment","web_url":"https://www.gov.uk/business-and-industry/trade-and-investment","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-23T13:42:25+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784890922.367-10.13.22.211-93116","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Ties strengthened as Secretary of State meets Governor DeSantis","updated_at":"2026-09-10T10:48:59+01:00","withdrawn_notice":{}}