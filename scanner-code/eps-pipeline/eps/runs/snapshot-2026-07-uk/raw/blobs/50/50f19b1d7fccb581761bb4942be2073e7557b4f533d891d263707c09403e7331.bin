d":"701ce38d-c098-4090-bcef-23fe4000bdaf","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T13:15:53Z","schema_name":"person","title":"The Rt Hon Sir Chris Bryant MP","web_url":"https://www.gov.uk/government/people/chris-bryant","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D19","api_path":"/api/content/government/organisations/northern-ireland-office","api_url":"https://www.gov.uk/api/content/government/organisations/northern-ireland-office","base_path":"/government/organisations/northern-ireland-office","content_id":"234148b2-66d6-457c-9d06-2bf2b98533ca","details":{"acronym":"NIO","brand":"northern-ireland-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/6708fb1c366f494ab2e7b725/s960_NIO_Gov.uk_banner.png","url":"https://assets.publishing.service.gov.uk/media/6708fb1de84ae1fd8592f1ec/s300_NIO_Gov.uk_banner.png"},"logo":{"crest":"single-identity","formatted_title":"Northern<br/>Ireland<br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Northern Ireland Office","web_url":"https://www.gov.uk/government/organisations/northern-ireland-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-northern-ireland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-northern-ireland","base_path":"/government/ministers/secretary-of-state-for-northern-ireland","content_id":"845e6581-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the overall work of the Department, including on:</p>\n\n<ul>\n  <li>Engagement with the NI Executive and NI political parties;</li>\n  <li>Supporting the political stability and fiscal sustainability of the NI Executive;</li>\n  <li>NI trade and economic growth;</li>\n  <li>Addressing the legacy of the Troubles; </li>\n  <li>Implementation of the Windsor Framework, working jointly with Cabinet Office; and </li>\n  <li>National security.</li>\n</ul>\n\n<p>He also has overall responsibility for the NIO’s parliamentary activity in the House of Commons.</p>\n","role_payment_type":null,"seniority":23,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-09-16T08:41:14Z","schema_name":"role","title":"Secretary of State for Northern Ireland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-northern-ireland","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/northern-ireland","api_url":"https://www.gov.uk/api/content/regional-and-local-government/northern-ireland","base_path":"/regional-and-local-government/northern-ireland","content_id":"a1e624ed-e268-44ab-ac3f-4d3cb2bb8cb5","details":{"internal_name":"Northern Ireland [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:40Z","schema_name":"taxon","title":"Northern Ireland","web_url":"https://www.gov.uk/regional-and-local-government/northern-ireland","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-21T17:41:08+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784652155.966-10.13.21.131-81930","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Secretary of State for Northern Ireland appointment: Sir Chris Bryant statement","updated_at":"2026-09-16T09:41:48+01:00","withdrawn_notice":{}}