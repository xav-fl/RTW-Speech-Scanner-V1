laque-2.jpg","url":"https://assets.publishing.service.gov.uk/media/64539946c33b46000cf5e655/s300_DBT_Plaque-2.jpg"},"logo":{"crest":"dbt","formatted_title":"Department for<br/>Business &amp; Trade"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Business and Trade","web_url":"https://www.gov.uk/government/organisations/department-for-business-and-trade","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/peter-kyle","api_url":"https://www.gov.uk/api/content/government/people/peter-kyle","base_path":"/government/people/peter-kyle","content_id":"97ce3a97-57b6-4421-9ab6-e2eced6601cf","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:11:36Z","schema_name":"person","title":"The Rt Hon Peter Kyle MP","web_url":"https://www.gov.uk/government/people/peter-kyle","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1382","api_path":"/api/content/government/organisations/department-for-business-and-trade","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-business-and-trade","base_path":"/government/organisations/department-for-business-and-trade","content_id":"aa750cdf-7925-429d-a2b3-0d9fa47d2c48","details":{"acronym":"DBT","brand":"department-for-business-trade","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/64539946faf4aa0012e132d1/s960_DBT_Plaque-2.jpg","url":"https://assets.publishing.service.gov.uk/media/64539946c33b46000cf5e655/s300_DBT_Plaque-2.jpg"},"logo":{"crest":"dbt","formatted_title":"Department for<br/>Business &amp; Trade"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Business and Trade","web_url":"https://www.gov.uk/government/organisations/department-for-business-and-trade","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state--2","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state--2","base_path":"/government/ministers/secretary-of-state--2","content_id":"5cb74a2c-7e9f-444a-8347-d944cc05b606","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Business and Trade. Responsibilities include:</p>\n\n<ul>\n  <li>overall responsibility for delivery and strategy</li>\n  <li>cross-government business engagement</li>\n  <li>public appointments</li>\n  <li>FTA negotiations, mandates, and decisions</li>\n  <li>WTO, G7, and G20 ministerial meetings</li>\n  <li>overseas network​</li>\n</ul>\n","role_payment_type":null,"seniority":19,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-06T11:08:19Z","schema_name":"role","title":"Secretary of State for Business and Trade","web_url":"https://www.gov.uk/government/ministers/secretary-of-state--2","withdrawn":false}],"taxons":[{"api_path":"/api/content/business-and-industry/business-regulation","api_url":"https://www.gov.uk/api/content/business-and-industry/business-regulation","base_path":"/business-and-industry/business-regulation","content_id":"33bc0eed-62c7-4b0b-9a93-626c9e10c025","details":{"internal_name":"Business regulation [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/co