_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D1","api_path":"/api/content/government/organisations/attorney-generals-office","api_url":"https://www.gov.uk/api/content/government/organisations/attorney-generals-office","base_path":"/government/organisations/attorney-generals-office","content_id":"25aacd68-dc0c-4041-9c3a-df59a5357c23","details":{"acronym":"AGO","brand":"attorney-generals-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5cd1619de5274a34eb6b9945/s960_Courts_of_Justice_new.jpg","url":"https://assets.publishing.service.gov.uk/media/5cd1619d40f0b6332070f272/s300_Courts_of_Justice_new.jpg"},"logo":{"crest":"single-identity","formatted_title":"Attorney <br/>General&#39;s <br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Attorney General's Office","web_url":"https://www.gov.uk/government/organisations/attorney-generals-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/ellie-reeves","api_url":"https://www.gov.uk/api/content/government/people/ellie-reeves","base_path":"/government/people/ellie-reeves","content_id":"8a5e71e0-9918-471a-af46-bf024ef1231c","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T07:51:52Z","schema_name":"person","title":"The Rt Hon Ellie Reeves KC MP","web_url":"https://www.gov.uk/government/people/ellie-reeves","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1","api_path":"/api/content/government/organisations/attorney-generals-office","api_url":"https://www.gov.uk/api/content/government/organisations/attorney-generals-office","base_path":"/government/organisations/attorney-generals-office","content_id":"25aacd68-dc0c-4041-9c3a-df59a5357c23","details":{"acronym":"AGO","brand":"attorney-generals-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5cd1619de5274a34eb6b9945/s960_Courts_of_Justice_new.jpg","url":"https://assets.publishing.service.gov.uk/media/5cd1619d40f0b6332070f272/s300_Courts_of_Justice_new.jpg"},"logo":{"crest":"single-identity","formatted_title":"Attorney <br/>General&#39;s <br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Attorney General's Office","web_url":"https://www.gov.uk/government/organisations/attorney-generals-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/solicitor-general","api_url":"https://www.gov.uk/api/content/government/ministers/solicitor-general","base_path":"/government/ministers/solicitor-general","content_id":"845e6af3-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Solicitor General supports the Attorney across a range of responsibilities. This includes:</p>\n\n<ul>\n  <li>Responsibility for matters delegated by the Attorney General, including deputising for the Attorney at the Parliamentary Business and Legislation Cabinet Committee</li>\n  <li>Providing support to the Attorney General in their superintendence of the Government Legal Department, the Crown Prosecution Service, HM Crown Prosecution Service Inspectorate and the Serious Fraud Office</li>\n  <li>Supporting the Attorney General in their public interest functions</li>\n  <li>Promoting the rule of law at home and internationally</li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-22T13:25:44Z","schema_name":"role","title":"Solicitor General","web_url":"https://www.gov.uk/government/ministers/solicitor-general","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-15T17:51:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784134563.318-10.13.20.148-2635","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Man who stabbed two strangers in London Underground has sentence increased","updated_at":"2026-09-10T10:48:40+01:00","withdrawn_notice":{}}