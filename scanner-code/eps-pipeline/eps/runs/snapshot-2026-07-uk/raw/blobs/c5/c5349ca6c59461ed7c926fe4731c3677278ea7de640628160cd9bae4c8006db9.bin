{"analytics_identifier":null,"base_path":"/government/speeches/un-human-rights-council-62-uk-general-comment-on-the-draft-resolution-on-disinformation","content_id":"8b815273-52e3-4f40-b9e7-35305370bafb","description":"UK General Comment on the draft resolution on disinformation. Delivered by UK Human Rights Ambassador, Eleanor Sanders.","details":{"body":"<div class=\"govspeak\"><p>Thank you, Mr President,</p>\n\n<p>The UK is pleased to be member of the core group and thanks Ukraine, as penholder, for its leadership and constructive engagement throughout the negotiations. This resolution addresses and recognises disinformation as a growing challenge to the enjoyment of human rights and democratic participation.</p>\n\n<p>We have seen first-hand the harmful impact of disinformation, including foreign information manipulation and interference, both in the UK and internationally. Such activity seeks to undermine trust in democratic institutions, distort public debate and, in some cases, exacerbate conflict and human rights violations.<br>\n </p>\n\n<p>We therefore particularly welcome updates to the text that reflect the evolving information environment, including references to foreign information manipulation and interference (FIMI), synthetic media, information integrity, and the human rights implications of artificial intelligence. These additions strengthen the resolution’s relevance and underscore the need for rights-respecting responses to emerging threats. \n </p>\n\n<p>We encourage all delegations to support the draft.</p>\n\n<p>Thank you</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-07-07T15:52:37Z"}],"delivered_on":"2026-07-06T00:00:00+01:00","first_public_at":"2026-07-07T16:52:37.000+01:00","image":{"alt_text":"Eleanor Sanders","url":"https://assets.publishing.service.gov.uk/media/66f261ca53d61b1b433ee2eb/Eleanor_2.jpg"},"location":"Geneva","political":true,"speech_type_explanation":"Transcript of the speech, exactly as it was delivered"},"document_type":"speech","first_published_at":"2026-07-07T16:52:37+01:00","links":{"available_translations":[{"api_path":"/api/content/government/speeches/un-human-rights-council-62-uk-general-comment-on-the-draft-resolution-on-disinformation","api_url":"https://www.gov.uk/api/content/government/speeches/un-human-rights-council-62-uk-general-comment-on-the-draft-resolution-on-disinformation","base_path":"/government/speeches/un-human-rights-council-62-uk-general-comment-on-the-draft-resolution-on-disinformation","content_id":"8b815273-52e3-4f40-b9e7-35305370bafb","document_type":"speech","links":{},"locale":"en","public_updated_at":"2026-07-07T15:52:37Z","schema_name":"speech","title":"UN Human Rights Council 62: UK General Comment on the draft resolution on disinformation","web_url":"https://www.gov.uk/government/speeches/un-human-rights-council-62-uk-general-comment-on-the-draft-resolution-on-disinformation","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/eleanor-sanders","api_url":"https://www.gov.uk/api/content/government/people/eleanor-sanders","base_path":"/government/people/eleanor-sanders","content_id":"4301c606-5fdc-4e77-bbf1-1dbce629f3c8","document_type":"person","links":{},"locale":"en","public_updated_at":"2024-09-24T08:38:41Z","schema_name":"person","title":"Eleanor Sanders","web_url":"https://www.gov.uk/government/people/eleanor-sanders","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"content_id":"9066fb8d-4a60-442b-8b3f-6f6c10936714","details":{"body":"<p>The UK’s Ambassador for Human Rights exists to defend and advance human rights and democracy globally. Promoting human rights and the rule of law is fundamental to maintaining stability and preventing conflict and is therefore at the heart of the UK’s interests.  </p>\n\n<p>The Ambassador for Human Rights has 3 main objectives:</p>\n\n<ul>\n  <li>protecting and promoting human rights within the multilateral system, including at the United Nations Human Rights Council</li>\n  <li>working in partnership with countries to support and advance human rights</li>\n  <li>promoting other human rights campaigns in support of the UK’s international priorities</li>\n</ul>\n\n<p>The Ambassador engages with civil society and human rights defenders. Through country missions, she engages with states, human rights institutions and other international partners to champion positive progress made by states, encourage advances and identify areas for collaboration and partnership to support protections and promotion of human rights within those countries.</p>\n","role_payment_type":null},"document_type":"ambassador_role","links":{},"locale":"en","public_updated_at":"2026-03-02T16:11:40Z","schema_name":"role","title":"Ambassador for Human Rights and Deputy Permanent Representative to the United Nations and other International Organisations in Geneva ","withdrawn":false}],"speaker":[{"api_path":"/api/content/government/people/eleanor-sanders","api_url":"https://www.gov.uk/api/content/government/people/eleanor-sanders","base_path":"/government/people/eleanor-sanders","content_id":"4301c606-5fdc-4e77-bbf1-1dbce629f3c8","document_type":"person","links":{},"locale":"en","public_updated_at":"2024-09-24T08:38:41Z","schema_name":"person","title":"Eleanor Sanders","web_url":"https://www.gov.uk/government/people/eleanor-sanders","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/human-rights-internationally","api_url":"https://www.gov.uk/api/content/international/human-rights-internationally","base_path":"/international/human-rights-internationally","content_id":"cb7db7bb-d0b4-4e22-9f0b-58a28c2db38c","details":{"internal_name":"Human rights internationally [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8835-b3b51ae1c8b2","description":"","details":{"internal_name":"International","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.gov.uk/international","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:14:19Z","schema_name":"taxon","title":"Human rights internationally","web_url":"https://www.gov.uk/international/human-rights-internationally","withdrawn":false}],"world_locations":[{"analytics_identifier":"WL150","api_path":"/api/content/world/uk-mission-to-the-wto-un-and-other-international-organisations-geneva","api_url":"https://www.gov.uk/api/content/worl