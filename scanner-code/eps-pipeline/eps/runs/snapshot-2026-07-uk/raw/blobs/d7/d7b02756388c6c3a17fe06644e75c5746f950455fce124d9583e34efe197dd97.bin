e":"Department for Culture, Media and Sport","web_url":"https://www.gov.uk/government/organisations/department-for-culture-media-and-sport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state-minister-for-museums-heritage-and-gambling-and-lords-minister","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state-minister-for-museums-heritage-and-gambling-and-lords-minister","base_path":"/government/ministers/parliamentary-under-secretary-of-state-minister-for-museums-heritage-and-gambling-and-lords-minister","content_id":"95345679-fd5c-4941-b78b-6a30163d574d","details":{"body":"<p>The Minister for Museums, Heritage and Gambling, and Lords Minister  is responsible for:</p>\n\n<ul>\n  <li>Museums and cultural property</li>\n  <li>Heritage</li>\n  <li>Gambling </li>\n  <li>Libraries</li>\n  <li>The National Archives</li>\n  <li>Corporate Minister and Legislation</li>\n  <li>DCMS business in the House of Lords</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-11T14:28:25Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Museums, Heritage and Gambling, and Lords Minister)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state-minister-for-museums-heritage-and-gambling-and-lords-minister","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/arts-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture/arts-and-culture","base_path":"/society-and-culture/arts-and-culture","content_id":"b29cf14b-54c6-402c-a9f0-77218602d1af","details":{"internal_name":"Arts and culture [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:31:27Z","schema_name":"taxon","title":"Society and culture","web_url":"https://www.gov.uk/society-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:12:17Z","schema_name":"taxon","title":"Arts and culture","web_url":"https://www.gov.uk/society-and-culture/arts-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-03T14:00:05+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783079691.818-10.13.22.246-2889","publishing_scheduled_at":"2026-07-03T14:00:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":5,"schema_name":"news_article","title":"Export bar to save flint handaxes crafted by some of Britain’s very first human settlers","updated_at":"2026-09-16T16:12:19+01:00","withdrawn_notice":{}}