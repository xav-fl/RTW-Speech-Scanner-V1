ets.publishing.service.gov.uk/media/5a37dad140f0b649cceb1813/s960_defra-sign-grey.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dad1ed915d5a62fdc6d6/s300_defra-sign-grey.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Environment,<br/>Food &amp; Rural Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Environment, Food & Rural Affairs","web_url":"https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs","withdrawn":false},{"analytics_identifier":"EA199","api_path":"/api/content/government/organisations/environment-agency","api_url":"https://www.gov.uk/api/content/government/organisations/environment-agency","base_path":"/government/organisations/environment-agency","content_id":"16628142-57b2-4611-bc03-5912785acee3","details":{"acronym":"","brand":"department-for-environment-food-rural-affairs","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/62c56ed9e90e0774833f5583/s960_EA-officer-high-viz-jacket_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/62c56ed9d3bf7f30034430da/s300_EA-officer-high-viz-jacket_960x640.jpg"},"logo":{"crest":"custom","formatted_title":"Environment Agency","image":{"alt_text":"Environment Agency","url":"https://assets.publishing.service.gov.uk/media/61fd3365e90e0768a8e97523/environment-agency-logo-480w.png"}},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Environment Agency","web_url":"https://www.gov.uk/government/organisations/environment-agency","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/emma-hardy","api_url":"https://www.gov.uk/api/content/government/people/emma-hardy","base_path":"/government/people/emma-hardy","content_id":"d0d49672-5b29-4b82-9e2e-2b50ecd3d232","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T10:04:15Z","schema_name":"person","title":"Emma Hardy MP","web_url":"https://www.gov.uk/government/people/emma-hardy","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D7","api_path":"/api/content/government/organisations/department-for-environment-food-rural-affairs","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-environment-food-rural-affairs","base_path":"/government/organisations/department-for-environment-food-rural-affairs","content_id":"de4e9dc6-cca4-43af-a594-682023b84d6c","details":{"acronym":"Defra","brand":"department-for-environment-food-rural-affairs","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dad140f0b649cceb1813/s960_defra-sign-grey.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dad1ed915d5a62fdc6d6/s300_defra-sign-grey.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Environment,<br/>Food &amp; Rural Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Environment, Food & Rural Affairs","web_url":"https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--224","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--224","base_path":"/government/ministers/minister-of-state--224","content_id":"672f4627-1b50-444b-ab44-9f60b04b61fc","details":{"body":"<p>The Minister of State in the Department for Environment, Food and Rural Affairs has specific responsibilities for:</p>\n\n<ul>\n  <li>water reform and delivery</li>\n  <li>environmental governance, including the Environmental Improvement Plan</li>\n  <li>flooding and emergencies</li>\n  <li>waste, resources and the circular economy</li>\n  <li>chemicals and air quality</li>\n  <li>sponsorship of the Office for Environmental Protection (OEP), Environment Agency, the New Water Regulator and Consumer Council for Water (CCW)</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-20T12:52:53Z","schema_name":"role","title":"Minister of State","web_url":"https://www.gov.uk/government/ministers/minister-of-state--224","withdrawn":false}],"taxons":[{"api_path":"/api/content/business/environmental-management-water-drought-and-water-availability","api_url":"https://www.gov.uk/api/content/business/environmental-management-water-drought-and-water-availability","base_path":"/business/environmental-management-water-drought-and-water-availability","content_id":"75ba781f-1bbb-4b11-89db-aad08e9a9259","details":{"internal_name":"Drought and water availability [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment/water-management","api_url":"https://www.gov.uk/api/content/environment/water-management","base_path":"/environment/water-management","content_id":"cb4c8377-6fcb-4022-a7a1-98395eb50508","description":"","details":{"internal_name":"Water management (level 2)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment","api_url":"https://www.gov.uk/api/content/environment","base_path":"/environment","content_id":"3cf97f69-84de-41ae-bc7b-7e2cc238fa58","description":"","details":{"internal_name":"Environment","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T13:39:00Z","schema_name":"taxon","title":"Environment","web_url":"https://www.gov.uk/environment","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2025-03-18T11:52:36Z","schema_name":"taxon","title":"Water management","web_url":"https://www.gov.uk/environment/water-management","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:13:07Z","schema_name":"taxon","title":"Drought and water availability","web_url":"https://www.gov.uk/business/environmental-management-water-drought-and-water-availability","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-29T12:57:17+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785326237.614-10.13.22.182-2360","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Drought declared in half of England","updated_at":"2026-09-10T10:49:54+01:00","withdrawn_notice":{}}