/people/lisa-nandy","api_url":"https://www.gov.uk/api/content/government/people/lisa-nandy","base_path":"/government/people/lisa-nandy","content_id":"429385d4-66f8-490d-bea0-f2ba6255856f","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T22:05:06Z","schema_name":"person","title":"The Rt Hon Lisa Nandy MP","web_url":"https://www.gov.uk/government/people/lisa-nandy","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1383","api_path":"/api/content/government/organisations/department-for-culture-media-and-sport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-culture-media-and-sport","base_path":"/government/organisations/department-for-culture-media-and-sport","content_id":"ae9ef2e1-9de0-4ff8-b560-e6ac28a6205c","details":{"acronym":"","brand":"department-for-culture-media-sport","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Culture,<br/>Media &amp; Sport"},"organisation_govuk_status":{"status":"replaced","updated_at":"2026-07-20T00:00:00.000+01:00","url":""}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Culture, Media and Sport","web_url":"https://www.gov.uk/government/organisations/department-for-culture-media-and-sport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-scotland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-scotland","base_path":"/government/ministers/secretary-of-state-for-scotland","content_id":"845e65ce-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Scotland is the UK Government Cabinet Minister representing Scotland. They act as the custodian of the Scottish devolution settlement, represent Scottish interests within the UK Government, and advocate for the UK Government’s policies in Scotland. </p>\n\n<p>They also promote partnership between the UK Government and the Scottish Government, as well as relations between the UK and Scottish Parliaments.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Industrial Strategy Delivery</li>\n  <li>Local Growth and City Deals Strategy</li>\n  <li>Data, Digital and AI</li>\n  <li>Investment, Economy and Fiscal</li>\n  <li>Defence</li>\n  <li>Energy and North Sea Policy</li>\n  <li>Brand Scotland Programme</li>\n  <li>International &amp; Trade Missions</li>\n  <li>Constitutional and Devolution Policy</li>\n  <li>UK Internal Market</li>\n  <li>Intergovernmental Relations</li>\n  <li>Home Affairs</li>\n  <li>Corporate</li>\n</ul>\n","role_payment_type":null,"seniority":24,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T13:41:13Z","schema_name":"role","title":"Secretary of State for Scotland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-scotland","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-culture-media-and-sport--3","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-culture-media-and-sport--3","base_path":"/government/ministers/secretary-of-state-for-culture-media-and-sport--3","content_id":"678d77ba-5a37-4b93-9588-4a003efa8dbf","details":{"body":"<p>The Secretary of State has overall responsibility for strategy and policy across the Department for Culture, Media and Sport.</p>\n","role_payment_type":null,"seniority":24,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-26T07:40:50Z","schema_name":"role","title":"Secretary of State for Culture, Media and Sport","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-culture-media-and-sport--3","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/arts-and-culture","api_url":"https://www.gov.uk/api/content/society-and-