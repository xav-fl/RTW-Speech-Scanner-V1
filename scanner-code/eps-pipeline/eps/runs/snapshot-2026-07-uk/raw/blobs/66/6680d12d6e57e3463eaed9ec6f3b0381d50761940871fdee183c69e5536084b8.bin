,"web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-environment-food-and-rural-affairs","withdrawn":false}],"taxons":[{"api_path":"/api/content/environment/waste-environment","api_url":"https://www.gov.uk/api/content/environment/waste-environment","base_path":"/environment/waste-environment","content_id":"090c16bc-7b3e-42cd-b93c-645ab43fae30","description":"","details":{"internal_name":"Waste and environmental impact","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment/waste-and-recycling","api_url":"https://www.gov.uk/api/content/environment/waste-and-recycling","base_path":"/environment/waste-and-recycling","content_id":"f4e9e92d-9192-4e17-90c6-553339bc04c3","description":"","details":{"internal_name":"Waste and recycling","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/environment","api_url":"https://www.gov.uk/api/content/environment","base_path":"/environment","content_id":"3cf97f69-84de-41ae-bc7b-7e2cc238fa58","description":"","details":{"internal_name":"Environment","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T13:39:00Z","schema_name":"taxon","title":"Environment","web_url":"https://www.gov.uk/environment","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T11:57:52Z","schema_name":"taxon","title":"Waste and recycling","web_url":"https://www.gov.uk/environment/wa