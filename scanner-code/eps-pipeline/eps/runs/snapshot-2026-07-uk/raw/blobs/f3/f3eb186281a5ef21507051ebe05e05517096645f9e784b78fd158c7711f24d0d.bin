-sport","default_news_image":null,"logo":{"crest":"no-identity","formatted_title":"UK Anti-Doping"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"http://www.ukad.org.uk"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"UK Anti-Doping","web_url":"https://www.gov.uk/government/organisations/uk-anti-doping","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/keir-starmer","api_url":"https://www.gov.uk/api/content/government/people/keir-starmer","base_path":"/government/people/keir-starmer","content_id":"86d507f5-c34e-466b-b622-4d4585b75916","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T10:49:41Z","schema_name":"person","title":"The Rt Hon Sir Keir Starmer KCB KC MP","web_url":"https://www.gov.uk/government/people/keir-starmer","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1383","api_path":"/api/content/government/organisations/department-for-culture-media-and-sport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-culture-media-and-sport","base_path":"/government/organisations/department-for-culture-media-and-sport","content_id":"ae9ef2e1-9de0-4ff8-b560-e6ac28a6205c","details":{"acronym":"","brand":"department-for-culture-media-sport","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Culture,<br/>Media &amp; Sport"},"organisation_govuk_status":{"status":"replaced","updated_at":"2026-07-20T00:00:00.000+01:00","url":""}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Culture, Media and Sport","web_url":"https://www.gov.uk/government/organisations/department-for-culture-media-and-sport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/museums-and-galleries","api_url":"https://www.gov.uk/api/content/society-and-culture/museums-and-galleries","base_path":"/society-and-culture/museums-and-galleries","content_id":"b48b3d72-68e4-4d17-9846-c5b2bbc028d5","details":{"internal_name":"Museums and galleries [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture/arts-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture/arts-and-culture","base_path":"/society-and-culture/arts-and-culture","content_id":"b29cf14b-54c6-402c-a9f0-77218602d1af","details":{"internal_name":"Arts and culture [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","det