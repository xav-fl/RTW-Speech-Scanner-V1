:[{"api_path":"/api/content/business-and-industry/science-and-innovation","api_url":"https://www.gov.uk/api/content/business-and-industry/science-and-innovation","base_path":"/business-and-industry/science-and-innovation","content_id":"ccb77bcc-56b4-419a-b5ce-f7c2234e0546","details":{"internal_name":"Science and innovation","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:02Z","schema_name":"taxon","title":"Business and industry","web_url":"https://www.gov.uk/business-and-industry","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-03T15:41:05Z","schema_name":"taxon","title":"Science and innovation","web_url":"https://www.gov.uk/business-and-industry/science-and-innovation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2022-03-08T11:13:39Z","schema_name":"taxon","title":"Artificial intelligence","web_url":"https://www.gov.uk/business-and-industry/artificial-intelligence","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-13T22:30:01+01:00","publishing_app":"whitehall","publishing_request_id":"21-1784212253.688-10.13.20.148-1156776","publishing_scheduled_at":"2026-07-13T22:30:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Barnsley Tech Town's £800,000 AI skills fund opens for applications","updated_at":"2026-09-10T10:50:38+01:00","withdrawn_notice":{}}