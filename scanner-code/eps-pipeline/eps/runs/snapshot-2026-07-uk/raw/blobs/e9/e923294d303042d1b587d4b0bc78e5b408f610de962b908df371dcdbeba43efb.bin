ld_location_news","title":"UK Mission to ASEAN","web_url":"https://www.gov.uk/world/uk-mission-to-asean","withdrawn":false},{"analytics_identifier":"WL160","content_id":"5e9f2900-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{"world_location_news":[{"analytics_identifier":"WL160","api_path":"/api/content/world/vietnam/news","api_url":"https://www.gov.uk/api/content/world/vietnam/news","base_path":"/world/vietnam/news","content_id":"015bc08d-6b8f-4d6a-b60c-0fb4caf7745f","description":"Updates, news and events from the UK government in Vietnam","document_type":"world_location_news","links":{},"locale":"en","public_updated_at":"2024-07-08T02:34:44Z","schema_name":"world_location_news","title":"Vietnam and the UK","web_url":"https://www.gov.uk/world/vietnam/news","withdrawn":false}]},"locale":"en","public_updated_at":"2017-08-18T03:47:23Z","schema_name":"world_location","title":"Vietnam","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-22T14:55:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1785158864.316-10.13.20.25-2657","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"speech","title":"Foreign Secretary's remarks at ASEAN Foreign Ministers' Meeting in Manila","updated_at":"2026-09-15T08:49:45+01:00","withdrawn_notice":{}}