url":"https://assets.publishing.service.gov.uk/media/669fa7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/natalie-fleet","api_url":"https://www.gov.uk/api/content/government/people/natalie-fleet","base_path":"/government/people/natalie-fleet","content_id":"1e5c20f9-4351-4712-b7f4-3a67ca4671cc","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T07:46:45Z","schema_name":"person","title":"Natalie Fleet MP","web_url":"https://www.gov.uk/government/people/natalie-fleet","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D16","api_path":"/api/content/government/organisations/home-office","api_url":"https://www.gov.uk/api/content/government/organisations/home-office","base_path":"/government/organisations/home-office","content_id":"06056197-bc69-4147-aa28-070bca132178","details":{"acronym":"Home Office","brand":"home-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/669fa7f5ce1fd0da7b592afc/s960_2MS_Home_Office_sign_-_landscape.jpg","url":"https://assets.publishing.service.gov.uk/media/669fa7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--308","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--308","base_path":"/government/ministers/parliamentary-under-secretary-of-state--308","content_id":"73f13714-3f3f-489c-929f-6935e178490a","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>safeguarding  </li>\n  <li>rape and serious sexual offences </li>\n  <li>violent crime and domestic abuse  </li>\n  <li>child sexual abuse and exploitation </li>\n  <li>violence against women and girls (VAWG)  </li>\n  <li>victims  </li>\n  <li>wider modern slavery policy including the national referral mechanism, support and stakeholder engagement </li>\n  <li>spiking  </li>\n  <li>oversight of Disclosure and Barring Service (DBS)</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-21T13:01:14Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Safeguarding and Violence Against Women and Girls)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--308","withdrawn":false}],"taxons":[{"api_path":"/api/content/childcare-parenting/preventing-neglect-abuse-and-exploitation","api_url":"https://www.gov.uk/api/content/childcare-parenting/preventing-neglect-abuse-and-exploitation","base_path":"/childcare-parenting/preventing-neglect-abuse-and-exploitation","content_id":"47fbdb87-b4ff-432a-a4cf-a2f2468ff6d4","description":"Online safety. Reporting and dealing with allegations of abuse. Female genital mutilation (FGM).","details":{"internal_name":"Preventing neglect, abuse and exploitation","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting/safeguarding-child-protection","api_url":"https://www.gov.uk/api/content/childcare-parenting/safeguarding-child-protection","base_path":"/childcare-parenting/safeguarding-child-protection","content_id":"5af6180c-d5db-4cc1-a68e-7bd066908132","description":"Preventing and reporting abuse. Homeless children, abduction, serious case reviews, data collection.","details":{"internal_name":"Safeguarding and child protection","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting/safeguarding-and-social-care-for-children","api_url":"https://www.gov.uk/api/content/childcare-parenting/safeguarding-and-social-care-for-children","base_path":"/childcare-parenting/safeguarding-and-social-care-for-children","content_id":"20eb4e84-98ee-404b-a4bd-fe8a36d5d71d","description":"Child protection, social work, children in care and looked-after children, becoming a social care provider.","details":{"internal_name":"Safeguarding and social care for children","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting","api_url":"https://www.gov.uk/api/content/childcare-parenting","base_path":"/childcare-parenting","content_id":"206b7f3a-49b5-476f-af0f-fd27e2a68473","description":"Financial support, finding and providing childcare, pregnancy and birth, adoption and fostering, looked-after children, safeguarding.","details":{"internal_name":"Parenting, childcare and childrens services","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-07-27T13:29:23Z","schema_name":"taxon","title":"P