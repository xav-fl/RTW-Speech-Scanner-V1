of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/museums-and-galleries","api_url":"https://www.gov.uk/api/content/society-and-culture/museums-and-galleries","base_path":"/society-and-culture/museums-and-galleries","content_id":"b48b3d72-68e4-4d17-9846-c5b2bbc028d5","details":{"internal_name":"Museums and galleries [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture/arts-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture/arts-and-culture","base_path":"/society-and-culture/arts-and-culture","content_id":"b29cf14b-54c6-402c-a9f0-77218602d1af","details":{"internal_name":"Arts and culture [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:31:27Z","schema_name":"taxon","title":"Society and culture","web_url":"https://www.gov.uk/society-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:12:17Z","schema_name":"taxon","title":"Arts and culture","web_url":"https://www.gov.uk/society-and-culture/arts-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:12:17Z","schema_name":"taxon","title":"Museums and galleries","web_url":"https://www.gov.uk/society-and-culture/museums-and-galleries","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-08T15:47:55+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783522075.540-10.13.21.194-2268","publishing_scheduled_at":"2026-07-08T12:00:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Royal Museums Greenwich Board Appointments and Reappointments","updated_at":"2026-09-16T16:12:40+01:00","withdrawn_notice":{}}