shing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--256","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--256","base_path":"/government/ministers/parliamentary-under-secretary-of-state--256","content_id":"d9972b0f-b836-4161-825e-004db0281512","details":{"body":"<p>The minister’s responsibilities include:</p>\n\n<ul>\n  <li>early years education including for children with special educational needs and disabilities (SEND)</li>\n  <li>childcare and the home learning environment</li>\n  <li>early years workforce</li>\n  <li>early communication skills and early intervention</li>\n  <li>Best Start Family Hubs and parenting</li>\n  <li>breakfast clubs</li>\n  <li>school food, including free school meals</li>\n  <li>holiday activities and food (HAF) programme</li>\n  <li>school attendance, including register of children who are not in school</li>\n  <li>reception admissions</li>\n  <li>changes to existing schools</li>\n  <li>home-to-school transport</li>\n  <li>mental health support in schools</li>\n  <li>behaviour, preventing bullying and exclusions in schools</li>\n  <li>school uniform</li>\n  <li>young carers</li>\n  <li>independent schools</li>\n  <li>illegal schools</li>\n  <li>faith schools</li>\n  <li>intervention in failing schools and school improvement</li>\n  <li>use of data, digital technology and artificial intelligence (AI) in education</li>\n  <li>use of research, science and evidence at DfE</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:16:04Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Early Education)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--256","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/adult-learning","api_url":"https://www.gov.uk/api/content/education/adult-learning","base_path":"/education/adult-learning","content_id":"e6017952-1324-4e3c-98d4-226ac0492a03","description":"Adult education budget funding information including traineeships and advanced learner loans. Research into adult learning.","details":{"internal_name":"Adult learning","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2025-01-22T14:06:55Z","schema_name":"taxon","title":"Adult learning","web_url":"https://www.gov.uk/education/adult-learning","withdrawn":false},{"api_path":"/api/content/education/becoming-an-apprentice","api_url":"https://www.gov.uk/api/content/education/becoming-an-apprentice","base_path":"/education/becoming-an-apprentice","content_id":"ff0e8e1f-4dea-42ff-b1d5-f1ae37807af2","description":"Find or become an apprentice in a variety of roles, from hair and beauty to agriculture.","details":{"internal_name":"Becoming an apprentice","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/apprenticeships-traineeships-and-internships","api_url":"https://www.gov.uk/api/content/education/apprenticeships-traineeships-and-internships","base_path":"/education/apprenticeships-traineeships-and-internships","content_id":"aaeb7f58-d410-4c42-8775-05b0bdeceeea","description":"Finding an apprenticeship, internship or traineeship plus guidance for employers on offering training opportunities.","details":{"internal_name":"Apprenticeships, traineeships and internships","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-05-30T09:56:25Z","schema_name":"taxon","title":"Apprenticeships, traineeships and internships","web_url":"https://www.gov.uk/education/apprenticeships-traineeships-and-internships","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-05-30T09:57:57Z","schema_name":"taxon","title":"Becoming an apprentice","web_url":"https://www.gov.uk/education/becoming-an-apprentice","withdrawn":false},{"api_path":"/api/content/education/hiring-and-training-an-apprentice","api_url":"https://www.gov.uk/api/content/education/hiring-and-training-an-apprentice","base_path":"/education/hiring-and-training-an-apprentice","content_id":"56b78356-c7bf-4460-8775-d04b590ec7ca","description":"Hiring an apprentice, using the apprenticeship service, funding guidance, plus a list of apprenticeship training providers.","details":{"internal_name":"Hiring and training an apprentice","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/apprenticeships-traineeships-and-internships","api_url":"https://www.gov.uk/api/content/education/apprenticeships-traineeships-and-internshi