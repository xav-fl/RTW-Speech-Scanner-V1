.gov.uk","assets":[{"asset_manager_id":"697743b0f909df76c5e71edb","filename":"January_2026_Community_Update_-_Urdu.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":201030,"filename":"January_2026_Community_Update_-_Urdu.pdf","id":"9101547","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update January 2026 - Urdu","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/697743b0f909df76c5e71edb/January_2026_Community_Update_-_Urdu.pdf"},{"accessible":true,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69774407f909df76c5e71edd","filename":"January_2026_Community_Update_-_Vietnamese.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":226987,"filename":"January_2026_Community_Update_-_Vietnamese.pdf","id":"9101548","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update January 2026 - Vietnamese","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69774407f909df76c5e71edd/January_2026_Community_Update_-_Vietnamese.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69664e738d599f4c09e20003","filename":"Noise_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2012184,"filename":"Noise_Monitoring_Report_1_December_2025_to_4_January_2026.pdf","id":"9101549","isbn":"","number_of_pages":15,"title":"Noise Monitoring Report: 1 December 2025 to 4 January 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69664e738d599f4c09e20003/Noise_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69664ed78d599f4c09e20004","filename":"Dust_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2832288,"filename":"Dust_Monitoring_Report_1_December_2025_to_4_January_2026.pdf","id":"9101550","isbn":"","number_of_pages":17,"title":"Dust Monitoring Report: 1 December 2025 to 4 January 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69664ed78d599f4c09e20004/Dust_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69664f30e8b93f59c3aecd9a","filename":"Vibration_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2937759,"filename":"Vibration_Monitoring_Report_1_December_2025_to_4_January_2026.pdf","id":"9101551","isbn":"","number_of_pages":12,"title":"Vibration Monitoring Report: 1 December 2025 to 4 January 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69664f30e8b93f59c3aecd9a/Vibration_Monitoring_Report_1_December_2025_to_4_January_2026.pdf"}],"body":"<div class=\"govspeak\"><p>The government recognises that Grenfell Tower has a deep personal significance to those most affected by the tragedy and that all work at the Grenfell Tower site is sensitive. We are continuing to share information about the Tower, and listen to bereaved families, survivors and residents in the immediate community. </p>\n\n<p>In this community update we provide information about how the government and its contractors are starting to take down Grenfell Tower with respect and care. This update is translated into 12 additional languages.</p>\n\n<p>We are also publishing information about our monitoring of noise, dust and vibration levels.</p>\n\n<ul>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69664e738d599f4c09e20003/Noise_Monitoring_Report_1_December_2025_to_4_January_2026.pdf\">Noise monitoring report: 1 December 2025 to 4 January 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69664ed78d599f4c09e20004/Dust_Monitoring_Report_1_December_2025_to_4_January_2026.pdf\">Dust monitoring report: 1 December 2025 to 4 January 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69664f30e8b93f59c3aecd9a/Vibration_Monitoring_Report_1_December_2025_to_4_January_2026.pdf\">Vibration monitoring report: 1 December 2025 to 4 January 2026</a></li>\n</ul>\n\n<p>If you would like a translation of these documents please email <a href=\"mailto:GrenfellTowerSite@communities.gov.uk\">GrenfellTowerSite@communities.gov.uk</a>.</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-01-27T09:00:00Z"}],"document_type_label":"Correspondence","documents":["<section data-module=\"ga4-link-tracker\" class=\"gem-c-attachment govuk-!-margin-bottom-6\">\n  <div class=\"gem-c-attachment__thumbnail govuk-!-display-none-print\">\n    <a class=\"govuk-link\" target=\"_self\" tabindex=\"-1\" aria-hidden=\"true\" data-ga4-link=\"{&quot;event_name&quot;:&quot;file_download&quot;,&quot;type&quot;:&quot;attachment&quot;}\" href=\"https://assets.publishing.service.gov.uk/media/69724690d8adeaf266040556/Grenfell_Tower_community_update_January_2026.pdf\">\n        <svg class=\"gem-c-attachment__thumbnail-image gem-c-attachment__thumbnail-image--pdf\" version=\"1.1\" viewBox=\"0 0 99 140\">\n  <path d=\"M12,59h9v9h-9v-9ZM30,77v9h39v-9H30ZM30,104h57v-9H30v9ZM30,12