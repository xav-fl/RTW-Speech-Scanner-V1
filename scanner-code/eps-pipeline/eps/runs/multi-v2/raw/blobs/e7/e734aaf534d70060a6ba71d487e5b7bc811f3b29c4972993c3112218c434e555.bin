tions Command","web_url":"https://www.gov.uk/government/organisations/cyber-and-specialist-operations-command","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/louise-sandher-jones","api_url":"https://www.gov.uk/api/content/government/people/louise-sandher-jones","base_path":"/government/people/louise-sandher-jones","content_id":"1ac2a507-21a5-477c-a012-c12ea4a38b66","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-14T13:54:32Z","schema_name":"person","title":"Louise Sandher-Jones MP","web_url":"https://www.gov.uk/government/people/louise-sandher-jones","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--287","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--287","base_path":"/government/ministers/parliamentary-under-secretary-of-state--287","content_id":"f6a289aa-d881-4b3f-9607-825dad929c79","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the Department of State</li>\n  <li>Recruitment</li>\n  <li>Retention and incentivisation, including training, skills and development</li>\n  <li>Service resettlement and transition</li>\n  <li>Office for Veterans Affairs (including veterans policy, delivery and VALOUR)</li>\n  <li>Armed Forces Covenant</li>\n  <li>Armed Forces People</li>\n  <li>Armed Forces Families</li>\n  <li>Housing (including Defence Housing Service)</li>\n  <li>Civilian workforce (including Royal Fleet Auxillary)</li>\n  <li>Defence Business Services (including legal, pensions and compensation)</li>\n  <li>Defence culture – including oversight of the Raising our Standards Programme and Equality, Diversity and Inclusion</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/military-equipment-logistics-technology","api_url":"https://www.gov.uk/api/content/defence/military-equipment-logistics-technology","base_path":"/defence/military-equipment-logistics-technology","content_id":"ac5d432a-11a9-40e1-bb83-0de26106b9d6","details":{"internal_name":"Military equipment, logistics and technology [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https: