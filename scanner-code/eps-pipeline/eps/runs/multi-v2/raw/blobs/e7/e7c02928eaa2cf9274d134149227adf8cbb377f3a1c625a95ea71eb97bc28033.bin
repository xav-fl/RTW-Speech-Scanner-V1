},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/bridget-phillipson","api_url":"https://www.gov.uk/api/content/government/people/bridget-phillipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/support-for-special-educational-needs-and-disability-send","api_url":"https://www.gov.uk/api/content/education/support-for-special-educational-needs-and-disability-send","base_path":"/education/support-for-special-educational-needs-and-disability-send","content_id":"0f92387b-f477-4592-85e6-0742f3fcf696","description":"SEND code of practice, P scales for attainment targets, internships, guidance and support for parents and carers.","details":{"internal_name":"Support for special educational needs and disability (SEND) ","notes_for_editors":"SEND grant allocations, funding distribution.","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/special-educational-needs-and-disability-send-and-high-needs","api_url":"https://www.gov.uk/api/content/education/special-educational-needs-and-disability-send-and-high-needs","base_path":"/education/special-educational-needs-and-disability-send-and-high-needs","content_id":"47b6ce42-0bfa-42ee-9ff1-7a9c71ee9727","description":"Support and funding, SEND code of practice, extra SEND help, P scales for attainment targets, free school transport.","details":{"internal_name":"Special educational needs and disability (SEND) and high needs","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T13:04:22Z","schema_name":"taxon","title":"Special educational needs and disability (SEND) and high needs","web_url":"https://www.gov.uk/education/special-educational-needs-and-disability-send-and-high-needs","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T13:03:16Z","schema_name":"taxon","title":"Support for special educational needs and disability (SEND) ","web_url":"https://www.gov.uk/education/support-for-special-educational-needs-and-disability-send","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-23T09:03:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1774858597.814-10.13.20.149-2992","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Specialist SEND support in every school and community","updated_at":"2026-08-11T13:33:50+01:00","withdrawn_notice":{}}