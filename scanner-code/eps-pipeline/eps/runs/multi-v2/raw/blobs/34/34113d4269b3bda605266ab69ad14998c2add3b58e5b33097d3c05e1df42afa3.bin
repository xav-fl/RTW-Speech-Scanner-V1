rmats@communities.gov.uk","assets":[{"asset_manager_id":"69f0b05dc42061e837e3ab86","filename":"May_2026_Community_Update_-_Urdu.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":252216,"filename":"May_2026_Community_Update_-_Urdu.pdf","hoc_paper_number":"","id":"9263367","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update May 2026 - Urdu","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69f0b05dc42061e837e3ab86/May_2026_Community_Update_-_Urdu.pdf"},{"accessible":true,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69f0b0740bb62e692c5d6d7b","filename":"May_2026_Community_Update_-_Vietnamese.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":236230,"filename":"May_2026_Community_Update_-_Vietnamese.pdf","hoc_paper_number":"","id":"9263368","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update May 2026 - Vietnamese","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69f0b0740bb62e692c5d6d7b/May_2026_Community_Update_-_Vietnamese.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69eb4c99606c20d4121633a6","filename":"Dust_Monitoring_Report_-_2_to_29_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":4239128,"filename":"Dust_Monitoring_Report_-_2_to_29_March_2026.pdf","id":"9258611","isbn":"","number_of_pages":19,"title":"Dust monitoring report: 2 March to 29 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69eb4c99606c20d4121633a6/Dust_Monitoring_Report_-_2_to_29_March_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69eb4cc408ecdb5c6f34af4b","filename":"Vibration_Monitoring_Report_-_2_to_29_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":3130897,"filename":"Vibration_Monitoring_Report_-_2_to_29_March_2026.pdf","id":"9258627","isbn":"","number_of_pages":15,"title":"Vibration monitoring report: 2 March to 29 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69eb4cc408ecdb5c6f34af4b/Vibration_Monitoring_Report_-_2_to_29_March_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69eb4cda08ecdb5c6f34af4c","filename":"Noise_Monitoring_Report_-_2_to_29_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":1832498,"filename":"Noise_Monitoring_Report_-_2_to_29_March_2026.pdf","id":"9258628","isbn":"","number_of_pages":15,"title":"Noise monitoring report: 2 March to 29 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69eb4cda08ecdb5c6f34af4c/Noise_Monitoring_Report_-_2_to_29_March_2026.pdf"}],"body":"<div class=\"govspeak\"><p>The government recognises that Grenfell Tower has a deep personal significance to those most affected by the tragedy and that all work at the Grenfell Tower site is sensitive. We are continuing to share information about the Tower, and listen to bereaved families, survivors and residents in the immediate community. </p>\n\n<p>In this community update we provide information about how the government and its contractors are taking down Grenfell Tower with respect and care. This update is translated into 12 additional languages.</p>\n\n<p>We are also publishing information about our monitoring of dust, noise and vibration levels.</p>\n\n<ul>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69eb4c99606c20d4121633a6/Dust_Monitoring_Report_-_2_to_29_March_2026.pdf\">Dust monitoring report: 2 February to 1 March 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69eb4cc408ecdb5c6f34af4b/Vibration_Monitoring_Report_-_2_to_29_March_2026.pdf\">Vibration monitoring report: 2 February to 1 March 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69eb4cda08ecdb5c6f34af4c/Noise_Monitoring_Report_-_2_to_29_March_2026.pdf\">Noise monitoring report: 2 February to 1 March 2026</a></li>\n</ul>\n\n<p>If you would like a translation of these documents please email <a href=\"mailto:GrenfellTowerSite@communities.gov.uk\">GrenfellTowerSite@communities.gov.uk</a>.</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-04-30T08:00:02Z"}],"document_type_label":"Correspondence","emphasised_organisations":["1390d07f-12b3-4f55-9dd5-fec5fd9e3649"],"featured_attachments":["9263234","9263235","9263236","9263238","9263239","9263255","9263259","9263262","9263364","9263365","9263366","9263367","9263368","9258611","9258627","9258628"],"first_public_at":"2026-04-30T09:00:02.000+01:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotland"},"wales":{"alternative_url":"","applicable":false,"label":"Wales"}},"political":false,"tags":{"browse_pages":[]}},"document_type":"correspondence","first_published_at":"2026-04-30T09:00:02+01:00","links":{"available_translations":[{"api_path":"/api/content/government/publications/grenfell-tower-community-update-may-2026","api_url":"https://www.gov.uk/api/content