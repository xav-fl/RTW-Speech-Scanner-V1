,"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/john-healey","api_url":"https://www.gov.uk/api/content/government/people/john-healey","base_path":"/government/people/john-healey","content_id":"6e000fab-7c45-479a-8362-53a971f31f28","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:50:11Z","schema_name":"person","title":"The Rt Hon John Healey MP","web_url":"https://www.gov.uk/government/people/john-healey","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/working-armed-forces","api_url":"https://www.gov.uk/api/content/defence/working-armed-forces","base_path":"/defence/working-armed-forces","content_id":"8ff8cf05-a6e6-4757-a896-4fabd9f3229a","details":{"internal_name":"Armed forces [M] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{