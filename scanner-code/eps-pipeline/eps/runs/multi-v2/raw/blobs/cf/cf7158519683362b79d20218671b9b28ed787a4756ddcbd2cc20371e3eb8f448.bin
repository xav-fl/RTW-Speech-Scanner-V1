}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/alistair-carns","api_url":"https://www.gov.uk/api/content/government/people/alistair-carns","base_path":"/government/people/alistair-carns","content_id":"85567506-c566-4a74-9f4d-412d540102f5","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-06-11T19:45:19Z","schema_name":"person","title":"Alistair Carns DSO OBE MC MP","web_url":"https://www.gov.uk/government/people/alistair-carns","withdrawn":false},{"api_path":"/api/content/government/people/yvette-cooper","api_url":"https://www.gov.uk/api/content/government/people/yvette-cooper","base_path":"/government/people/yvette-cooper","content_id":"e3145327-542d-43d8-9c4e-f6908f265478","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T19:08:19Z","schema_name":"person","title":"The Rt Hon Yvette Cooper MP","web_url":"https://www.gov.uk/government/people/yvette-cooper","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--245","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--245","base_path":"/government/ministers/parliamentary-under-secretary-of-state--245","content_id":"4f2c5528-8485-4290-9394-8d57cc648c00","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of Military Strategic Headquarters (MSHQ)</li>\n  <li>Global Operations and commitments</li>\n  <li>Force Posture and Deployment</li>\n  <li>Homeland Defence and the National Conversation</li>\n  <li>Ukraine support – operations</li>\n  <li>Implementation and delivery of the Uncrewed Systems Centre and Uncrewed Systems Force</li>\n  <li>Intelligence</li>\n  <li>North Atlantic Treaty Organisation (NATO) operations and planning</li>\n  <li>Permanent Joint Operational Bases and Overseas Territories</li>\n  <li>Crisis response</li>\n  <li>Military Aid to Civilian Authority (MACA)</li>\n  <li>Armed Forces Bill</li>\n  <li>UN Peacekeeping and Human Security Call Out Orders</li>\n  <li>Overseas Security and Justice Assistance Reports</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:29:43Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for the Armed Forces)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--245","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/military-recruitment-training-operations","api_url":"https://www.gov.uk/api/content/defence/military-recruitment-training-operations","base_path":"/defence/military-recruitment-training-operations","content_id":"4b9f1f6f-0c16-4a99-94e5-e58a3fba461f","details":{"internal_name":"Military recruitment, training and operations [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"Military recruitment, training and operations","web_url":"https://www.gov.uk/defence/military-recruitment-training-operations","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-05-10T07:06:03+01:00","publishing_app":"whitehall","publishing_request_id":"21-1778494340.662-10.13.20.175-354825","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Military conducts daring parachute drop to deliver critical medical support to Tristan da Cunha","updated_at":"2026-08-25T10:29:46+01:00","withdrawn_notice":{}}