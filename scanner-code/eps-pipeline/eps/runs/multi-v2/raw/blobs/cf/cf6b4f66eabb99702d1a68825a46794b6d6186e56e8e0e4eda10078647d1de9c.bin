:"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--285","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--285","base_path":"/government/ministers/parliamentary-under-secretary-of-state--285","content_id":"b3eb7af0-4a93-4c6a-b943-e312093516e9","details":{"body":"<ul>\n  <li>English devolution </li>\n  <li>Mayoral Combined Authorities and pan-regional bodies </li>\n  <li>Local and regional growth and investment</li>\n  <li>Investment zones and freeports </li>\n  <li>High streets and towns  </li>\n  <li>Communities and social cohesion</li>\n  <li>Faith</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:39:09Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Devolution, Faith and Communities)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--285","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-transport","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-transport","base_path":"/government/ministers/secretary-of-state-for-transport","content_id":"845e6453-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Department for Transport business, including: </p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio and oversight of the ministerial team </li>\n  <li>delivering the transport priorities of the government: making transport cheaper, greener, and more reliable </li>\n  <li>ensuring the transport network is safe and accessible </li>\n  <li>corporate functions such as oversight of departmental finance and public appointments</li>\n</ul>\n\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-11T12:46:45Z","schema_name":"role","title":"Secretary of State for Transport","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-transport","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/devolution","api_url":"https://www.gov.uk/api/content/regional-and-local-government/devolution","base_path":"/regional-and-local-government/devolution","content_id":"f2c9ec1e-bbdd-45b8-afd7-fab0c9371d4b","details":{"internal_name":"Devolution [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:38Z","schema_name":"taxon","title":"Devolution","web_url":"https://www.gov.uk/regional-and-local-government/devolution","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-03-18T17:35:51+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773855351.766-10.13.21.59-2333","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"New amendments will create safer streets, champion culture, and strengthen local accountability under the English Devolution Bill","updated_at":"2026-08-17T13:29:35+01:00","withdrawn_notice":{}}