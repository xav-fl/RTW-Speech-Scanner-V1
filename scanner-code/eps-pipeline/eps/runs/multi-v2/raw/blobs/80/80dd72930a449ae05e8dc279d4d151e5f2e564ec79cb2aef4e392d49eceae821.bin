},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false},{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/david-lammy","api_url":"https://www.gov.uk/api/content/government/people/david-lammy","base_path":"/government/people/david-lammy","content_id":"8f917a87-3701-4171-a1db-eb3a655d07a2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:59:05Z","schema_name":"person","title":"The Rt Hon David Lammy MP","web_url":"https://www.gov.uk/government/people/david-lammy","withdrawn":false},{"api_path":"/api/content/government/people/yvette-cooper","api_url":"https://www.gov.uk/api/content/government/people/yvette-cooper","base_path":"/government/people/yvette-cooper","content_id":"e3145327-542d-43d8-9c4e-f6908f265478","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T19:08:19Z","schema_name":"person","title":"The Rt Hon Yvette Cooper MP","web_url":"https://www.gov.uk/government/people/yvette-cooper","withdrawn":false},{"api_path":"/api/content/government/people/rachel-reeves","api_url":"https://www.gov.uk/api/content/government/people/rachel-reeves","base_path":"/government/people/rachel-reeves","content_id":"18ff123b-9f73-4e6d-98a2-a693ecefbc37","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:48:57Z","schema_name":"person","title":"The Rt Hon Rachel Reeves MP","web_url":"https://www.gov.uk/government/people/rachel-reeves","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-justice","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-justice","base_path":"/government/ministers/secretary-of-state-for-justice","content_id":"845e5cf4-c0f1-11e4-8223-005056011aef","details":{"body":"<ul>\n  <li>Oversight of all justice portfolios, policy, and Ministry of Justice strategy</li>\n  <li>Oversight of cross-cutting emergency  issues, responses  supported by other  ministers according to portfolio</li>\n  <li>Oversight of international business and future relations with the EU </li>\n  <li>MOJ support for the Union</li>\n  <li>Resourcing of the department </li>\n  <li>Functions of the Lord Chancellor </li>\n  <li>Judicial policy including pay, pensions and  diversity (these and  other operational  decisions affecting the  judiciary are reserved to the Lord Chancellor)</li>\n</ul>\n","role_payment_type":null,"seniority":13,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T09:43:27Z","schema_name":"role","title":"Lord Chancellor and Secretary of State for Justice","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-justice","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false},{"api_path":"/api/content/government/ministers/chancellor-of-the-exchequer","api_url":"https://www.gov.uk/api/content/government/ministers/chancellor-of-the-exchequer","base_path":"/government/ministers/chancellor-of-the-exchequer","content_id":"845e5c6b-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Chancellor of the Exchequer is the government’s chief financial minister and is responsible for growing the UK economy, raising revenue through taxation or borrowing and for controlling public spending. He has overall responsibility for the work of the Treasury. </p>\n\n<p>The Chancellor’s responsibilities cover:  </p>\n\n<ul>\n  <li>\n    <p>Economic and fiscal policy (including presenting the annual Budget) </p>\n  </li>\n  <li>\n    <p>Oversight of the monetary framework, including setting the inflation remit, and liaison with the Governor of the Bank of England on monetary policy </p>\n  </li>\n  <li>\n    <p>UK growth and productivity, including working across government on innovation, new technologies, skills, labour markets, migration and competition.   </p>\n  </li>\n  <li>\n    <p>UK public financial institutions  </p>\n  </li>\n  <li>\n    <p>Capital markets and listings </p>\n  </li>\n  <li>\n    <p>Leading on international economic and financial affairs including at the G7 and G20 and acting as the UK Governor of the IMF, EBRD and AIIB.  </p>\n  </li>\n  <li>\n    <p>Economic security and resilience policy </p>\n  </li>\n  <li>\n    <p>International defence and security financing</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:12:00Z","schema_name":"role","title":"Chancellor of the Exchequer","web_url":"https://www.gov.uk/government/ministers/chancellor-of-the-exchequer","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/working-armed-forces","api_url":"https://www.gov.uk/api/content/defence/working-armed-forces","base_path":"/defence/working-armed-forces","content_id":"8ff8cf05-a6e6-4757-a896-4fabd9f3229a","details":{"internal_name":"Armed forces [M] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:52Z","schema_name":"taxon","title":"Armed forces","web_url":"https://www.gov.uk/defence/working-armed-forces","withdrawn":false}],"world_locations":[{"analytics_identifier":"WL110","content_id":"5e9f1551-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{},"locale":"en","public_updated_at":"2017-08-15T14:41:51Z","schema_name":"world_location","title":"Poland","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-25T11:52:00+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782908383.881-10.13.22.246-572506","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Foreign Secretary announces nearly £290 million to strengthen Ukraine's recovery and energy security","updated_at":"2026-08-26T03:02:25+01:00","withdrawn_notice":{}}