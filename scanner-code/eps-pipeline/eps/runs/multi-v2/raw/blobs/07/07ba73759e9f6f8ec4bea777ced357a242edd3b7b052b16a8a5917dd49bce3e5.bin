ma_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/running-a-further-or-higher-education-institution","api_url":"https://www.gov.uk/api/content/education/running-a-further-or-higher-education-institution","base_path":"/education/running-a-further-or-higher-education-institution","content_id":"27c5c52b-3b36-4119-b461-976197d929bf","description":"Register as a training organisations, set up a school partnership, support for FE and sixth-form colleges, guidance on the Teaching Excellence Framework and inspecting further education and skills.","details":{"internal_name":"Running a further or higher education institution","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_