mmunities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/local-government-councils-elections","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government-councils-elections","base_path":"/regional-and-local-government/local-government-councils-elections","content_id":"eca6eef8-4529-47db-8ba9-daa6305f15d3","details":{"internal_name":"Councils and elections [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government/local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government","base_path":"/regional-and-local-government/local-government","content_id":"c914fd40-dd0a-45c4-a6ff-bce0cda31bde","details":{"internal_name":"Local government (merged, Level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.