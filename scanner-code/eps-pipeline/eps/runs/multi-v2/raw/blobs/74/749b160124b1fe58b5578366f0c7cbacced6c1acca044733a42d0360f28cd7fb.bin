tion/pdf","file_size":207851,"filename":"March_2026_Community_Update_Urdu.pdf","id":"9204231","isbn":"","number_of_pages":2,"title":"Grenfell Tower: community update March 2026 - Urdu","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69c2c8753ed0546101e0dc11/March_2026_Community_Update_Urdu.pdf"},{"accessible":true,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69c2c90d3ed0546101e0dc14","filename":"March_2026_Community_Update_Vietnamese.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":237442,"filename":"March_2026_Community_Update_Vietnamese.pdf","id":"9204233","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update March 2026 - Vietnamese","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69c2c90d3ed0546101e0dc14/March_2026_Community_Update_Vietnamese.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69c29a51b920af63be1c776f","filename":"Dust_Monitoring_Report_-_2_February_to_1_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2770241,"filename":"Dust_Monitoring_Report_-_2_February_to_1_March_2026.pdf","id":"9203258","isbn":"","number_of_pages":16,"title":"Dust monitoring report: 2 February to 1 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69c29a51b920af63be1c776f/Dust_Monitoring_Report_-_2_February_to_1_March_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69c29a8313101e9908704b96","filename":"Vibration_Monitoring_Report_-_2_February_to_1_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":3487697,"filename":"Vibration_Monitoring_Report_-_2_February_to_1_March_2026.pdf","id":"9203259","isbn":"","number_of_pages":17,"title":"Vibration monitoring report: 2 February to 1 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69c29a8313101e9908704b96/Vibration_Monitoring_Report_-_2_February_to_1_March_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69c29baab920af63be1c7772","filename":"Noise_Monitoring_Report_-_2_February_to_1_March_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2373149,"filename":"Noise_Monitoring_Report_-_2_February_to_1_March_2026.pdf","id":"9203265","isbn":"","number_of_pages":16,"title":"Noise monitoring report: 2 February to 1 March 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69c29baab920af63be1c7772/Noise_Monitoring_Report_-_2_February_to_1_March_2026.pdf"}],"body":"<div class=\"govspeak\"><p>The government recognises that Grenfell Tower has a deep personal significance to those most affected by the tragedy and that all work at the Grenfell Tower site is sensitive. We are continuing to share information about the Tower, and listen to bereaved families, survivors and residents in the immediate community. </p>\n\n<p>In this community update we provide information about how the government and its contractors are taking down Grenfell Tower with respect and care. This update is translated into 12 additional languages.</p>\n\n<p>We are also publishing information about our monitoring of dust, noise and vibration levels.</p>\n\n<ul>\n  <li>\n    <p><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69c29a51b920af63be1c776f/Dust_Monitoring_Report_-_2_February_to_1_March_2026.pdf\">Dust monitoring report: 2 February to 1 March 2026</a></p>\n  </li>\n  <li>\n    <p><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69c29a8313101e9908704b96/Vibration_Monitoring_Report_-_2_February_to_1_March_2026.pdf\">Vibration monitoring report: 2 February to 1 March 2026</a></p>\n  </li>\n  <li>\n    <p><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69c29baab920af63be1c7772/Noise_Monitoring_Report_-_2_February_to_1_March_2026.pdf\">Noise monitoring report: 2 February to 1 March 2026</a></p>\n  </li>\n</ul>\n\n<p>If you would like a translation of these documents please email <a href=\"mailto:GrenfellTowerSite@communities.gov.uk\">GrenfellTowerSite@communities.gov.uk</a>.</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-03-26T09:00:02Z"}],"document_type_label":"Correspondence","documents":["<section data-module=\"ga4-link-tracker\" class=\"gem-c-attachment govuk-!-margin-bottom-6\">\n  <div class=\"gem-c-attachment__thumbnail govuk-!-display-none-print\">\n    <a class=\"govuk-link\" target=\"_self\" tabindex=\"-1\" aria-hidden=\"true\" data-ga4-link=\"{&quot;event_name&quot;:&quot;file_download&quot;,&quot;type&quot;:&quot;attachment&quot;}\" href=\"https://assets.publishing.service.gov.uk/media/69c29dc1bb0dfe55b83e4ca0/March_2026_Community_Update.pdf\">\n        <svg class=\"gem-c-attachment__thumbnail-image gem-c-attachment__thumbnail-image--pdf\" version=\"1.1\" viewBox=\"0 0 99 140\">\n  <path d=\"M12,59h9v9h-9v-9ZM30,77v9h39v-9H30ZM30,104h57v-9H30v9ZM30,122h48v-9H30v9ZM12,86h9v-9h-9v9ZM12,122h9v-9h-9v9ZM12,104h9v-9h-9v9ZM30,68h57v-9H30v9ZM35.2,21c-.3-.2-.6-.4-1-.5s-.8-.2-1.3-.2h-2.6v5.5h2.6c.5,0,1,0,1.3-.2s.7-.3,1-.5c.3-.2.5-.5.7-.8s.2-.7.2-1.1h0c0-.5,0-.9-.2-1.2-.2-.3-.4-.6-.7-.8h0ZM52.4,21.9c-.4-.5-1-.9-1.6-1.1-.7-.3-1.5-.4-2.4-.4h-2.7v11.5h2.7c.