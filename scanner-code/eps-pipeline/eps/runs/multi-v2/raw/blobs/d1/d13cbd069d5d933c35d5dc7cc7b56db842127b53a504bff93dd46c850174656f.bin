lipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","base_path":"/government/ministers/secretary-of-state-for-science-innovation-and-technology","content_id":"ea18a87c-95fa-44c0-b769-e0056c2b03bc","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Science, Innovation and Technology. See junior ministers roles for individual portfolio areas.</p>\n\n<ul>\n  <li><a href=\"https://www.gov.uk/government/people/patrick-vallance\">Minister of State for Science, Research and Innovation</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/ian-murray\">Minister of State</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/kanishka-narayan\">Parliamentary Under Secretary of State</a></li>\n</ul>\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-08T11:01:11Z","schema_name":"role","title":"Secretary of State for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-science-innovation-and-technology","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/education-of-disadvantaged-children","api_url":"https://www.gov.uk/api/content/education/education-of-disadvantaged-children","base_path":"/education/education-of-disadvantaged-children","content_id":"d2005b89-352f-4896-aced-1d17504330e6","description":"Widening participation, funding for children in deprived areas. Improving attainment in schools for looked-after children.","details":{"internal_name":"Education of disadvantaged children","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T12:32:51Z","schema_name":"taxon","title":"Education of disadvantaged children","web_url":"https://www.gov.uk/education/education-of-disadvantaged-children","withdrawn":false},{"api_path":"/api/content/education/teaching-and-leadership","api_url":"https://www.gov.uk/api/content/education/teaching-and-leadership","base_path":"/education/teaching-and-leadership","content_id":"ff00b8b2-dcdb-4659-93c2-291c9be354f3","description":"Recruiting teachers. Qualified Teacher Status (QTS) and other training, pay, standards and misconduct.","details":{"internal_name":"Teaching and leadership","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-01-30T15:42:20Z","schema_name":"taxon","title":"Teaching and leadership","web_url":"https://www.gov.uk/education/teaching-and-leadership","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-26T22:30:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1774858597.814-10.13.20.149-2992","publishing_scheduled_at":"2026-01-26T22:30:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":6,"schema_name":"news_article","title":"450,000 disadvantaged pupils could benefit from AI tutoring tools","updated_at":"2026-08-20T16:44:02+01:00","withdrawn_notice":{}}