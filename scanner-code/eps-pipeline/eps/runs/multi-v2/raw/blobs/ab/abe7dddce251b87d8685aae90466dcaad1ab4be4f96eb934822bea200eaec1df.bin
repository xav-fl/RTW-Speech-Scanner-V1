"https://www.gov.uk/api/content/government/topical-events/russian-invasion-of-ukraine-uk-government-response","base_path":"/government/topical-events/russian-invasion-of-ukraine-uk-government-response","content_id":"bfa79635-ffda-4b5d-8266-a9cd3a03649c","document_type":"topical_event","links":{},"locale":"en","public_updated_at":"2025-02-26T14:13:57Z","schema_name":"topical_event","title":"Russian invasion of Ukraine: UK government response","web_url":"https://www.gov.uk/government/topical-events/russian-invasion-of-ukraine-uk-government-response","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-09T11:48:26+01:00","publishing_app":"whitehall","publishing_request_id":"21-1776939365.515-10.13.21.107-10293","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"speech","title":"Defence Secretary No9 speech - 09 April 2026","updated_at":"2026-08-14T17:39:02+01:00","withdrawn_notice":{}}