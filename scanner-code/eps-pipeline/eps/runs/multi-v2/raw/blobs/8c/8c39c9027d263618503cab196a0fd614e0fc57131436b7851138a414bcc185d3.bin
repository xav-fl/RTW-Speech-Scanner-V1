  <li>Defence Industrial Strategy implementation and Growth</li>\n  <li>Defence Exports Campaigns and Office</li>\n  <li>Defence Readiness Bill</li>\n  <li>Ukraine support - military aid and industrial partnerships, including HIRST and KINDRED</li>\n  <li>Defence industry relationships and the Defence Industrial Joint Council</li>\n  <li>UK Defence Innovation and artificial intelligence</li>\n  <li>Climate change and sustainability</li>\n  <li>Science and technology</li>\n  <li>Defence Afghanistan Relocation and Assistance Programme (ARAP) including eligibility applications and asylum</li>\n  <li>Oversight of Parliamentary engagement and AFPS</li>\n  <li>Defence Infrastructure Organisation and defence estates</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:12:36Z","schema_name":"role","title":"Minister of State (Minister for Defence Readiness and Industry)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--207","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/working-armed-forces","api_url":"https://www.gov.uk/api/content/defence/working-armed-forces","base_path":"/defence/working-armed-forces","content_id":"8ff8cf05-a6e6-4757-a896-4fabd9f3229a","details":{"internal_name":"Armed forces [M] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content