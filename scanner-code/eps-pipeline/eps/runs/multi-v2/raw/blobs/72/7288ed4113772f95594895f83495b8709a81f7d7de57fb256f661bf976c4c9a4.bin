:{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--289","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--289","base_path":"/government/ministers/parliamentary-under-secretary-of-state--289","content_id":"a7b372be-2476-4a22-a87c-aca0513831a2","details":{"body":"<ul>\n  <li>Building safety, regulations, Building Safety Regulator and remediation </li>\n  <li>Net Zero and energy efficiency </li>\n  <li>Grenfell Inquiry response </li>\n  <li>Grenfell Community, Tower and Memorial </li>\n  <li>Fire policy and operations </li>\n  <li>Resilience, recovery, and emergencies </li>\n  <li>Elections policy  </li>\n  <li>Planning casework </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:40:54Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Building Safety, Fire and Democracy)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--289","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/local-government-councils-elections","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government-councils-elections","base_path":"/regional-and-local-government/local-government-councils-elections","content_id":"eca6eef8-4529-47db-8ba9-daa6305f15d3","details":{"internal_name":"Councils and elections [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government/local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government","base_path":"/regional-and-local-government/local-government","content_id":"c914fd40-dd0a-45c4-a6ff-bce0cda31bde","details":{"internal_name":"Local government (merged, Level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:38Z","schema_name":"taxon","title":"Local government","web_url":"https://www.gov.uk/regional-and-local-government/local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:39Z","schema_name":"taxon","title":"Councils and elections","web_url":"https://www.gov.uk/regional-and-local-government/local-government-councils-elections","withdrawn":false},{"api_path":"/api/content/government/voting","api_url":"https://www.gov.uk/api/content/government/voting","base_path":"/government/voting","content_id":"3bb5f304-edcd-4e1e-98ce-67ad8149e5eb","details":{"internal_name":"Voting [M] (level 2, government theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/democracy","api_url":"https://www.gov.uk/api/content/government/democracy","base_path":"/government/democracy","content_id":"95d06252-5d75-42fb-9c5c-038ab6b482e4","details":{"internal_name":"Democracy","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/government/all","content_id":"e48ab80a-de80-4e83-bf59-26316856a5f9","description":"","details":{"internal_name":"Government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:29:39Z","schema_name":"taxon","title":"Government","web_url":"https://www.gov.uk/government/all","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-17T15:32:42Z","schema_name":"taxon","title":"Democracy","web_url":"https://www.gov.uk/government/democracy","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-17T15:32:42Z","schema_name":"taxon","title":"Voting","web_url":"https://www.gov.uk/government/voting","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-12T10:09:41+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Tougher rules on political interference to keep UK elections secure","updated_at":"2026-08-14T15:46:21+01:00","withdrawn_notice":{}}