sation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/ellie-reeves","api_url":"https://www.gov.uk/api/content/government/people/ellie-reeves","base_path":"/government/people/ellie-reeves","content_id":"8a5e71e0-9918-471a-af46-bf024ef1231c","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T07:51:52Z","schema_name":"person","title":"The Rt Hon Ellie Reeves KC MP","web_url":"https://www.gov.uk/government/people/ellie-reeves","withdrawn":false},{"api_path":"/api/content/government/people/alex-davies-jones","api_url":"https://www.gov.uk/api/content/government/people/alex-davies-jones","base_path":"/government/people/alex-davies-jones","content_id":"2f7b87d3-f096-4cfe-9c56-b6038b048241","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-26T14:56:40Z","schema_name":"person","title":"Alex Davies-Jones MP","web_url":"https://www.gov.uk/government/people/alex-davies-jones","withdrawn":false},{"api_path":"/api/content/government/people/jake-richards","api_url":"https://www.gov.uk/api/content/government/people/jake-richards","base_path":"/government/people/jake-richards","content_id":"a430c5f7-3299-497b-8d23-33a3ab9231e2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T11:44:01Z","schema_name":"person","title":"Jake Richards MP","web_url":"https://www.gov.uk/government/people/jake-richards","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D18","api_path":"/api/content/government/organisations/ministry-of-justice","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-justice","base_path":"/government/organisations/ministry-of-justice","content_id":"dcc907d6-433c-42df-9ffb-d9c68be5dc4d","details":{"acronym":"MOJ","brand":"ministry-of-justice","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/solicitor-general","api_url":"https://www.gov.uk/api/content/government/ministers/solicitor-general","base_path":"/government/ministers/solicitor-general","content_id":"845e6af3-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Solicitor General supports the Attorney across a range of responsibilities. This includes:</p>\n\n<ul>\n  <li>Responsibility for matters delegated by the Attorney General, including deputising for the Attorney at the Parliamentary Business and Legislation Cabinet Committee</li>\n  <li>Providing support to the Attorney General in their superintendence of the Government Legal Department, the Crown Prosecution Service, HM Crown Prosecution Service Inspectorate and the Serious Fraud Office</li>\n  <li>Supporting the Attorney General in their public interest functions</li>\n  <li>Promoting the rule of law at home and internationally</li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-22T13:25:44Z","schema_name":"role","title":"Solicitor General","web_url":"https://www.gov.uk/government/ministers/solicitor-general","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--246","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--246","base_path":"/government/ministers/parliamentary-under-secretary-of-state--246","content_id":"0811d4c5-549e-4a94-a2b6-50c6b63dc24c","details":{"body":"<ul>\n  <li>Violence Against Women and Girls (VAWG)</li>\n  <li>Criminal Law</li>\n  <li>Victims, Witnesses and Vulnerabilities</li>\n  <li>Criminal Injuries Compensation Authority</li>\n  <li>Rape and Serious Sexual Offences (RASSO)</li>\n  <li>Victims and Courts Bill (VAC)</li>\n  <li>Hillsborough</li>\n  <li>Death Management, Inquiries and Coroners</li>\n  <li>Miscarriages of Justice</li>\n  <li>Criminal Cases Review Commission</li>\n  <li>MOJ Mission lead for Safer Streets</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:39:18Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Victims and Tackling Violence Against Women and Girls","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--246","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--301","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--301","base_path":"/government/ministers/parliamentary-under-secretary-of-state--301","content_id":"f0651ae4-36ac-4703-9064-826c4f0ddd93","details":{"body":"<ul>\n  <li>Sentencing Policy</li>\n  <li>Sentencing Bill</li>\n  <li>Youth Justice policy</li>\n  <li>Youth Custody operations</li>\n  <li>Human Rights and ECHR</li>\n  <li>International Justice (including Private International Law)</li>\n  <li>Crown Dependencies and Overseas Territories</li>\n  <li>Devolution and the Union</li>\n  <li>Commons Minister for Prisons, Probation and Reducing Reoffending</li>\n  <li>Transparency</li>\n  <li>Cross-cutting corporate portfolio</li>\n  <li>MOJ Mission lead for Breakdown barriers to opportunity</li>\n</ul>\n","role_payment_type":"Paid as a whip","seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:30:57Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Sentencing, Youth Justice and International","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--301","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/sentencing-reform","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/sentencing-reform","base_path":"/crime-justice-and-law/sentencing-reform","content_id":"70505387-138c-431c-a82d-94ff81f97e18","details":{"internal_name":"Sentencing reform [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Sentencing reform","web_url":"https://www.gov.uk/crime-justice-and-law/sentencing-reform","withdrawn":false},{"api_path":"/api/content/crime-justice-and-law/victims-of-crime","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/victims-of-crime","base_path":"/crime-justice-and-law/victims-of-crime","content_id":"d1b7471b-bdd1-4719-9376-b79d2f854807","details":{"internal_name":"Victims of crime [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Victims of crime","web_url":"https://www.gov.uk/crime-justice-and-law/victims-of-crime","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-09T11:26:12+01:00","publishing_app":"whitehall","publishing_request_id":"21-1775730699.006-10.13.22.123-462426","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Victims and bereaved get more time to challenge lenient sentences","updated_at":"2026-08-26T15:56:42+01:00","withdrawn_notice":{}}