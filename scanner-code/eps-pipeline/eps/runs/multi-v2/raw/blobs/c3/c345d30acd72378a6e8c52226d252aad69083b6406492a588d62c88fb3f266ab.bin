":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--207","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--207","base_path":"/government/ministers/minister-of-state--207","content_id":"47758af5-c983-42a1-bce4-e27428d164fb","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the National Armaments Director Group</li>\n  <li>Departmental communications strategy and reform</li>\n  <li>Armed forces readiness and stockpiles</li>\n  <li>Defence procurement, including reform and UK Defence Innovation</li>\n  <li>Submarine delivery</li>\n  <li>Defence Industrial Strategy implementation and Growth</li>\n  <li>Defence Exports Campaigns and Office</li>\n  <li>Defence Readiness Bill</li>\n  <li>Ukraine support - military aid and industrial partnerships, including HIRST and KINDRED</li>\n  <li>Defence industry relationships and the Defence Industrial Joint Council</li>\n  <li>UK Defence Innovation and artificial intelligence</li>\n  <li>Climate change and sustainability</li>\n  <li>Science and technology</li>\n  <li>Defence Afghanistan Relocation and Assistance Programme (ARAP) including eligibility applications and asylum</li>\n  <li>Oversight of Parliamentary engagement and AFPS</li>\n  <li>Defence Infrastructure Organisation and defence estates</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:12:36Z","schema_name":"role","title":"Minister of State (Minister for Defence Readiness and Industry)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--207","withdrawn":false},{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/international-defence-commitments","api_url":"https://www.gov.uk/api/content/defence/international-defence-commitments","base_path":"/defence/international-defence-commitments","content_id":"9f183c2c-2256-42d7-a12d-ced7b7f24195","description":"What the government’s doing about international defence commitments\r\n","details":{"internal_name":"International defence commitments (level 2) [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"ap