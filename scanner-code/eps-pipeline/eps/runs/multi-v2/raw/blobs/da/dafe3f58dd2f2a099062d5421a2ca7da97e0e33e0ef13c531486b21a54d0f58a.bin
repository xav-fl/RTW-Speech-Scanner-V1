rest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-20T17:08:55+01:00","publishing_app":"whitehall","publishing_request_id":"21-1776701335.633-10.13.20.51-2345","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"New powers to protect vital free speech at universities","updated_at":"2026-08-11T13:42:16+01:00","withdrawn_notice":{}}