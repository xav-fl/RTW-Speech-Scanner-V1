":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/samantha-dixon","api_url":"https://www.gov.uk/api/content/government/people/samantha-dixon","base_path":"/government/people/samantha-dixon","content_id":"2f60a86b-1ccd-49e7-b991-5517e4c9bbe3","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:17:59Z","schema_name":"person","title":"Samantha Dixon MBE MP","web_url":"https://www.gov.uk/government/people/samantha-dixon","withdrawn":false},{"api_path":"/api/content/government/people/steve-reed","api_url":"https://www.gov.uk/api/content/government/people/steve-reed","base_path":"/government/people/steve-reed","content_id":"bd2495e5-5e20-4814-9dab-bf88e5c706d0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T14:04:12Z","schema_name":"person","title":"The Rt Hon Steve Reed OBE MP","web_url":"https://www.gov.uk/government/people/steve-reed","withdrawn":false},{"api_path":"/api/content/government/people/darren-jones","api_url":"https://www.gov.uk/api/content/government/people/darren-jones","base_path":"/government/people/darren-jones","content_id":"66581c38-84ac-4d33-b171-2874bad55aa1","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T18:01:42Z","schema_name":"person","title":"The Rt Hon Darren Jones MP","web_url":"https://www.gov.uk/government/people/darren-jones","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--289","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--289","base_path":"/government/ministers/parliamentary-under-secretary-of-state--289","content_id":"a7b372be-2476-4a22-a87c-aca0513831a2","details":{"body":"<ul>\n  <li>Building safety, regulations, Building Safety Regulator and remediation </li>\n  <li>Net Zero and energy efficiency </li>\n  <li>Grenfell Inquiry response </li>\n  <li>Grenfell Community, Tower and Memorial </li>\n  <li>Fire policy and operations </li>\n  <li>Resilience, recovery, and emergencies </li>\n  <li>Elections policy  </li>\n  <li>Planning casework </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:40:54Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Building Safety, Fire and Democracy)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--289","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--197","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--197","base_path":"/government/ministers/minister-of-state--197","content_id":"f2c14625-b821-4e5d-97ca-d49f187ea617","details":{"body":"<p>The Chief Secretary to the Prime Minister oversees work across Government to support the delivery of the Prime Minister’s priorities and the Government’s Plan for Change.</p>\n","role_payment_type":null,"seniority":2,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-06T10:43:59Z","schema_name":"role","title":"Chief Secretary to the Prime Minister","web_url":"https://www.gov.uk/government/ministers/minister-of-state--197","withdrawn":false}],"taxons":[{"api_path":"/api/content/government/democracy","api_url":"https://www.gov.uk/api/content/government/democracy","base_path":"/government/democracy","content_id":"95d06252-5d75-42fb-9c5c-038ab6b482e4","details":{"internal_name":"Democracy","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/government/all","content_id":"e48ab80a-de80-4e83-bf59-26316856a5f9","description":"","details":{"internal_name":"Government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:29:39Z","schema_name":"taxon","title":"Government","web_url":"https://www.gov.uk/government/all","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-17T15:32:42Z","schema_name":"taxon","title":"Democracy","web_url":"https://www.gov.uk/government/democracy","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-06T00:01:03+01:00","publishing_app":"whitehall","publishing_request_id":"21-1783338974.749-10.13.20.31-29830","publishing_scheduled_at":"2026-07-06T00:01:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":4,"schema_name":"news_article","title":"Tough new rules to crackdown on foreign money in UK elections","updated_at":"2026-08-14T15:46:21+01:00","withdrawn_notice":{}}