f the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/high-streets-and-town-centres","api_url":"https://www.gov.uk/api/content/housing-local-and-community/high-streets-and-town-centres","base_path":"/housing-local-and-community/high-streets-and-town-centres","content_id":"b7558ad9-32cf-4d77-92e6-e926fc515e72","details":{"internal_name":"High streets and town centres [P] (level 3, housing theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry/uk-economy","api_url":"https://www.gov.uk/api/content/business-and-industry/uk-economy","base_path":"/business-and-industry/uk-economy","content_id":"a1e4659c-dc15-48be-bc4f-6c609ae061dc","details":{"internal_name":"UK economy","notes_for_editors":"...","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/business-and-industry","api_url":"https://www.gov.uk/api/content/business-and-industry","base_path":"/business-and-industry","content_id":"495afdb6-47be-4df1-8b38-91c8adb1eefc","description":"","details":{"internal_name":"Business and industry","notes_for_edi