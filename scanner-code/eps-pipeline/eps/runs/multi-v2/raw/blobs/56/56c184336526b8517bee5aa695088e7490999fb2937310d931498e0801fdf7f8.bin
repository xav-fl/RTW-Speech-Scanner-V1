</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/defence-armed-forces-support-services-military-defence-personnel-families-housing-and-accommodation","api_url":"https://www.gov.uk/api/content/defence/defence-armed-forces-support-services-military-defence-personnel-families-housing-and-accommodation","base_path":"/defence/defence-armed-forces-support-services-military-defence-personnel-families-housing-and-accommodation","content_id":"5bddffb2-a17e-4933-a3c5-50e90c7869b8","details":{"internal_name":"Housing and accommodation [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence/support-services-military-defence-personnel-families","api_url":"https://www.gov.uk/api/content/defence/support-services-military-defence-personnel-families","base_path":"/defence/support-services-military-defence-personnel-families","content_id":"e4b9e05a-6c04-4e18-945f-4584c08c4628","details":{"internal_name":"Support services for military and defence personnel and their families [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b