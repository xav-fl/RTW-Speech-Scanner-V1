7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/jake-richards","api_url":"https://www.gov.uk/api/content/government/people/jake-richards","base_path":"/government/people/jake-richards","content_id":"a430c5f7-3299-497b-8d23-33a3ab9231e2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T11:44:01Z","schema_name":"person","title":"Jake Richards MP","web_url":"https://www.gov.uk/government/people/jake-richards","withdrawn":false},{"api_path":"/api/content/government/people/sarah-jones","api_url":"https://www.gov.uk/api/content/government/people/sarah-jones","base_path":"/government/people/sarah-jones","content_id":"dfffc4f6-a0f9-4261-a43b-bfa4518bcfad","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-09-06T14:56:22Z","schema_name":"person","title":"Sarah Jones MP","web_url":"https://www.gov.uk/government/people/sarah-jones","withdrawn":false},{"api_path":"/api/content/government/people/david-lammy","api_url":"https://www.gov.uk/api/content/government/people/david-lammy","base_path":"/government/people/david-lammy","content_id":"8f917a87-3701-4171-a1db-eb3a655d07a2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:59:05Z","schema_name":"person","title":"The Rt Hon David Lammy MP","web_url":"https://www.gov.uk/government/people/david-lammy","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D18","api_path":"/api/content/government/organisations/ministry-of-justice","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-justice","base_path":"/government/organisations/ministry-of-justice","content_id":"dcc907d6-433c-42df-9ffb-d9c68be5dc4d","details":{"acronym":"MOJ","brand":"ministry-of-justice","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--301","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--301","base_path":"/government/ministers/parliamentary-under-secretary-of-state--301","content_id":"f0651ae4-36ac-4703-9064-826c4f0ddd93","details":{"body":"<ul>\n  <li>Sentencing Policy</li>\n  <li>Sentencing Bill</li>\n  <li>Youth Justice policy</li>\n  <li>Youth Custody operations</li>\n  <li>Human Rights and ECHR</li>\n  <li>International Justice (including Private International Law)</li>\n  <li>Crown Dependencies and Overseas Territories</li>\n  <li>Devolution and the Union</li>\n  <li>Commons Minister for Prisons, Probation and Reducing Reoffending</li>\n  <li>Transparency</li>\n  <li>Cross-cutting corporate portfolio</li>\n  <li>MOJ Mission lead for Breakdown barriers to opportunity</li>\n</ul>\n","role_payment_type":"Paid as a whip","seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:30:57Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Sentencing, Youth Justice and International","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--301","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--204","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--204","base_path":"/government/ministers/minister-of-state--204","content_id":"aafeb26d-f833-4d2f-a0a3-7ec56abf922e","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>police accountability and system reform – professional standards, performance, culture  </li>\n  <li>police resourcing and efficiency – neighbourhood policing guarantee, savings, funding </li>\n  <li>public order, major events, civil contingencies </li>\n  <li>Emergency Services Mobile Communication Programme </li>\n  <li>criminal justice system </li>\n  <li>Early intervention and Young Futures   </li>\n  <li>crime prevention: safer streets, including drugs and county lines, alcohol and licensing, anti-social behaviour, neighbourhood crime, firearms, child criminal exploitation and hate crime.</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-31T14:18:35Z","schema_name":"role","title":"Minister of State (Minister for Policing and Crime)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--204","withdrawn":false},{"api_path":"/api/content/government/ministers/deputy-prime-minister--4","api_url":"https://www.gov.uk/api/content/government/ministers/deputy-prime-minister--4","base_path":"/government/ministers/deputy-prime-minister--4","content_id":"f3483a12-6f85-4b43-ae79-e3912bb5c9d5","details":{"body":"<p>The Deputy Prime Minister:</p>\n\n<ul>\n  <li>deputises for the Prime Minister domestically and internationally, including on House of Commons business and at Prime Minister’s Questions</li>\n  <li>represents the Prime Minister and HM Government at leader-level internationally when the Prime Minister is unable to attend, promoting and protecting British interests overseas</li>\n  <li>maintains and strengthens relationships with Vice Presidents, Deputy Prime Ministers and deputy leaders of key international partners, including the United States; advancing UK strategic priorities in international engagement, including: jobs and growth, security and the rule of law, climate ambition and the transition to net zero, tackling irregular migration.</li>\n  <li>plays a key role on the National Security Council and cabinet committees on Domestic and Border Security, and Union and Constitution</li>\n  <li>leads cross-government work to reduce reoffending, bringing together the Home Office, Department of Health and Social Care, Department for Work and Pensions, and the Ministry of Housing, Communities and Local Government.</li>\n  <li>supports delivery of the government’s mission to halve knife crime, working alongside the Home Secretary</li>\n  <li>champions the rule of law globally, working with the Foreign Secretary, Home Secretary and Attorney General</li>\n  <li>with the Prime Minister and the Ministry of Housing, Communities and Local Government, helps drive a unifying story of citizenship, cohesion and the Union, including engagement across the nations and communities of the UK</li>\n  <li>leads work across government to improve outcomes for boys and men, convening departments and partners to deliver coordinated action</li>\n</ul>\n\n<p>The Deputy Prime Minister is supported by an Office of Deputy Prime Minister which coordinates work across departments and supports on the delivery of the Deputy Prime Minister’s priorities.</p>\n","role_payment_type":null,"seniority":5,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-03-30T10:56:51Z","schema_name":"role","title":"Deputy Prime Minister","web_url":"https://www.gov.uk/government/ministers/deputy-prime-minister--4","withdrawn":false}],"taxons"