a_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Reoffending and rehabilitation","web_url":"https://www.gov.uk/crime-justice-and-law/reoffending-and-rehabilitation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-03-19T11:27:28+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773919648.385-10.13.22.163-2659","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Government announces plans to tag thousands of extra offenders","updated_at":"2026-08-17T11:45:38+01:00","withdrawn_notice":{}}