/samantha-dixon","base_path":"/government/people/samantha-dixon","content_id":"2f60a86b-1ccd-49e7-b991-5517e4c9bbe3","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:17:59Z","schema_name":"person","title":"Samantha Dixon MBE MP","web_url":"https://www.gov.uk/government/people/samantha-dixon","withdrawn":false},{"api_path":"/api/content/government/people/steve-reed","api_url":"https://www.gov.uk/api/content/government/people/steve-reed","base_path":"/government/people/steve-reed","content_id":"bd2495e5-5e20-4814-9dab-bf88e5c706d0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T14:04:12Z","schema_name":"person","title":"The Rt Hon Steve Reed OBE MP","web_url":"https://www.gov.uk/government/people/steve-reed","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--289","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--289","base_path":"/government/ministers/parliamentary-under-secretary-of-state--289","content_id":"a7b372be-2476-4a22-a87c-aca0513831a2","details":{"body":"<ul>\n  <li>Building safety, regulations, Building Safety Regulator and remediation </li>\n  <li>Net Zero and energy efficiency </li>\n  <li>Grenfell Inquiry response </li>\n  <li>Grenfell Community, Tower and Memorial </li>\n  <li>Fire policy and operations </li>\n  <li>Resilience, recovery, and emergencies </li>\n  <li>Elections policy  </li>\n  <li>Planning casework </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:40:54Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Building Safety, Fire and Democracy)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--289","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/regulation","api_url":"https://www.gov.uk/api/content/housing-local-and-community/regulation","base_path":"/housing-local-and-community/regulation","content_id":"45a38712-a3d6-42a7-a3ef-70c37665f429","details":{"internal_name":"Housing regulation [T] (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/housing-and-communities","api_url":"https://www.gov.uk/api/content/housing-local-and-community/housing-and-communities","base_path":"/housing-local-and-community/housing-and-communities","content_id":"4ad66168-274d-4d83-9195-f4ab0ccc97cb","description":"","details":{"internal_name":"Housing and communities (level 2)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"loca