, <span class=\"gem-c-attachment__attribute\">204 KB</span>, <span class=\"gem-c-attachment__attribute\">5 pages</span></p>\n\n\n\n\n      <p class=\"gem-c-attachment__metadata\">This file may not be suitable for users of assistive technology.</p>\n      <details data-module=\"ga4-event-tracker\" data-ga4-event=\"{&quot;event_name&quot;:&quot;select_content&quot;,&quot;type&quot;:&quot;detail&quot;,&quot;text&quot;:&quot;Request an accessible format.&quot;,&quot;section&quot;:&quot;Request an accessible format.&quot;,&quot;index_section&quot;:1}\" class=\"gem-c-details govuk-details govuk-!-margin-bottom-0\" title=\"Request an accessible format.\">\n  <summary class=\"govuk-details__summary\">\n    <span class=\"govuk-details__summary-text\"  data-ga4-expandable>\n      Request an accessible format.\n    </span>\n</summary>  <div class=\"govuk-details__text\">\n    \n        If you use assistive technology (such as a screen reader) and need a version of this document in a more accessible format, please email <a href='mailto:alternativeformats@communities.gov.uk' target='_blank' class='govuk-link'>alternativeformats@communities.gov.uk</a>. Please tell us what format you need. It will help us if you say what assistive technology you use.\n\n  </div>\n</details></div></section>"],"emphasised_organisations":["1390d07f-12b3-4f55-9dd5-fec5fd9e3649"],"featured_attachments":["9087229"],"first_public_at":"2026-01-22T13:58:47.000+00:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotland"},"wales":{"alternative_url":"","applicable":false,"label":"Wales"}},"political":true,"tags":{"browse_pages":[]}},"document_type":"correspondence","first_published_at":"2026-01-22T13:58:47+00:00","links":{"available_translations":[{"api_path":"/api/content/government/publications/local-government-reorganisation-lett