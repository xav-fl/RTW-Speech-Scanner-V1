ing strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence-and-armed-forces/veterans-family-support","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces/veterans-family-support","base_path":"/defence-and-armed-forces/veterans-family-support","content_id":"1f21cce7-fc86-433c-a79b-1a4f0acb5a3a","description":"","details":{"internal_name":"Veterans and family support [T] (level 2, defence theme)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2024-0