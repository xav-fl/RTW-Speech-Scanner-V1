ype":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"Military recruitment, training and operations","web_url":"https://www.gov.uk/defence/military-recruitment-training-operations","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-16T00:00:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-01-16T00:01:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":1,"schema_name":"news_article","title":"£279 million investment to build new home for Army’s cyber regiment","updated_at":"2026-08-25T10:12:36+01:00","withdrawn_notice":{}}