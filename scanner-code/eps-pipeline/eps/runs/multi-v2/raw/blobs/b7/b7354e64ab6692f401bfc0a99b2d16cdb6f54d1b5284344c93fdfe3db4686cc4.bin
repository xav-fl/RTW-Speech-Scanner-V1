d":"department-for-transport","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/654bbccfe2e16a000d42abe1/s960_dft-gmh-960.jpg","url":"https://assets.publishing.service.gov.uk/media/654bbccfe70413000dfc4a51/s300_dft-gmh-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Transport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-transport","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-transport","base_path":"/government/ministers/secretary-of-state-for-transport","content_id":"845e6453-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Department for Transport business, including: </p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio and oversight of the ministerial team </li>\n  <li>delivering the transport priorities of the government: making transport cheaper, greener, and more reliable </li>\n  <li>ensuring the transport network is safe and accessible </li>\n  <li>corporate functions such as oversight of departmental finance and public appointments</li>\n</ul>\n\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-11T12:46:45Z","schema_name":"role","title":"Secretary of State for Transport","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-transport","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/house-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/house-building","base_path":"/housing-local-and-community/house-building","content_id":"3b35111d-dedf-47d7-af44-5125a0d9bfd3","details":{"internal_name":"House building [P] (level 3, housing theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/planning-and-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/planning-and-building","base_path":"/housing-local-and-community/planning-and-building","content_id":"e3147d4f-4bd5-4a14-a386-4ba7ccb058b4","details":{"internal_name":"Planning and building (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","li