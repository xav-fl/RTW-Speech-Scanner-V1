gle-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false},{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/louise-sandher-jones","api_url":"https://www.gov.uk/api/content/government/people/louise-sandher-jones","base_path":"/government/people/louise-sandher-jones","content_id":"1ac2a507-21a5-477c-a012-c12ea4a38b66","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-14T13:54:32Z","schema_name":"person","title":"Louise Sandher-Jones MP","web_url":"https://www.gov.uk/government/people/louise-sandher-jones","withdrawn":false},{"api_path":"/api/content/government/people/yvette-cooper","api_url":"https://www.gov.uk/api/content/government/people/yvette-cooper","base_path":"/government/people/yvette-cooper","content_id":"e3145327-542d-43d8-9c4e-f6908f265478","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T19:08:19Z","schema_name":"person","title":"The Rt Hon Yvette Cooper MP","web_url":"https://www.gov.uk/government/people/yvette-cooper","withdrawn":false},{"api_path":"/api/content/government/people/keir-starmer","api_url":"https://www.gov.uk/api/content/government/people/keir-starmer","base_path":"/government/people/keir-starmer","content_id":"86d507f5-c34e-466b-b622-4d4585b75916","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T10:49:41Z","schema_name":"person","title":"The Rt Hon Sir Keir Starmer KCB KC MP","web_url":"https://www.gov.uk/government/people/keir-starmer","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--245","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--245","base_path":"/government/ministers/parliamentary-under-secretary-of-state--245","content_id":"4f2c5528-8485-4290-9394-8d57cc648c00","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of Military Strategic Headquarters (MSHQ)</li>\n  <li>Global Operations and commitments</li>\n  <li>Force Posture and Deployment</li>\n  <li>Homeland Defence and the National Conversation</li>\n  <li>Ukraine support – operations</li>\n  <li>Implementation and delivery of the Uncrewed Systems Centre and Uncrewed Systems Force</li>\n  <li>Intelligence</li>\n  <li>North Atlantic Treaty Organisation (NATO) operations and planning</li>\n  <li>Permanent Joint Operational Bases and Overseas Territories</li>\n  <li>Crisis response</li>\n  <li>Military Aid to Civilian Authority (MACA)</li>\n  <li>Armed Forces Bill</li>\n  <li>UN Peacekeeping and Human Security Call Out Orders</li>\n  <li>Overseas Security and Justice Assistance Reports</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:29:43Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for the Armed Forces)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--245","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-for-the-civil-service","api_url":"https://www.gov.uk/api/content/government/ministers/minister-for-the-civil-service","base_path":"/government/ministers/minister-for-the-civil-service","content_id":"846a7351-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Minister for the Civil Service is responsible for regulating the <a rel=\"external\" href=\"http://www.civilservice.gov.uk/\">Civil Service</a>.</p>\n\n<p>The <a rel=\"external\" href=\"http://www.legislation.gov.uk/ukpga/1992/61/contents\">Civil Service (Management Functions) Act of 1992</a>, allows the Minister for the Civil Service to delegate power to other ministers and devolved administrations.</p>\n\n<p>This role was created in 1968 and is always held by the <a href=\"https://www.gov.uk/government/ministers/prime-minister\">Prime Minister</a>.</p>\n","role_payment_type":null,"seniority":3,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-09-28T11:40:15Z","schema_name":"role","title":"Minister for the Civil Service","web_url":"https://www.gov.uk/government/ministers/minister-for-the-civil-service","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/humanitarian-emergencies","api_url":"https://www.gov.uk/api/content/international/humanitarian-emergencies","base_path":"/international/humanitarian-emergencies","content_id":"4a12dac1-5ac1-4cec-9219-aea8bb2840e6","details":{"internal_name":"Humanitarian emergencies [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international/international-aid-and-development","api_url":"https://www.gov.uk/api/content/international/international-aid-and-development","base_path":"/international/international-aid-and-development","content_id":"9fb30a53-70fb-4f1c-878b-0064b202d1ba","details":{"internal_name":"International aid and development [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8835-b3b51ae1c8b2","description":"","details":{"internal_name":"International","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.gov.uk/international","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:14:19Z","schema_name":"taxon","title":"International aid and development","web_url":"https://www.gov.uk/international/international-aid-and-development","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:14:19Z","schema_name":"taxon","title":"Humanitarian emergencies","web_url":"https://www.gov.uk/international/humanitarian-emergencies","withdrawn":false}],"world_locations":[{"analytics_identifier":"WL159","content_id":"5e9f28b7-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{},"locale":"en","public_updated_at":"2017-08-15T14:42:02Z","schema_name":"world_location","title":"Venezuela","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-30T18:35:51+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782977170.730-10.13.21.164-90003","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK deploys search and rescue team and emergency funding to support Venezuela earthquake response","updated_at":"2026-08-26T03:04:27+01:00","withdrawn_notice":{}}