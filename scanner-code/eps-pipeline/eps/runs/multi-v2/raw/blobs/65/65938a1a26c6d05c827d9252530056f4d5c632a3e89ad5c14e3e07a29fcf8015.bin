eb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false},{"analytics_identifier":"OT532","api_path":"/api/content/government/organisations/prime-ministers-office-10-downing-street","api_url":"https://www.gov.uk/api/content/government/organisations/prime-ministers-office-10-downing-street","base_path":"/government/organisations/prime-ministers-office-10-downing-street","content_id":"705dbea4-8bd7-422e-ba9c-254557f77f81","details":{"acronym":"Number 10","brand":"prime-ministers-office-10-downing-street","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37daeaed915d5a5f96602b/s960_number10.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dae940f0b649cceb1841/s300_number10.jpg"},"logo":{"crest":"eo","formatted_title":"Prime Minister&#39;s Office <br/>10 Downing Street"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Prime Minister's Office, 10 Downing Street","web_url":"https://www.gov.uk/government/organisations/prime-ministers-office-10-downing-street","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/steve-reed","api_url":"https://www.gov.uk/api/content/government/people/steve-reed","base_path":"/government/people/steve-reed","content_id":"bd2495e5-5e20-4814-9dab-bf88e5c706d0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T14:04:12Z","schema_name":"person","title":"The Rt Hon Steve Reed OBE MP","web_url":"https://www.gov.uk/government/people/steve-reed","withdrawn":false},{"api_path":"/api/content/government/people/keir-starmer","api_url":"https://www.gov.uk/api/content/government/people/keir-starmer","base_path":"/government/people/keir-starmer","content_id":"86d507f5-c34e-466b-b622-4d4585b75916","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T10:49:41Z","schema_name":"person","title":"The Rt Hon Sir Keir Starmer KCB KC MP","web_url":"https://www.gov.uk/government/people/keir-starmer","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-for-the-civil-service","api_url":"https://www.gov.uk/api/content/government/ministers/minister-for-the-civil-service","base_path":"/government/ministers/minister-for-the-civil-service","content_id":"846a7351-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Minister for the Civil Service is responsible for regulating the <a rel=\"external\" href=\"http://www.civilservice.gov.uk/\">Civil Service</a>.</p>\n\n<p>The <a rel=\"external\" href=\"http://www.legislation.gov.uk/ukpga/1992/61/contents\">Civil Service (Management Functions) Act of 1992</a>, allows the Minister for the Civil Service to delegate power to other ministers and devolved administrations.</p>\n\n<p>This role was created in 1968 and is always held by the <a href=\"https://www.gov.uk/government/ministers/prime-minister\">Prime Minister</a>.</p>\n","role_payment_type":null,"seniority":3,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-09-28T11:40:15Z","schema_name":"role","title":"Minister for the Civil Service","web_url":"https://www.gov.uk/government/ministers/minister-for-the-civil-service","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-04T22:31:04+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-02-04T22:31:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":5,"schema_name":"news_article","title":"Pride in Place: 40 neighbourhoods join transformational programme","updated_at":"2026-08-14T15:46:20+01:00","withdrawn_notice":{}}