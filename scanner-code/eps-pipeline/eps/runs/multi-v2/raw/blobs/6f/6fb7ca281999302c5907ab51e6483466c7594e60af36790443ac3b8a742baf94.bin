:"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/health-safety-and-wellbeing-in-schools","api_url":"https://www.gov.uk/api/content/education/health-safety-and-wellbeing-in-schools","base_path":"/education/health-safety-and-wellbeing-in-schools","content_id":"394b93e1-eeb7-421d-91e1-c478cc3d635e","description":"Automated external defibrillators (AEDs). Advice for schools, illness and medical conditions, emergency planning, first aid, security.","details":{"internal_name":"Health, safety and wellbeing in schools","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/pupil-wellbeing-behaviour-and-attendance","api_url":"https://www.gov.uk/api/content/education/pupil-wellbeing-behaviour-and-attendance","base_path":"/education/pupil-wellbeing-behaviour-and-attendance","content_id":"db605204-0f03-441b-837f-16613c6b3f8f","description":"Safeguarding pupils. First aid, bullying, exclusions, alternative provision and pupil referral units.","details":{"internal_name":"Pupil wellbeing, behaviour and attendance","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-01-30T15:41:47Z","schema_name":"taxon","title":"Pupil wellbeing, behaviour and attendance","web_url":"https://www.gov.uk/education/pupil-wellbeing-behaviour-and-attendance","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T12:32:34Z","schema_name":"taxon","title":"Health, safety and wellbeing in schools","web_url":"https://www.gov.uk/education/health-safety-and-wellbeing-in-schools","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-10T10:30:02+01:00","publishing_app":"whitehall","publishing_request_id":"21-1781082023.285-10.13.20.248-2559","publishing_scheduled_at":"2026-06-10T10:30:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Record numbers of children with mental health support in schools","