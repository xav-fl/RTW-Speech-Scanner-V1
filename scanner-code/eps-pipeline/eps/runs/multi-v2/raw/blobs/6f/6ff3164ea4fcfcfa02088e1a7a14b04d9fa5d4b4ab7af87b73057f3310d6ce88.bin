rtment of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false},{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/preet-kaur-gill","api_url":"https://www.gov.uk/api/content/government/people/preet-kaur-gill","base_path":"/government/people/preet-kaur-gill","content_id":"621bcc52-4a95-4e80-a539-477c4c34d158","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:10:19Z","schema_name":"person","title":"Preet Kaur Gill MP","web_url":"https://www.gov.uk/government/people/preet-kaur-gill","withdrawn":false},{"api_path":"/api/content/government/people/georgia-gould","api_url":"https://www.gov.uk/api/content/government/people/georgia-gould","base_path":"/government/people/georgia-gould","content_id":"d01cd743-767b-4057-8eba-3949fb11ff6a","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T12:24:29Z","schema_name":"person","title":"Georgia Gould OBE MP","web_url":"https://www.gov.uk/government/people/georgia-gould","withdrawn":false},{"api_path":"/api/content/government/people/bridget-phillipson","api_url":"https://www.gov.uk/api/content/government/people/bridget-phillipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--310","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--310","base_path":"/government/ministers/parliamentary-under-secretary-of-state--310","content_id":"07b9324d-8b16-4c41-8736-301efb43afdc","details":{"body":"<p>The Parliamentary Under-Secretary of State for Health Innovation and Safety is responsible for:</p>\n\n<ul>\n  <li>NHS data and technology</li>\n  <li>medicines</li>\n  <li>life sciences</li>\n  <li>medtech (medical technology)</li>\n  <li>research and innovation</li>\n  <li>international and trade</li>\n  <li>patient safety, including blood and transplant</li>\n  <li>disabilities and SEND (special educational needs and disabilities)</li>\n  <li>rare diseases</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-06-05T11:13:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Health Innovation and Safety","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--310","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--187","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--187","base_path":"/government/ministers/minister-of-state--187","content_id":"7afdbe17-ea80-463a-b7cd-4fa34db9c326","details":{"body":"<p>The minister’s responsibilities include:</p>\n\n<ul>\n  <li>school improvement, intervention and inspection (including links with <a href=\"https://www.gov.uk/government/organisations/ofsted\">Ofsted</a>)</li>\n  <li>regional improvement for standards and excellence (RISE)</li>\n  <li>special educational needs and disabilities (SEND) and high needs</li>\n  <li>alternative provision</li>\n  <li>special schools (including independent special schools (ISS))</li>\n  <li>initial teacher training and incentives</li>\n  <li>teacher retention including the early career framework and teacher training entitlement</li>\n  <li>\n<a href=\"https://www.gov.uk/government/organisations/teaching-regulation-agency\">Teaching Regulation Agency</a> (TRA)</li>\n  <li>school leadership</li>\n  <li>school governance</li>\n  <li>teacher pay and pensions</li>\n  <li>school support staff</li>\n  <li>core school funding</li>\n  <li>pupil premium</li>\n  <li>school productivity</li>\n  <li>qualifications (including links with <a href=\"https://www.gov.uk/government/organisations/ofqual\">Ofqual</a>)</li>\n  <li>national curriculum</li>\n  <li>access to sport, arts and music in education, working with other departments</li>\n  <li>admissions and pupil movement</li>\n  <li>relationships and sex education and health education (RSHE) review</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:16:09Z","schema_name":"role","title":"Minister of State (Minister for School Standards)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--187","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/special-educational-needs-and-disability-send-and-high-needs","api_url":"https://www.gov.uk/api/content/education/special-educational-needs-and-disability-send-and-high-needs","base_path":"/education/special-educational-needs-and-disability-send-and-high-needs","content_id":"47b6ce42-0bfa-42ee-9ff1-7a9c71ee9727","description":"Support and funding, SEND code of practice, extra SEND help, P scales for attainment targets, free school transport.","details":{"internal_name":"Special educational needs and disability (SEND) and high needs","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T13:04:22Z","schema_name":"taxon","title":"Special educational needs and disability (SEND) and high needs","web_url":"https://www.gov.uk/education/special-educational-needs-and-disability-send-and-high-needs","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-17T17:12:49+01:00","publishing_app":"whitehall","publishing_request_id":"21-1781712769.098-10.13.21.18-2421","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_articl