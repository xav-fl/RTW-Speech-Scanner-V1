ervice.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D1381","api_path":"/api/content/government/organisations/department-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-science-innovation-and-technology","base_path":"/government/organisations/department-for-science-innovation-and-technology","content_id":"c352c234-8083-47ec-8a4b-0edd45c31263","details":{"acronym":"DSIT","brand":"department-for-science-innovation-technology","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/68a86caf969253904d1557b7/s960_DSIT_GovUK.png","url":"https://assets.publishing.service.gov.uk/media/68a86caf960e2d135b4c8da5/s300_DSIT_GovUK.png"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Science, Innovation<br/>&amp; Technology"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/organisations/department-for-science-innovation-and-technology","withdrawn":false},{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/ian-murray","api_url":"https://www.gov.uk/api/content/government/people/ian-murray","base_path":"/government/people/ian-murray","content_id":"90ad5c0c-4b41-4ea0-942c-44736c140778","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T09:15:35Z","schema_name":"person","title":"The Rt Hon Ian Murray MP","web_url":"https://www.gov.uk/government/people/ian-murray","withdrawn":false},{"api_path":"/api/content/government/people/matthew-pennycook","api_url":"https://www.gov.uk/api/content/government/people/matthew-pennycook","base_path":"/government/people/matthew-pennycook","content_id":"8f439fe5-f799-4fb6-a249-86fd399bb3cb","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T13:42:30Z","schema_name":"person","title":"The Rt Hon Matthew Pennycook MP","web_url":"https://www.gov.uk/government/people/matthew-pennycook","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1381","api_path":"/api/content/government/organisations/department-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-science-innovation-and-technology","base_path":"/government/organisations/department-for-science-innovation-and-technology","content_id":"c352c234-8083-47ec-8a4b-0edd45c31263","details":{"acronym":"DSIT","brand":"department-for-science-innovation-technology","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/68a86caf969253904d1557b7/s960_DSIT_GovUK.png","url":"https://assets.publishing.service.gov.uk/media/68a86caf960e2d135b4c8da5/s300_DSIT_GovUK.png"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Science, Innovation<br/>&amp; Technology"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/organisations/department-for-science-innovation-and-technology","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state-minister-for-digital-government-and-data","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state-minister-for-digital-government-and-data","base_path":"/government/ministers/minister-of-state-minister-for-digital-government-and-data","content_id":"10402295-569f-4533-b354-054939a3959a","details":{"body":"<p>The minister is responsible for:</p>\n\n<ul>\n  <li>public sector reform</li>\n  <li>digital products</li>\n  <li>data policy</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-01-12T10:29:06Z","schema_name":"role","title":"Minister of State (Minister for Digital Government and Data)","web_url":"https://www.gov.uk/government/ministers/minister-of-state-minister-for-digital-government-and-data","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--176","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--176","base_path":"/government/ministers/minister-of-state--176","content_id":"6edd9458-f4f8-4388-9fe0-c330422e47dd","details":{"body":"<p>The Minister for Housing and Planning is responsibile for:</p>\n\n<ul>\n  <li>Planning reform and the National Planning Policy Framework</li>\n  <li>Housing delivery, including large-scale new settlements programme (New Towns)</li>\n  <li>Brownfield Infrastructure Land and Housing Infrastructure Funds</li>\n  <li>Housing supply strategy</li>\n  <li>Homes England and Planning Inspectorate sponsorship</li>\n  <li>HM Land Registry and land transparency</li>\n  <li>Social housing</li>\n  <li>Social and Affordable Homes Programme </li>\n  <li>Housing quality</li>\n  <li>Private rented sector</li>\n  <li>Leasehold and commonhold reform</li>\n  <li>Planning casework</li>\n</ul>\n","role_payment_type":null,"seniority":25,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:47:20Z","schema_name":"role","title":"Minister of State (Minister for Housing and Planning)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--176","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/planning-system","api_url":"https://www.gov.uk/api/content/housing-local-and-community/planning-system","base_path":"/housing-local-and-community/planning-system","content_id":"d762d126-be4c-471d-88f3-6becd8d08e43","details":{"internal_name":"Planning system [P] (level 3, housing theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/planning-and-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/planning-and-building","base_path":"/housing-local-and-community/planning-and-building","content_id":"e3147d4f-4bd5-4a14-a386-4ba7ccb058b4","details":{"internal_name":"Planning and building (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-24T11:05:58Z","schema_name":"taxon","title":"Planning and building","web_url":"https://www.gov.