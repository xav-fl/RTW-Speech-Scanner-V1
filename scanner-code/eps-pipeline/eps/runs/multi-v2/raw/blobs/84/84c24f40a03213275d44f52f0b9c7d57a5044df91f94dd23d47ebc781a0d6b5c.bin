on_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false},{"api_path":"/api/content/government/ministers/chancellor-of-the-exchequer","api_url":"https://www.gov.uk/api/content/government/ministers/chancellor-of-the-exchequer","base_path":"/government/ministers/chancellor-of-the-exchequer","content_id":"845e5c6b-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Chancellor of the Exchequer is the government’s chief financial minister and is responsible for growing the UK economy, raising revenue through taxation or borrowing and for controlling public spending. He has overall responsibility for the work of the Treasury. </p>\n\n<p>The Chancellor’s responsibilities cover:  </p>\n\n<ul>\n  <li>\n    <p>Economic and fiscal policy (including presenting the annual Budget) </p>\n  </li>\n  <li>\n    <p>Oversight of the monetary framework, including setting the inflation remit, and liaison with the Governor of the Bank of England on monetary policy </p>\n  </li>\n  <li>\n    <p>UK growth and productivity, including working across government on innovation, new technologies, skills, labour markets, migration and competition.   </p>\n  </li>\n  <li>\n    <p>UK public financial institutions  </p>\n  </li>\n  <li>\n    <p>Capital markets and listings </p>\n  </li>\n  <li>\n    <p>Leading on international economic and financial affairs including at the G7 and G20 and acting as the UK Governor of the IMF, EBRD and AIIB.  </p>\n  </li>\n  <li>\n    <p>Economic security and resilience policy </p>\n  </li>\n  <li>\n    <p>International defence and security financing</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:12:00Z","schema_name":"role","title":"Chancellor of the Exchequer","web_url":"https://www.gov.uk/government/ministers/chancellor-of-the-exchequer","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/homebuying","api_url":"https://www.gov.uk/api/content/housing-local-and-community/homebuying","base_path":"/housing-local-and-community/homebuying","content_id":"76fec242-7040-4499-8661-dd823f88fab3","details":{"internal_name":"Homebuying [P] (level 3, housing theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/housing-and-communities","api_url":"https://www.gov.uk/api/content/housing-local-and-community/housing-and-communities","base_path":"/housing-local-and-community/housing-and-communities","content_id":"4ad66168-274d-4d83-9195-f4ab0ccc97cb","description":"","details":{"internal_name":"Housing and communities (level 2)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_