<tr>\n      <td>Hull and East Yorkshire</td>\n      <td>Solar PV – Groundmount &amp; Battery</td>\n      <td>Solar Farm</td>\n      <td>£750,000</td>\n      <td>£997,113</td>\n      <td>£45,000.00</td>\n      <td>£1,295,000.00</td>\n    </tr>\n    <tr>\n      <td>Greater Manchester</td>\n      <td>Solar PV – Rooftop</td>\n      <td>Schools (~7)</td>\n      <td>£748,947</td>\n      <td>£748,947</td>\n      <td>£115,000.00</td>\n      <td>£3,500,000.00</td>\n    </tr>\n    <tr>\n      <td>York and North Yorkshire</td>\n      <td>Solar PV</td>\n      <td>Public sector buildings (incl. Schools, Youth Centre, care centre, pavilion, maritime hub, Police and Fire HQ)</td>\n      <td>£453,732</td>\n      <td>£453,732</td>\n      <td>£35,000.00</td>\n      <td>£1,000,000.00</td>\n    </tr>\n    <tr>\n      <td>West Yorkshire</td>\n      <td>Solar PV - Rooftop &amp; Battery</td>\n      <td>Leisure and community centre buildings, crematoria and depots with public ownership</td>\n      <td>£750,000</td>\n      <td>£791,369</td>\n      <td>£35,000.00</td>\n      <td>£1,110,000.00</td>\n    </tr>\n    <tr>\n      <td>Tees Valley</td>\n      <td>Solar PV - Rooftop &amp; Battery</td>\n      <td>Public building and community assets (incl. Libraries, Assisted living centre, Youth and community hubs, Council offices)</td>\n      <td>£744,485</td>\n      <td>£744,485</td>\n      <td>£70,000.00</td>\n      <td>£2,085,000.00</td>\n    </tr>\n    <tr>\n      <td>Liverpool City Region</td>\n      <td>Solar PV – Rooftop</td>\n      <td>CA and Council owned Buildings</td>\n      <td>£750,000</td>\n      <td>£750,000</td>\n      <td>£65,000.00</td>\n      <td>£1,980,000.00</td>\n    </tr>\n    <tr>\n      <td>West Midlands</td>\n      <td>Solar PV - Rooftop &amp; EV system</td>\n      <td>Bloxwich Active Living Centre</td>\n      <td>£672,935</td>\n      <td>£749,935</td>\n      <td>£25,000.00</td>\n      <td>£785,000.00</td>\n    </tr>\n    <tr>\n      <td>East Midlands</td>\n      <td>Solar PV - Rooftop</td>\n      <td>Rushcliffe Arena</td>\n      <td>£729,188</td>\n      <td>£729,188</td>\n      <td>£60,000.00</td>\n      <td>£1,815,000.00</td>\n    </tr>\n    <tr>\n      <td>North East</td>\n      <td>Solar PV - Rooftop</td>\n      <td>Public Sector Depot</td>\n      <td>£555,000</td>\n      <td>£555,000</td>\n      <td>£60,000.00</td>\n      <td>£1,845,000.00</td>\n    </tr>\n    <tr>\n      <td>Total</td>\n      <td> </td>\n      <td> </td>\n      <td>£6,904,287</td>\n      <td>£7,307,269</td>\n      <td>£550,000</td>\n      <td>£15,000,000</td>\n    </tr>\n  </tbody>\n</table>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-02-09T22:30:02Z"}],"emphasised_organisations":["6315817c-ef11-4905-bb4d-b6dca8e9052c","04debc1f-d17b-46ad-83ee-fd3633e1579e","1390d07f-12b3-4f55-9dd5-fec5fd9e3649"],"images":[{"caption":"","content_type":"image/jpeg","sources":{"s216":"https://assets.publishing.service.gov.uk/media/698a18906da2dee8230a9c49/s216_261_36_GBE_960_post_v1.jpg","s300":"https://assets.publishing.service.gov.uk/media/698a18904cff1c70a3b6e56d/s300_261_36_GBE_960_post_v1.jpg","s465":"https://assets.publishing.service.gov.uk/media/698a1890cfe7ccf77efbc85b/s465_261_36_GBE_960_post_v1.jpg","s630":"https://assets.publishing.service.gov.uk/media/698a1890d3f57710b50a9c40/s630_261_36_GBE_960_post_v1.jpg","s712":"https://assets.publishing.service.gov.uk/media/698a18906da2dee8230a9c48/s712_261_36_GBE_960_post_v1.jpg","s960":"https://assets.publishing.service.gov.uk/media/698a1890d3f57710b50a9c42/s960_261_36_GBE_960_post_v1.jpg"},"type":"lead"}],"political":true},"document_type":"press_release","first_published_at":"2026-02-09T22:30:02+00:00","links":{"available_translations":[{"api_path":"/api/content/government/news/community-energy-investment-to-build-community-wealth-and-power","api_url":"https://www.gov.uk/api/content/government/news/community-energy-investment-to-build-community-wealth-and-power","base_path":"/government/news/