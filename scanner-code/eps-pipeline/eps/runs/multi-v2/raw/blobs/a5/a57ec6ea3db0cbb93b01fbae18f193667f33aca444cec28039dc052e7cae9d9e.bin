le":"en","public_updated_at":"2026-07-20T10:49:41Z","schema_name":"person","title":"The Rt Hon Sir Keir Starmer KCB KC MP","web_url":"https://www.gov.uk/government/people/keir-starmer","withdrawn":false},{"api_path":"/api/content/government/people/rachel-reeves","api_url":"https://www.gov.uk/api/content/government/people/rachel-reeves","base_path":"/government/people/rachel-reeves","content_id":"18ff123b-9f73-4e6d-98a2-a693ecefbc37","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:48:57Z","schema_name":"person","title":"The Rt Hon Rachel Reeves MP","web_url":"https://www.gov.uk/government/people/rachel-reeves","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D15","api_path":"/api/content/government/organisations/hm-treasury","api_url":"https://www.gov.uk/api/content/government/organisations/hm-treasury","base_path":"/government/organisations/hm-treasury","content_id":"1994e0e4-bd19-4966-bbd7-f293d6e90a6b","details":{"acronym":"HMT","brand":"hm-treasury","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a7908e352b4/s960_HMT_buiding_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db09e5274a79051c9235/s300_HMT_buiding_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"HM Treasury"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Treasury","web_url":"https://www.gov.uk/government/organisations/hm-treasury","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-transport","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-transport","base_path":"/government/ministers/secretary-of-state-for-transport","content_id":"845e6453-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for all Department for Transport business, including: </p>\n\n<ul>\n  <li>overarching responsibility for the departmental portfolio and oversight of the ministerial team </li>\n  <li>delivering the transport priorities of the government: making transport cheaper, greener, and more reliable </li>\n  <li>ensuring the transport network is safe and accessible </li>\n  <li>corporate functions such as oversight of departmental finance and public appointments</li>\n</ul>\n\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-11T12:46:45Z","schema_name":"role","title":"Secretary of State for Transport","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-transport","withdrawn":false},{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false},{"api_path":"/api/content/government/ministers/chancellor-of-the-exchequer","api_url":"https://www.gov.uk/api/content/government/ministers/chancellor-of-the-exchequer","base_path":"/government/ministers/chancellor-of-the-exchequer","content_id":"845e5c6b-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Chancellor of the Exchequer is the government’s chief financial minister and is responsible for growing the UK economy, raising revenue through taxation or borrowing and for controlling public spending. He has overall responsibility for the work of the Treasury. </p>\n\n<p>The Chancellor’s responsibilities cover:  </p>\n\n<ul>\n  <li>\n    <p>Economic and fiscal policy (including presenting the annual Budget) </p>\n  </li>\n  <li>\n    <p>Oversight of the monetary framework, including setting the inflation remit, and liaison with the Governor of the Bank of England on monetary policy </p>\n  </li>\n  <li>\n    <p>UK growth and productivity, including working across government on innovation, new technologies, skills, labour markets, migration and competition.   </p>\n  </li>\n  <li>\n    <p>UK public financial institutions  </p>\n  </li>\n  <li>\n    <p>Capital markets and listings </p>\n  </li>\n  <li>\n    <p>Leading on international economic and financial affairs including at the G7 and G20 and acting as the UK Governor of the IMF, EBRD and AIIB.  </p>\n  </li>\n  <li>\n    <p>Economic security and resilience policy </p>\n  </li>\n  <li>\n    <p>International defence and security financing</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:12:00Z","schema_name":"role","title":"Chancellor of the Exchequer","web_url":"https://www.gov.uk/government/ministers/chancellor-of-the-exchequer","withdrawn":false}],"taxons":[{"api_path":"/api/content/transport/rail","api_url":"https://www.gov.uk/api/content/transport/rail","base_path":"/transport/rail","content_id":"13d01427-33b5-4ca4-bf7a-68425f54e236","description":"Rail network, franchising, procurement, trains and stations, passenger experience, ticketing and fares, safety and security, accessibility, Crossrail and interoperability.","details":{"internal_name":"Rail","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/transport","api_url":"https://www.gov.uk/api/content/transport","base_path":"/transport","content_id":"a4038b29-b332-4f13-98b1-1c9709e216bc","description":"Aviation, roads, rail, maritime, driving, freight, public transport, safety, environment and transport accessibility.","details":{"internal_name":"Transport","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-15T14:31:46Z","schema_name":"taxon","title":"Transport","web_url":"https://www.gov.uk/transport","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-14T09:27:11Z","schema_name":"taxon","title":"Rail","web_url":"https://www.gov.uk/transport/rail","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-14T12:53:34+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Northern Powerhouse Rail to drive biggest travel upgrade in the North in a generation","updated_at":"2026-08-14T18:13:07+01:00","withdrawn_notice":{}}