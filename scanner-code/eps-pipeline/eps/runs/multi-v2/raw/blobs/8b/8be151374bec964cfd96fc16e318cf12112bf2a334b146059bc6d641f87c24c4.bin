{"analytics_identifier":null,"base_path":"/government/publications/dfe-update-24-june-2026","content_id":"fb30871d-433b-4b1c-a08c-57eb668f1393","description":"Latest information and actions from the Department for Education about funding, assurance and resource management, for academies, local authorities and further education providers.","details":{"attachments":[{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248188","isbn":"","title":"DfE Update further education: 24 June 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-24-june-2026/dfe-update-further-education-24-june-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248189","isbn":"","title":"DfE Update academies: 24 June 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-24-june-2026/dfe-update-academies-24-june-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248190","isbn":"","title":"DfE Update local authorities: 24 June 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-24-june-2026/dfe-update-local-authorities-24-june-2026"}],"body":"<div class=\"govspeak\"><h2 id=\"latest-for-further-education\">Latest for further education</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>College financial data service portal now available</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Register for Taking Teaching Further 2026 by Monday 6 July 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Submit Care to Learn and 16 to 19 Bursary Fund for defined vulnerable groups funding claims</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Adult funding allocations for 2025 to 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Year-end forecast funding claim for funding year 2025 to 2026 – indicative reconciliation statement(s)</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Updated subcontracting funding rules for post-16 education and training 2026 to 2027 guidance</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>16 to 19 education (non-apprenticeship) market entry guidance</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help us improve the 16 to 19 business case process</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of our funding service</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-academies\">Latest for academies</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Submit Care to Learn and 16 to 19 Bursary Fund for defined vulnerable groups funding claims</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Post-16 school census interactive tool</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Pupil premium allocations for 2026 to 2027 financial year – confirmed allocations</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free training opportunities for school business professionals</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of our funding service</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help us improve the 16 to 19 business case process</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-local-authorities\">Latest for local authorities</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbo