li>\n  <li>Elections policy  </li>\n  <li>Planning casework </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:40:54Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Building Safety, Fire and Democracy)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--289","withdrawn":false}],"speaker":[{"api_path":"/api/content/government/people/samantha-dixon","api_url":"https://www.gov.uk/api/content/government/people/samantha-dixon","base_path":"/government/people/samantha-dixon","content_id":"2f60a86b-1ccd-49e7-b991-5517e4c9bbe3","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:17:59Z","schema_name":"person","title":"Samantha Dixon MBE MP","web_url":"https://www.gov.uk/government/people/samantha-dixon","withdrawn":false}],"taxons":[{"api_path":"/api/content/government/fire-prevention-and-rescue","api_url":"https://www.gov.uk/api/content/government/fire-prevention-and-rescue","base_path":"/government/fire-prevention-and-rescue","content_id":"1c17540f-f4a3-435b-a5b2-5c36e4200be8","details":{"internal_name":"Fire prevention and rescue [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/emergency-preparation-reponse-and-recovery","api_url":"https://www.gov.uk/api/content/government/emergency-preparation-reponse-and-recovery","base_path":"/government/emergency-preparation-reponse-and-recovery","content_id":"78c2148c-a7cd-448b-8105-9f78ded119d1","details":{"internal_name":"Emergency preparation, response and recovery (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/government/all","content_id":"e48ab80a-de80-4e83-bf59-26316856a5f9","description":"","details":{"internal_name":"Government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:29:39Z","schema_name":"taxon","title":"Government","web_url":"https://www.gov.uk/government/all","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-17T15:32:42Z","schema_name":"taxon","title":"Emergency preparation, response and recovery","web_url":"https://www.gov.uk/government/emergency-preparation-reponse-and-recovery","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-17T15:32:42Z","schema_name":"taxon","title":"Fire prevention and rescue","web_url":"https://www.gov.uk/government/fire-prevention-and-rescue","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-09T11:08:56+01:00","publishing_app":"whitehall","publishing_request_id":"21-1780999736.559-10.13.20.64-2311","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"speech","title":"Fire Safety Minister's speech at the FBU's 2026 Conference","updated_at":"2026-07-30T11:41:10+01:00","withdrawn_notice":{}}