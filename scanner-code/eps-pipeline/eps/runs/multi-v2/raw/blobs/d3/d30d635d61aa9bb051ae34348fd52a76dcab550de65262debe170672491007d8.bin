https://www.gov.uk/government/organisations/the-security-service-mi5","withdrawn":false},{"analytics_identifier":"OT1211","api_path":"/api/content/government/organisations/national-cyber-security-centre","api_url":"https://www.gov.uk/api/content/government/organisations/national-cyber-security-centre","base_path":"/government/organisations/national-cyber-security-centre","content_id":"268e0f61-a32c-4cfb-8c89-96a504919b35","details":{"acronym":"NCSC","brand":"foreign-commonwealth-office","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"NCSC"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"https://www.ncsc.gov.uk/"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"National Cyber Security Centre","web_url":"https://www.gov.uk/government/organisations/national-cyber-security-centre","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/dan-jarvis","api_url":"https://www.gov.uk/api/content/government/people/dan-jarvis","base_path":"/government/people/dan-jarvis","content_id":"72b7af32-c0a5-4038-a8e8-e582463dc05a","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-24T15:12:11Z","schema_name":"person","title":"The Rt Hon Dan Jarvis MBE MP","web_url":"https://www.gov.uk/government/people/dan-jarvis","withdrawn":false},{"api_path":"/api/content/government/people/jacqui-smith","api_url":"https://www.gov.uk/api/content/government/people/jacqui-smith","base_path":"/government/people/jacqui-smith","content_id":"8d7c6906-f1dd-4a7d-ba70-ecd1a08aefe6","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T12:37:23Z","schema_name":"person","title":"The Rt Hon Baroness Smith of Malvern","web_url":"https://www.gov.uk/government/people/jacqui-smith","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--174","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--174","base_path":"/government/ministers/minister-of-state--174","content_id":"b6023b8d-21a1-4d97-9242-9b7244cb0a15","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>counter terrorism and extremism  </li>\n  <li>state threats </li>\n  <li>cyber security and crime </li>\n  <li>serious and organised crime </li>\n  <li>oversight of the National Crime Agency </li>\n  <li>international criminality </li>\n  <li>aviation and maritime security </li>\n  <li>economic crime (excluding fraud) </li>\n  <li>extradition </li>\n  <li>exclusions and deprivations </li>\n  <li>MP security and VIP protection </li>\n  <li>online safety </li>\n  <li>anti-corruption</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-31T14:12:52Z","schema_name":"role","title":"Minister of State (Minister for Security)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--174","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--175","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--175","base_path":"/government/ministers/minister-of-state--175","content_id":"5dc89f34-86e1-4173-9980-0a525d4ef2f3","details":{"body":"<p>The minister’s Department for Education (DfE) responsibilities include:</p>\n\n<ul>\n  <li>governance, intervention and accountability of further education colleges</li>\n  <li>funding for education and training, provision and outcomes for 16- to 19-year-olds</li>\n  <li>further education financial stability and workforce</li>\n  <li>access to higher education, participation and lifelong learning entitlement</li>\n  <li>quality of higher education and the student experience (including the <a rel=\"external\" href=\"https://www.officeforstudents.org.uk/\">Office for Students</a>)</li>\n  <li>student finance (including the <a href=\"https://www.gov.uk/government/organisations/student-loans-company\">Student Loans Company</a>)</li>\n  <li>technical and vocational qualifications (level 3 and below), including T Levels</li>\n  <li>higher technical education (levels 4 and 5)</li>\n  <li>careers advice</li>\n  <li>support for young people aged 16 to 19 not in employment, education or training (NEET)</li>\n  <li>skills strategy and delivery</li>\n  <li>technical excellence colleges</li>\n  <li>international education</li>\n</ul>\n\n<p>The minister’s Department for Work and Pensions (DWP) responsibilities include:</p>\n\n<ul>\n  <li>\n<a href=\"https://www.gov.uk/government/organisations/skills-england\">Skills England</a> and Industry Training Boards</li>\n  <li>adult education, including basic skills</li>\n  <li>apprenticeships, including the growth and skills levy</li>\n  <li>skills bootcamps</li>\n  <li>sector skills packages</li>\n  <li>careers advice and support for young people over the age of 19 not in employment, education or training (NEET)</li>\n  <li>Youth Guarantee</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:15:41Z","schema_name":"role","title":"Minister of State (Minister for Skills)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--175","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/further-and-higher-education-courses-and-qualifications","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-courses-and-qualifications","base_path":"/education/further-and-higher-education-courses-and-qualifications","content_id":"58bebb74-fae7-4c97-878b-61ff543d9d12","description":"Functional skills, essential digital skills, qualifications eligible for funding, what qualification levels mean and checking a university is recognised. ","details":{"internal_name":"Further and higher education courses and qualifications","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3