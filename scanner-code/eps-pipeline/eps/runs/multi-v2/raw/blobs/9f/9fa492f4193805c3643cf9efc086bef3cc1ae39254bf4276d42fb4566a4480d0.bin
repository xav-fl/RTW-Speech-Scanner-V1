-bce0cda31bde","details":{"internal_name":"Local government (merged, Level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:38Z","schema_name":"taxon","title":"Local government","web_url":"https://www.gov.uk/regional-and-local-government/local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:38Z","schema_name":"taxon","title":"Local government pensions","web_url":"https://www.gov.uk/regional-and-local-government/pensions","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-02T17:32:35+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Pension scheme reforms to tackle gender pension gap","updated_at":"2026-08-14T18:31:16+01:00