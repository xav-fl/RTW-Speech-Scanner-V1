i>Office for Veterans Affairs (including veterans policy, delivery and VALOUR)</li>\n  <li>Armed Forces Covenant</li>\n  <li>Armed Forces People</li>\n  <li>Armed Forces Families</li>\n  <li>Housing (including Defence Housing Service)</li>\n  <li>Civilian workforce (including Royal Fleet Auxillary)</li>\n  <li>Defence Business Services (including legal, pensions and compensation)</li>\n  <li>Defence culture – including oversight of the Raising our Standards Programme and Equality, Diversity and Inclusion</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/working-armed-forces","api_url":"https://www.gov.uk/api/content/defence/working-armed-forces","base_path":"/defence/working-armed-forces","content_id":"8ff8cf05-a6e6-4757-a896-4fabd9f3229a","details":{"internal_name":"Armed forces [M] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base