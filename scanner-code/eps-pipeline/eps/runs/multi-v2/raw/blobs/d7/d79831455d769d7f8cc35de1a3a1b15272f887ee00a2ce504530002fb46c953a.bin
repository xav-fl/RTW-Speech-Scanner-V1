on Steve Reed OBE MP","web_url":"https://www.gov.uk/government/people/steve-reed","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--201","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--201","base_path":"/government/ministers/minister-of-state--201","content_id":"e4f33898-53fd-4329-94a7-796ae424ba5b","details":{"body":"<ul>\n  <li>Local government finance (including local taxation, business rates and local government pensions) </li>\n  <li>Local government policy (including stewardship, local audit, and governance reform) </li>\n  <li>Local government reorganisation </li>\n  <li>Homelessness and rough sleeping </li>\n  <li>Supported housing and domestic abuse </li>\n  <li>Resettlement </li>\n  <li>Planning casework</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:36:24Z","schema_name":"role","title":"Minister of State (Minister for Local Government and Homelessness)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--201","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/local-government-council-tax","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government-council-tax","base_path":"/regional-and-local-government/local-government-council-tax","content_id":"107b4fd7-fef4-4a86-9796-2967c95f3f3c","details":{"internal_name":"Council Tax [T]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government/local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government/local-government","base_path":"/regional-and-local-government/local-government","content_id":"c914fd40-dd0a-45c4-a6ff-bce0cda31bde","details":{"internal_name":"Local government (merged, Level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:38Z","schema_name":"taxon","title":"Local government","web_url":"https://www.gov.uk/regional-and-local-government/local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:39Z","schema_name":"taxon","title":"Council Tax","web_url":"https://www.gov.uk/regional-and-local-government/local-government-council-tax","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-15T10:45:14+01:00","publishing_app":"whitehall","publishing_request_id":"21-1776246814.706-10.13.22.123-101250","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Council tax shake-up to protect the most vulnerable households","updated_at":"2026-08-14T15:46:21+01:00","withdrawn_notice":{}}