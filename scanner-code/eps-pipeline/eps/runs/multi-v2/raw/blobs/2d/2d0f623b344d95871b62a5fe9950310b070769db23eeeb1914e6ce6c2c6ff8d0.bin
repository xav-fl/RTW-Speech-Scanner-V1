ns/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--285","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--285","base_path":"/government/ministers/parliamentary-under-secretary-of-state--285","content_id":"b3eb7af0-4a93-4c6a-b943-e312093516e9","details":{"body":"<ul>\n  <li>English devolution </li>\n  <li>Mayoral Combined Authorities and pan-regional bodies </li>\n  <li>Local and regional growth and investment</li>\n  <li>Investment zones and freeports </li>\n  <li>High streets and towns  </li>\n  <li>Communities and social cohesion</li>\n  <li>Faith</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:39:09Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Devolution, Faith and Communities)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--285","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--276","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--276","base_path":"/government/ministers/parliamentary-under-secretary-of-state--276","content_id":"52252e20-7cdf-46d2-af00-f32d9dfac8ad","details":{"body":"<ul>\n  <li>\n    <p>Middle East and North Africa</p>\n  </li>\n  <li>\n    <p>Afghanistan and Pakistan</p>\n  </li>\n  <li>\n    <p>consular and crisis</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","p