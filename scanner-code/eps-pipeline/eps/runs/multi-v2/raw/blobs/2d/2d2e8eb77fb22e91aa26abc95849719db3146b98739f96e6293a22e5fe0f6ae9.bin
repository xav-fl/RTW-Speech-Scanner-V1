f-justice","withdrawn":false},{"analytics_identifier":"D16","api_path":"/api/content/government/organisations/home-office","api_url":"https://www.gov.uk/api/content/government/organisations/home-office","base_path":"/government/organisations/home-office","content_id":"06056197-bc69-4147-aa28-070bca132178","details":{"acronym":"Home Office","brand":"home-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/669fa7f5ce1fd0da7b592afc/s960_2MS_Home_Office_sign_-_landscape.jpg","url":"https://assets.publishing.service.gov.uk/media/669fa7f5ab418ab055592b21/s300_2MS_Home_Office_sign_-_landscape.jpg"},"logo":{"crest":"ho","formatted_title":"Home Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/jake-richards","api_url":"https://www.gov.uk/api/content/government/people/jake-richards","base_path":"/government/people/jake-richards","content_id":"a430c5f7-3299-497b-8d23-33a3ab9231e2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T11:44:01Z","schema_name":"person","title":"Jake Richards MP","web_url":"https://www.gov.uk/government/people/jake-richards","withdrawn":false},{"api_path":"/api/content/government/people/david-lammy","api_url":"https://www.gov.uk/api/content/government/people/david-lammy","base_path":"/government/people/david-lammy","content_id":"8f917a87-3701-4171-a1db-eb3a655d07a2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:59:05Z","schema_name":"person","title":"The Rt Hon David Lammy MP","web_url":"https://www.gov.uk/government/people/david-lammy","withdrawn":false},{"api_path":"/api/content/government/people/dan-jarvis","api_url":"https://www.gov.uk/api/content/government/people/dan-jarvis","base_path":"/government/people/dan-jarvis","content_id":"72b7af32-c0a5-4038-a8e8-e582463dc05a","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-24T15:12:11Z","schema_name":"person","title":"The Rt Hon Dan Jarvis MBE MP","web_url":"https://www.gov.uk/government/people/dan-jarvis","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D18","api_path":"/api/content/government/organisations/ministry-of-justice","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-justice","base_path":"/government/organisations/ministry-of-justice","content_id":"dcc907d6-433c-42df-9ffb-d9c68be5dc4d","details":{"acronym":"MOJ","brand":"ministry-of-justice","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--301","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--301","base_path":"/government/ministers/parliamentary-under-secretary-of-state--301","content_id":"f0651ae4-36ac-4703-9064-826c4f0ddd93","details":{"body":"<ul>\n  <li>Sentencing Policy</li>\n  <li>Sentencing Bill</li>\n  <li>Youth Justice policy</li>\n  <li>Youth Custody operations</li>\n  <li>Human Rights and ECHR</li>\n  <li>International Justice (including Private International Law)</li>\n  <li>Crown Dependencies and Overseas Territories</li>\n  <li>Devolution and the Union</li>\n  <li>Commons Minister for Prisons, Probation and Reducing Reoffending</li>\n  <li>Transparency</li>\n  <li>Cross-cutting corporate portfolio</li>\n  <li>MOJ Mission lead for Breakdown barriers to opportunity</li>\n</ul>\n","role_payment_type":"Paid as a whip","seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:30:57Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Sentencing, Youth Justice and International","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--301","withdrawn":false},{"api_path":"/api/content/government/ministers/deputy-prime-minister--4","api_url":"https://www.gov.uk/api/content/government/ministers/deputy-prime-minister--4","base_path":"/government/ministers/deputy-prime-minister--4","content_id":"f3483a12-6f85-4b43-ae79-e3912bb5c9d5","details":{"body":"<p>The Deputy Prime Minister:</p>\n\n<ul>\n  <li>deputises for the Prime Minister domestically and internationally, including on House of Commons business and at Prime Minister’s Questions</li>\n  <li>represents the Prime Minister and HM Government at leader-level internationally when the Prime Minister is unable to attend, promoting and protecting British interests overseas</li>\n  <li>maintains and strengthens relationships with Vice Presidents, Deputy Prime Ministers and deputy leaders of key international partners, including the United States; advancing UK strategic priorities in international engagement, including: jobs and growth, security and the rule of law, climate ambition and the transition to net zero, tackling irregular migration.</li>\n  <li>plays a key role on the National Security Council and cabinet committees on Domestic and Border Security, and Union and Constitution</li>\n  <li>leads cross-government work to reduce reoffending, bringing together the Home Office, Department of Health and Social Care, Department for Work and Pensions, and the Ministry of Housing, Communities and Local Government.</li>\n  <li>supports delivery of the government’s mission to halve knife crime, working alongside the Home Secretary</li>\n  <li>champions the rule of law globally, working with the Foreign Secretary, Home Secretary and Attorney General</li>\n  <li>with the Prime Minister and the Ministry of Housing, Communities and Local Government, helps drive a unifying story of citizenship, cohesion and the Union, including engagement across the nations and communities of the UK</li>\n  <li>leads work across government to improve outcomes for boys and men, convening departments and partners to deliver coordinated action</li>\n</ul>\n\n<p>The Deputy Prime Minister is supported by an Office of Deputy Prime Minister which coordinates work across departments and supports on the delivery of the Deputy Prime Minister’s priorities.</p>\n","role_payment_type":null,"seniority":5,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-03-30T10:56:51Z","schema_name":"role","title":"Deputy Prime Minister","web_url":"https://www.gov.uk/government/ministers/deputy-prime-minister--4","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--174","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--174","base_path":"/government/ministers/minister-of-state--174","content_id":"b6023b8d-21a1-4d97-9242-9b7244cb0a15","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>counter terrorism and extremism  </li>\n  <li>state threats </li>\n  <li>cyber security and crime </li>\n  <li>serious and organised crime </li>\n  <li>oversight of the National Crime Agency </li>\n  <li>international criminality </li>\n  <li>aviation and maritime security </li>\n  <li>economic crime (excluding fraud) </li>\n  <li>extradition </li>\n  <li>exclusions and deprivations </li>\n  <li>MP security and VIP protection </li>\n  <li>online safety </li>\n  <li>anti-corruption</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-31T14:12:52Z","schema_name":"role","title":"Minister of State (Minister for Security)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--174","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/sentencing-reform","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/sentencing-reform","base_path":"/crime-justice-and-law/sentencing-reform","content_id":"70505387-138c-431c-a82d-94ff81f97e18","details":{"internal_name":"Sentencing reform [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Sentencing reform","web_url":"https://www.gov.uk/crime-justice-and-law/sentencing-r