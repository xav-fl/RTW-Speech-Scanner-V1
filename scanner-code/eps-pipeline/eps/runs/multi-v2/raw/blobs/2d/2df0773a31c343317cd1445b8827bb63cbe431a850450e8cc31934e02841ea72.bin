ishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-01-08T00:05:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"£140m Scottish Local Growth Fund to drive economic growth  ","updated_at":"2026-08-14T14:41:55+01:00","withdrawn_notice":{}}