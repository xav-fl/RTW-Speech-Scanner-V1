crest":"so","formatted_title":"Scotland Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Scotland Office","web_url":"https://www.gov.uk/government/organisations/scotland-office","withdrawn":false},{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/douglas-alexander","api_url":"https://www.gov.uk/api/content/government/people/douglas-alexander","base_path":"/government/people/douglas-alexander","content_id":"93f2d702-c240-4895-bbdd-bde1d2fbc16d","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-09-05T19:03:52Z","schema_name":"person","title":"The Rt Hon Douglas Alexander MP","web_url":"https://www.gov.uk/government/people/douglas-alexander","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1423","api_path":"/api/content/government/organisations/scotland-office","api_url":"https://www.gov.uk/api/content/government/organisations/scotland-office","base_path":"/government/organisations/scotland-office","content_id":"63953ed9-98ac-4d08-a1b9-8ea38dbd0832","details":{"acronym":"","brand":"scotland-office","default_news_image":null,"logo":{"crest":"so","formatted_title":"Scotland Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Scotland Office","web_url":"https://www.gov.uk/government/organisations/scotland-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-scotland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-scotland","base_path":"/government/ministers/secretary-of-state-for-scotland","content_id":"845e65ce-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Scotland is the UK Government Cabinet Minister representing Scotland. They act as the custodian of the Scottish devolution settlement, represent Scottish interests within the UK Government, and advocate for the UK Government’s policies in Scotland. </p>\n\n<p>They also promote partnership between the UK Government and the Scottish Government, as well as relations between the UK and Scottish Parliaments.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Industrial Strategy Delivery</li>\n  <li>Local Growth and City Deals Strategy</li>\n  <li>Data, Digital and AI</li>\n  <li>Investment, Economy and Fiscal</li>\n  <li>Defence</li>\n  <li>Energy and North Sea Policy</li>\n  <li>Brand Scotland Programme</li>\n  <li>International &amp; Trade Missions</li>\n  <li>Constitutional and Devolution Policy</li>\n  <li>UK Internal Market</li>\n  <li>Intergovernmental Relations</li>\n  <li>Home Affairs</li>\n  <li>Corporate</li>\n</ul>\n","role_payment_type":null,"seniority":24,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T13:41:13Z","schema_name":"role","title":"Secretary of State for Scotland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-scotland","withdrawn":false}],"taxons":[{"api_path":"/api/content/work","api_url":"https://www.gov.uk/api/content/work","base_path":"/work","content_id":"d0f1e5a3-c8f4-4780-8678-994f19104b21","description":"","details":{"internal_name":"Work","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:33:40Z","schema_name":"taxon","title":"Work","web_url":"https://www.gov.uk/work","withdrawn":false},{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_update