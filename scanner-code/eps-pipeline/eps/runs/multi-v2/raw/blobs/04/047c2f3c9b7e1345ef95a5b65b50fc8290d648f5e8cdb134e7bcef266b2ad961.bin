logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/matthew-pennycook","api_url":"https://www.gov.uk/api/content/government/people/matthew-pennycook","base_path":"/government/people/matthew-pennycook","content_id":"8f439fe5-f799-4fb6-a249-86fd399bb3cb","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T13:42:30Z","schema_name":"person","title":"The Rt Hon Matthew Pennycook MP","web_url":"https://www.gov.uk/government/people/matthew-pennycook","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--176","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--176","base_path":"/government/ministers/minister-of-state--176","content_id":"6edd9458-f4f8-4388-9fe0-c330422e47dd","details":{"body":"<p>The Minister for Housing and Planning is responsibile for:</p>\n\n<ul>\n  <li>Planning reform and the National Planning Policy Framework</li>\n  <li>Housing delivery, including large-scale new settlements programme (New Towns)</li>\n  <li>Brownfield Infrastructure Land and Housing Infrastructure Funds</li>\n  <li>Housing supply strategy</li>\n  <li>Homes England and Planning Inspectorate sponsorship</li>\n  <li>HM Land Registry and land transparency</li>\n  <li>Social housing</li>\n  <li>Social and Affordable Homes Programme </li>\n  <li>Housing quality</li>\n  <li>Private rented sector</li>\n  <li>Leasehold and commonhold reform</li>\n  <li>Planning casework</li>\n</ul>\n","role_payment_type":null,"seniority":25,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:47:20Z","schema_name":"role","title":"Minister of State (Minister for Housing and Planning)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--176","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/regulation","api_url":"https://www.gov.uk/api/content/housing-local-and-community/regulation","base_path":"/housing-local-and-community/regulation","content_id":"45a38712-a3d6-42a7-a3ef-70c37665f429","details":{"internal_name":"Housing regulation [T] (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"a