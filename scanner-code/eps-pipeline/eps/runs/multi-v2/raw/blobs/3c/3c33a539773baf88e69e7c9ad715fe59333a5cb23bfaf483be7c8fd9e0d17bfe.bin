ame":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/special-educational-needs-and-disability-send-and-high-needs","api_url":"https://www.gov.uk/api/content/education/special-educational-needs-and-disability-send-and-high-needs","base_path":"/education/special-educational-needs-and-disability-send-and-high-needs","content_id":"47b6ce42-0bfa-42ee-9ff1-7a9c71ee9727","description":"Support and funding, SEND code of practice, extra SEND help, P scales for attainment targets, free school transport.","details":{"internal_name":"Special educational needs and disability (SEND) and high needs","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-06-29T13:04:22Z","schema_name":"taxon","title":"Special educational needs and disability (SEND) and high needs","web_url":"https://www.gov.uk/education/special-educational-needs-and-disability-send-and-high-needs","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-19T22:30:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1776165843.262-10.13.21.154-2709","publishing_scheduled_at":"2026-02-19T22:30:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":2,"schema_name":"news_article","title":"Government ends runaway independent special school fees","updated_at":"2026-08-11T13:33:31+01:00","withdrawn_notice":{}}