son","links":{},"locale":"en","public_updated_at":"2026-07-20T21:12:57Z","schema_name":"person","title":"The Rt Hon Liz Kendall MP","web_url":"https://www.gov.uk/government/people/liz-kendall","withdrawn":false},{"api_path":"/api/content/government/people/bridget-phillipson","api_url":"https://www.gov.uk/api/content/government/people/bridget-phillipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1381","api_path":"/api/content/government/organisations/department-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-science-innovation-and-technology","base_path":"/government/organisations/department-for-science-innovation-and-technology","content_id":"c352c234-8083-47ec-8a4b-0edd45c31263","details":{"acronym":"DSIT","brand":"department-for-science-innovation-technology","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/68a86caf969253904d1557b7/s960_DSIT_GovUK.png","url":"https://assets.publishing.service.gov.uk/media/68a86caf960e2d135b4c8da5/s300_DSIT_GovUK.png"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Science, Innovation<br/>&amp; Technology"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/organisations/department-for-science-innovation-and-technology","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-science-innovation-and-technology","base_path":"/government/ministers/secretary-of-state-for-science-innovation-and-technology","content_id":"ea18a87c-95fa-44c0-b769-e0056c2b03bc","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Science, Innovation and Technology. See junior ministers roles for individual portfolio areas.</p>\n\n<ul>\n  <li><a href=\"https://www.gov.uk/government/people/patrick-vallance\">Minister of State for Science, Research and Innovation</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/ian-murray\">Minister of State</a></li>\n  <li><a href=\"https://www.gov.uk/government/people/kanishka-narayan\">Parliamentary Under Secretary of State</a></li>\n</ul>\n","role_payment_type":null,"seniority":21,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-08T11:01:11Z","schema_name":"role","title":"Secretary of State for Science, Innovation and Technology","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-science-innovation-and-technology","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/society-and-culture/online-safety","api_url":"https://www.gov.uk/api/content/society-and-culture/online-safety","base_path":"/society-and-culture/online-safety","content_id":"ecc8978c-cc6b-463e-a3d5-d5428c3e9f7d","description":"","details":{"internal_name":"Online safety","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/society-and-culture","api_url":"https://www.gov.uk/api/content/society-and-culture","base_path":"/society-and-culture","content_id":"e2ca2f1a-0ff3-43ce-b813-16645ff27904","description":"","details":{"internal_name":"Society and culture","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:31:27Z","schema_name":"taxon","title":"Society and culture","web_url":"https://www.gov.uk/society-and-culture","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2020-09-29T14:04:46Z","schema_name":"taxon","title":"Online safety","web_url":"https://www.gov.uk/society-and-culture/online-safety","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-19T00:00:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1776165820.929-10.13.20.39-4597","publishing_scheduled_at":"2026-01-19T22:30:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":5,"schema_name":"news_article","title":"Government to drive action to improve children’s relationship with mobile phones and social media","updated_at":"2026-08-20T16:43:57+01:00","withdrawn_notice":{}}