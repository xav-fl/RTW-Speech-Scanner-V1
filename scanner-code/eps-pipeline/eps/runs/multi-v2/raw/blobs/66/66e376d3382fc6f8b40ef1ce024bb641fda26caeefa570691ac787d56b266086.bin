jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--287","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--287","base_path":"/government/ministers/parliamentary-under-secretary-of-state--287","content_id":"f6a289aa-d881-4b3f-9607-825dad929c79","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the Department of State</li>\n  <li>Recruitment</li>\n  <li>Retention and incentivisation, including training, skills and development</li>\n  <li>Service resettlement and transition</li>\n  <li>Office for Veterans Affairs (including veterans policy, delivery and VALOUR)</li>\n  <li>Armed Forces Covenant</li>\n  <li>Armed Forces People</li>\n  <li>Armed Forces Families</li>\n  <li>Housing (including Defence Housing Service)</li>\n  <li>Civilian workforce (including Royal Fleet Auxillary)</li>\n  <li>Defence Business Services (including legal, pensions and compensation)</li>\n  <li>Defence culture – including oversight of the Raising our Standards Programme and Equality, Diversity and Inclusion</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"