e":"en","schema_name":"organisation","title":"Home Office","web_url":"https://www.gov.uk/government/organisations/home-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--301","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--301","base_path":"/government/ministers/parliamentary-under-secretary-of-state--301","content_id":"f0651ae4-36ac-4703-9064-826c4f0ddd93","details":{"body":"<ul>\n  <li>Sentencing Policy</li>\n  <li>Sentencing Bill</li>\n  <li>Youth Justice policy</li>\n  <li>Youth Custody operations</li>\n  <li>Human Rights and ECHR</li>\n  <li>International Justice (including Private International Law)</li>\n  <li>Crown Dependencies and Overseas Territories</li>\n  <li>Devolution and the Union</li>\n  <li>Commons Minister for Prisons, Probation and Reducing Reoffending</li>\n  <li>Transparency</li>\n  <li>Cross-cutting corporate portfolio</li>\n  <li>MOJ Mission lead for Breakdown barriers to opportunity</li>\n</ul>\n","role_payment_type":"Paid as a whip","seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:30:57Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Sentencing, Youth Justice and International","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--301","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--244","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--244","base_path":"/government/ministers/parliamentary-under-secretary-of-state--244","content_id":"6e40f64e-7a39-4100-8a07-bfdfd789de78","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>safeguarding  </li>\n  <li>rape and serious sexual offences </li>\n  <li>violent crime and domestic abuse  </li>\n  <li>child sexual abuse and exploitation </li>\n  <li>violence against women and girls (VAWG)  </li>\n  <li>victims  </li>\n  <li>wider modern slavery policy including NRM, support and stakeholder engagement </li>\n  <li>spiking  </li>\n  <li>oversight of ALBs: Disclosure and Barring Service, Security Industry Authority, Director of Labour Market Enforcement (joint with DBT)</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-12T16:31:54Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Safeguarding and Violence Against Women and Girls)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--244","withdrawn":false}],"taxons":[{"api_path":"/api/content/childcare-parenting/preventing-neglect-abuse-and-exploitation","api_url":"https://www.gov.uk/api/content/childcare-parenting/preventing-neglect-abuse-and-exploitation","base_path":"/childcare-parenting/preventing-neglect-abuse-and-exploitation","content_id":"47fbdb87-b4ff-432a-a4cf-a2f2468ff6d4","description":"Online safety. Reporting and dealing with allegations of abuse. Female genital mutilation (FGM).","details":{"internal_name":"Preventing neglect, abuse and exploitation","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting/safeguarding-child-protection","api_url":"https://www.gov.uk/api/content/childcare-parenting/safeguarding-child-protection","base_path":"/childcare-parenting/safeguarding-child-protection","content_id":"5af6180c-d5db-4cc1-a68e-7bd066908132","description":"Preventing and reporting abuse. Homeless children, abduction, serious case reviews, data collection.","details":{"internal_name":"Safeguarding and child protection","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting/safeguarding-and-social-care-for-children","api_url":"https://www.gov.uk/api/content/childcare-parenting/safeguarding-and-social-care-for-children","base_path":"/childcare-parenting/safeguarding-and-social-care-for-children","content_id":"20eb4e84-98ee-404b-a4bd-fe8a36d5d71d","description":"Child protection, social work, children in care and looked-after children, becoming a social care provider.","details":{"internal_name":"Safeguarding and social care for children","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/childcare-parenting","api_url":"https://www.gov.uk/api/content/childcare-parenting","base_path":"/childcare-parenting","content_id":"206b7f3a-49b5-476f-af0f-fd27e2a68473","description":"Financial support, finding and providing childcare, pregnancy and birth, adoption and fostering, looked-after children, safeguarding.","details":{"internal_name":"Parenting, childcare and childrens services","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-07-27T13:29:23Z","schema_name":"taxon","title":"Parenting, childcare and children's services ","web_url":"https://www.gov.uk/childcare-parenting","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-07-27T13:38:52Z","schema_name":"taxon","title":"Safeguarding and social care for children","web_url":"https://www.gov.uk/childcare-parenting/safeguarding-and-social-care-for-children","withdrawn"