anisation","title":"Cabinet Office","web_url":"https://www.gov.uk/government/organisations/cabinet-office","withdrawn":false},{"analytics_identifier":"OT313","api_path":"/api/content/government/organisations/british-council","api_url":"https://www.gov.uk/api/content/government/organisations/british-council","base_path":"/government/organisations/british-council","content_id":"37d2c134-1285-4907-a366-611617cfe44c","details":{"acronym":"British Council","brand":"foreign-commonwealth-development-office","default_news_image":null,"logo":{"crest":"no-identity","formatted_title":"British Council"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"http://www.britishcouncil.org"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"British Council","web_url":"https://www.gov.uk/government/organisations/british-council","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/nick-thomas-symonds","api_url":"https://www.gov.uk/api/content/government/people/nick-thomas-symonds","base_path":"/government/people/nick-thomas-symonds","content_id":"f1c761dd-762f-469a-93b6-28a244cd2e4d","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T18:09:04Z","schema_name":"person","title":"The Rt Hon Nick Thomas–Symonds MP","web_url":"https://www.gov.uk/government/people/nick-thomas-symonds","withdrawn":false},{"api_path":"/api/content/government/people/jacqui-smith","api_url":"https://www.gov.uk/api/content/government/people/jacqui-smith","base_path":"/government/people/jacqui-smith","content_id":"8d7c6906-f1dd-4a7d-ba70-ecd1a08aefe6","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T12:37:23Z","schema_name":"person","title":"The Rt Hon Baroness Smith of Malvern","web_url":"https://www.gov.uk/government/people/jacqui-smith","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-for-the-constitution-and-european-union-relations","api_url":"https://www.gov.uk/api/content/government/ministers/minister-for-the-constitution-and-european-union-relations","base_path":"/government/ministers/minister-for-the-constitution-and-european-union-relations","content_id":"7e5b028c-c20f-4351-9a2c-762734b18544","details":{"body":"<p>The Minister for the Cabinet Office is the deputy to the Chancellor of the Duchy of Lancaster in all departmental business, including on inter-governmental relations and public appointments.</p>\n\n<p>They are responsible for:</p>\n\n<ul>\n  <li>EU Policy and relations including the Windsor Framework</li>\n  <li>Oversight of functions and services</li>\n  <li>Civil Service reform</li>\n  <li>Inquiries policy </li>\n  <li>Infected blood inquiry </li>\n  <li>Duty of candour</li>\n  <li>Constitution and House of Lords reform </li>\n  <li>Cabinet Office business planning and performance </li>\n  <li>Communications function &amp; reform</li>\n  <li>Public sector workforce</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-20T18:04:56Z","schema_name":"role","title":"Minister for the Cabinet Office (Minister for the Constitution and European Union Relations)","web_url":"https://www.gov.uk/government/ministers/minister-for-the-constitution-and-european-union-relations","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--175","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--175","base_path":"/government/ministers/minister-of-state--175","content_id":"5dc89f34-86e1-4173-9980-0a525d4ef2f3","details":{"body":"<p>The minister’s Department for Education (DfE) responsibilities include:</p>\n\n<ul>\n  <li>governance, intervention and accountability of further education colleges</li>\n  <li>funding for education and training, provision and outcomes for 16- to 19-year-olds</li>\n  <li>further education financial stability and workforce</li>\n  <li>access to higher education, participation and lifelong learning entitlement</li>\n  <li>quality of higher education and the student experience (including the <a rel=\"external\" href=\"https://www.officeforstudents.org.uk/\">Office for Students</a>)</li>\n  <li>student finance (including the <a href=\"https://www.gov.uk/government/organisations/student-loans-company\">Student Loans Company</a>)</li>\n  <li>technical and vocational qualifications (level 3 and below), including T Levels</li>\n  <li>higher technical education (levels 4 and 5)</li>\n  <li>careers advice</li>\n  <li>support for young people aged 16 to 19 not in employment, education or training (NEET)</li>\n  <li>skills strategy and delivery</li>\n  <li>technical excellence colleges</li>\n  <li>international education</li>\n</ul>\n\n<p>The minister’s Department for Work and Pensions (DWP) responsibilities include:</p>\n\n<ul>\n  <li>\n<a href=\"https://www.gov.uk/government/organisations/skills-england\">Skills England</a> and Industry Training Boards</li>\n  <li>adult education, including basic skills</li>\n  <li>apprenticeships, including the growth and skills levy</li>\n  <li>skills bootcamps</li>\n  <li>sector skills packages</li>\n  <li>careers advice and support for young people over the age of 19 not in employment, education or training (NEET)</li>\n  <li>Youth Guarantee</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:15:41Z","schema_name":"role","title":"Minister of State (Minister for Skills)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--175","withdrawn":false}],"taxons":[{"api_path":"/api/content/government/europe","api_url":"https://www.gov.uk/api/content/government/europe","base_path":"/government/europe","content_id":"3afd1d79-597d-4f97-bc7a-83766dcab2f4","description":"","details":{"internal_name":"Europe","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/government/all","api_url":"https://www.gov.uk/api/content/government/all","base_path":"/government/all","content_id":"e48ab80a-de80-4e83-bf59-26316856a5f9","description":"","details":{"internal_name":"Government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:29:39Z","schema_name":"taxon","title":"Government","web_url":"https://www.gov.uk/government/all","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T11:38:59Z","schema_name":"taxon","title":"Europe","web_url":"https://www.gov.uk/government/europe","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-15T14:30:48+01:00","publishing_app":"whitehall","publishing_request_id":"21-1776259848.473-10.13.20.39-2338","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK and EU finalise agreement to bring UK into Erasmus+ in 2027","updated_at":"2026-08-11T13:40:34+01:00","withdrawn_notice":{}}