on":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.gov.uk/international","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-03-25T22:30:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1774533782.734-10.13.20.149-2321","publishing_scheduled_at":"2026-03-25T22:30:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":9,"schema_name":"news_article","title":"Shadow fleet set to be interdicted in UK waters in latest blow to Russia","updated_at":"2026-08-14T17:36:32+01:00","withdrawn_notice":{}}