ations/ministry-of-justice","withdrawn":false},{"analytics_identifier":"D1382","api_path":"/api/content/government/organisations/department-for-business-and-trade","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-business-and-trade","base_path":"/government/organisations/department-for-business-and-trade","content_id":"aa750cdf-7925-429d-a2b3-0d9fa47d2c48","details":{"acronym":"DBT","brand":"department-for-business-trade","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/64539946faf4aa0012e132d1/s960_DBT_Plaque-2.jpg","url":"https://assets.publishing.service.gov.uk/media/64539946c33b46000cf5e655/s300_DBT_Plaque-2.jpg"},"logo":{"crest":"dbt","formatted_title":"Department for<br/>Business &amp; Trade"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Business and Trade","web_url":"https://www.gov.uk/government/organisations/department-for-business-and-trade","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/catherine-atkinson","api_url":"https://www.gov.uk/api/content/government/people/catherine-atkinson","base_path":"/government/people/catherine-atkinson","content_id":"12c53b84-f547-42e6-9945-2c4190933254","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:05:11Z","schema_name":"person","title":"Catherine Atkinson MP","web_url":"https://www.gov.uk/government/people/catherine-atkinson","withdrawn":false},{"api_path":"/api/content/government/people/natalie-fleet","api_url":"https://www.gov.uk/api/content/government/people/natalie-fleet","base_path":"/government/people/natalie-fleet","content_id":"1e5c20f9-4351-4712-b7f4-3a67ca4671cc","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T07:46:45Z","schema_name":"person","title":"Natalie Fleet MP","web_url":"https://www.gov.uk/government/people/natalie-fleet","withdrawn":false},{"api_path":"/api/content/government/people/stephanie-peacock","api_url":"https://www.gov.uk/api/content/government/people/stephanie-peacock","base_path":"/government/people/stephanie-peacock","content_id":"611cafa0-1b96-45fa-8a8a-7d254cba6ffb","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T10:26:24Z","schema_name":"person","title":"Stephanie Peacock MP","web_url":"https://www.gov.uk/government/people/stephanie-peacock","withdrawn":false},{"api_path":"/api/content/government/people/kate-dearden","api_url":"https://www.gov.uk/api/content/government/people/kate-dearden","base_path":"/government/people/kate-dearden","content_id":"ca23fbbf-edf5-46e1-9634-994684b338d2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T10:01:56Z","schema_name":"person","title":"Kate Dearden MP","web_url":"https://www.gov.uk/government/people/kate-dearden","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1383","api_path":"/api/content/government/organisations/department-for-culture-media-and-sport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-culture-media-and-sport","base_path":"/government/organisations/department-for-culture-media-and-sport","content_id":"ae9ef2e1-9de0-4ff8-b560-e6ac28a6205c","details":{"acronym":"","brand":"department-for-culture-media-sport","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Culture,<br/>Media &amp; Sport"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Culture, Media and Sport","web_url":"https://www.gov.uk/government/organisations/department-for-culture-media-and-sport","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--246","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--246","base_path":"/government/ministers/parliamentary-under-secretary-of-state--246","content_id":"0811d4c5-549e-4a94-a2b6-50c6b63dc24c","details":{"body":"<ul>\n  <li>Violence Against Women and Girls (VAWG)</li>\n  <li>Criminal Law</li>\n  <li>Victims, Witnesses and Vulnerabilities</li>\n  <li>Criminal Injuries Compensation Authority</li>\n  <li>Rape and Serious Sexual Offences (RASSO)</li>\n  <li>Victims and Courts Bill (VAC)</li>\n  <li>Hillsborough</li>\n  <li>Death Management, Inquiries and Coroners</li>\n  <li>Miscarriages of Justice</li>\n  <li>Criminal Cases Review Commission</li>\n  <li>MOJ Mission lead for Safer Streets</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:39:18Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Victims and Tackling Violence Against Women and Girls","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--246","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--308","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--308","base_path":"/government/ministers/parliamentary-under-secretary-of-state--308","content_id":"73f13714-3f3f-489c-929f-6935e178490a","details":{"body":"<p>The Minister’s responsibilities are:</p>\n\n<ul>\n  <li>safeguarding  </li>\n  <li>rape and serious sexual offences </li>\n  <li>violent crime and domestic abuse  </li>\n  <li>child sexual abuse and exploitation </li>\n  <li>violence against women and girls (VAWG)  </li>\n  <li>victims  </li>\n  <li>wider modern slavery policy including the national referral mechanism, support and stakeholder engagement </li>\n  <li>spiking  </li>\n  <li>oversight of Disclosure and Barring Service (DBS)</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-21T13:01:14Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Safeguarding and Violence Against Women and Girls)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--308","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state-minister-for-sport-tourism-civil-society-and-youth","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state-minister-for-sport-tourism-civil-society-and-youth","base_path":"/government/ministers/parliamentary-under-secretary-of-state-minister-for-sport-tourism-civil-society-and-youth","content_id":"e79fcb70-c06d-415b-8bc0-38dcea696db8","details":{"body":"<p>The Minister for Sport, Tourism, Civil Society and Youth is responsible for:</p>\n\n<ul>\n  <li>Sport</li>\n  <li>Tourism </li>\n  <li>Civil society</li>\n  <li>Youth</li>\n  <li>Loneliness and social connection</li>\n  <li>Impact Economy</li>\n  <li>Ceremonials</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-11T14:25:22Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Sport, Tourism, Civil Society and Youth)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state-minister-for-sport-tourism-civil-society-and-youth","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--294","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--294","base_path":"/government/ministers/parliamentary-under-secretary-of-state--294","content_id":"48156772-14a6-430d-b9a3-23b62ca3beb6","details":{"body":"<p>Responsibilities include:</p>\n\n<ul>\n  <li>employment rights  </li>\n  <li>labour market enforcement  </li>\n  <li>consumer protection and competition policy</li>\n  <li>retail and hospitality  </li>\n  <li>consumer goods  </li>\n  <li>product safety  </li>\n  <li>Department Corporate Minister  </li>\n</ul>\n\n<p>Public bodies:</p>\n\n<ul>\n  <li>Low Pay Commission</li>\n  <li>Competition and Markets Authority</li>\n  <li>Advisory, Conciliation and Arbitration Service (Acas)</li>\n  <li>British Hallmarking Council</li>\n  <li>Competition Service</li>\n  <li>Groceries Code Adjudicator</li>\n  <li>Pubs Code Adjudicator</li>\n  <li>Competition Appeal Tribunal</li>\n  <li>Central Arbitration Committee</li>\n  <li>Certification Officer</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-06T10:38:27Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Employment Rights and Consumer Protection)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--294","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/violence-against-women-and-girls","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/violence-against-women-and-girls","base_path":"/crime-justice-and-law/violence-against-women-and-girls","content_id":"756613a3-522d-4402-beb9-532b5708ba74","details":{"internal_name":"Violence against women and girls [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_de