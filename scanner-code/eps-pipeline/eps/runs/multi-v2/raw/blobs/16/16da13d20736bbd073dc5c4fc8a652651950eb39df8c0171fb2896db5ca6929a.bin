:false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T12:54:44Z","schema_name":"taxon","title":"Building regulation","web_url":"https://www.gov.uk/housing-local-and-community/building-regulation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-07-09T13:19:51+01:00","publishing_app":"whitehall","publishing_request_id":"20-1783669290.790-10.13.21.116-560048","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"BSR to introduce more proportionate and targeted approach for higher-risk building assessments","updated_at":"2026-08-11T13:55:54+01:00","withdrawn_notice":{}}