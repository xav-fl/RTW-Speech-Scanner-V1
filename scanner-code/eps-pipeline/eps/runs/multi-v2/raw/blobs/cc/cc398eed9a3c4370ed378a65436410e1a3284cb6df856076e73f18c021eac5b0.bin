  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/support-for-special-educational-needs-and-disability-send","api_url":"https://www.gov.uk/api/content/education/support-for-special-educational-needs-and-disability-send","base_path":"/education/support-for-special-educational-needs-and-disability-send","content_id":"0f92387b-f477-4592-85e6-0742f3fcf696","description":"SEND code of practice, P scales for attainment targets, internships, guidance and support for parents and carers.","details":{"internal_name":"Support for special educational needs and disability (SEND) ","notes_for_editors":"SEND grant allocations, funding distribution.","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/special-educational-needs-and-disability-send-and-high-needs","api_url":"https://www.gov.uk/api/content/education/special-educational-needs-and-disability-send-and-high-needs","base_path":"/education/special-educational-needs-and-disability-send-and-high-needs","content_id":"47b6ce42-0bfa-42ee-9ff1-7a9c71ee9727","description":"Support and funding, SEND code of practice, extra SEND help, P scales for attainment targets, free school transport.","details":{"internal_name":"Special educational needs and disability (SEND) and high needs","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0"