t-for-business-trade","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/64539946faf4aa0012e132d1/s960_DBT_Plaque-2.jpg","url":"https://assets.publishing.service.gov.uk/media/64539946c33b46000cf5e655/s300_DBT_Plaque-2.jpg"},"logo":{"crest":"dbt","formatted_title":"Department for<br/>Business &amp; Trade"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Business and Trade","web_url":"https://www.gov.uk/government/organisations/department-for-business-and-trade","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/chris-bryant","api_url":"https://www.gov.uk/api/content/government/people/chris-bryant","base_path":"/government/people/chris-bryant","content_id":"701ce38d-c098-4090-bcef-23fe4000bdaf","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T13:15:53Z","schema_name":"person","title":"The Rt Hon Sir Chris Bryant MP","web_url":"https://www.gov.uk/government/people/chris-bryant","withdrawn":false},{"api_path":"/api/content/government/people/baroness-chapman-of-darlington","api_url":"https://www.gov.uk/api/content/government/people/baroness-chapman-of-darlington","base_path":"/government/people/baroness-chapman-of-darlington","content_id":"71d4e873-9d40-4ed5-97ea-75158ac630a1","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T10:09:33Z","schema_name":"person","title":"The Rt Hon Baroness Chapman of Darlington","web_url":"https://www.gov.uk/government/people/baroness-chapman-of-darlington","withdrawn":false},{"api_path":"/api/content/government/people/bridget-phillipson","api_url":"https://www.gov.uk/api/content/government/people/bridget-phillipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--206","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--206","base_path":"/government/ministers/minister-of-state--206","content_id":"2a57ee0f-2a15-4f12-bf79-3c14c9c9d021","details":{"body":"<p>His portfolio includes:</p>\n\n<ul>\n  <li>trade strategy implementation  </li>\n  <li>WTO and CPTPP  </li>\n  <li>Free Trade Agreements  </li>\n  <li>international industrial strategy  </li>\n  <li>export strategy and trade promotion  </li>\n  <li>EU, Windsor Framework, and UK Internal Market  </li>\n  <li>Ukraine reconstruction  </li>\n  <li>creative industries </li>\n  <li>economic and investment security </li>\n  <li>trade remedies </li>\n  <li>sanctions  </li>\n  <li>import / export controls </li>\n</ul>\n\n<p>Public bodies:  </p>\n\n<ul>\n  <li>Trade Remedies Authority  </li>\n  <li>UK Export Finance</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-18T12:38:46Z","schema_name":"role","title":"Minister of State (Minister for Trade)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--206","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state-international-development-latin-america-and-caribbean","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state-international-development-latin-america-and-caribbean","base_path":"/government/ministers/minister-of-state-international-development-latin-america-and-caribbean","content_id":"9345c9b0-3ced-4803-8c86-f8f9f82b40b5","details":{"body":"\n<ul>\n  <li>\n    <p>Africa</p>\n  </li>\n  <li>\n    <p>migration</p>\n  </li>\n  <li>\n    <p>development and humanitarian</p>\n  </li>\n  <li>\n    <p>international finance</p>\n  </li>\n  <li>\n    <p>climate and energy security</p>\n  </li>\n  <li>\n    <p>violence against women and girls</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":6,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-30T11:47:07Z","schema_name":"role","title":"Minister of State (International Development and Africa)","web_url":"https://www.gov.uk/government/ministers/minister-of-state-international-development-latin-america-and-caribbean","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/co