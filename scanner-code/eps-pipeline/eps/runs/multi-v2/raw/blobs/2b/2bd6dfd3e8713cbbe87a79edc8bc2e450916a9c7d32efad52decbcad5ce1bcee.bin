nd-community/homelessness-rough-sleeping","api_url":"https://www.gov.uk/api/content/housing-local-and-community/homelessness-rough-sleeping","base_path":"/housing-local-and-community/homelessness-rough-sleeping","content_id":"dad5f9c9-410f-4320-aa14-860ccba2273e","description":"","details":{"internal_name":"Homelessness and rough sleeping","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/housing-and-communities","api_url":"https://www.gov.uk/api/content/housing-local-and-community/housing-and-communities","base_path":"/housing-local-and-community/housing-and-communities","content_id":"4ad66168-274d-4d83-9195-f4ab0ccc97cb","description":"","details":{"internal_name":"Housing and communities (level 2)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2022-02-14T14:24:18Z","schema_name":"taxon","title":"Housing and communities","web_url":"https://www.gov.uk/housing-local-and-community/housing-and-communities","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-01-03T10:54:56Z","schema_name":"taxon","title":"Homelessness and rough sleeping","web_url":"https://www.gov.uk/housing-local-and-community/homelessness-rough-sleeping","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-26T00:01:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-02-26T00:01:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":1,"schema_name":"news_article","title":"Over £50 million pumped into the fight to tackle homelessness","updated_at":"2026-07-30T11:39:03+01:00","withdrawn_notice":{}}