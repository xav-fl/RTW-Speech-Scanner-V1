https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--201","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--201","base_path":"/government/ministers/minister-of-state--201","content_id":"e4f33898-53fd-4329-94a7-796ae424ba5b","details":{"body":"<ul>\n  <li>Local government finance (including local taxation, business rates and local government pensions) </li>\n  <li>Local government policy (including stewardship, local audit, and governance reform) </li>\n  <li>Local government reorganisation </li>\n  <li>Homelessness and rough sleeping </li>\n  <li>Supported housing and domestic abuse </li>\n  <li>Resettlement </li>\n  <li>Planning casework</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-15T09:36:24Z","schema_name":"role","title":"Minister of State (Minister for Local Government and Homelessness)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--201","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/homelessness-rough-sleeping","api_url":"https://www.gov.uk/api/content/housing-local-and-community/homelessness-rough-sleeping","base_path":"/housing-local-and-community/homelessness-rough-sleeping","content_id":"dad5f9c9-410f-4320-aa14-860ccba2273e","description":"","details":{"internal_name":"Homelessness and rough sleeping","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/housing-and-communities","api_url":"https://www.gov.uk/api/content/housing-local-and-community/housing-and-communities","base_path":"/housing-local-and-community/housing-and-communities","content_id":"4ad66168-274d-4d83-9195-f4ab0ccc97cb","description":"","details":{"internal_name":"Housing and communities (level 2)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2022-02-14T14:24:18Z","schema_name":"taxon","title":"Housing and communities","web_url":"https://www.gov.uk/housing-local-and-community/housing-and-communities","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-01-03T10:54:56Z","schema_name":"taxon","title":"Homelessness and rough sleeping","web_url":"https://www.gov.uk/housing-local-and-community/homelessness-rough-sleeping","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-28T00:09:04+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782731688.590-10.13.21.164-600073","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Rough sleeping no longer a crime as Vagrancy Act repealed","updated_at":"2026-08-14T15:46:20+01:00","withdrawn_notice":{}}