stry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false},{"analytics_identifier":"OT1301","api_path":"/api/content/government/organisations/office-for-veterans-affairs","api_url":"https://www.gov.uk/api/content/government/organisations/office-for-veterans-affairs","base_path":"/government/organisations/office-for-veterans-affairs","content_id":"516357f6-92f3-4292-8449-b958e1c63c5f","details":{"acronym":"OVA","brand":"ministry-of-defence","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"Office for<br/>Veterans&#39; Affairs"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Office for Veterans' Affairs","web_url":"https://www.gov.uk/government/organisations/office-for-veterans-affairs","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/louise-sandher-jones","api_url":"https://www.gov.uk/api/content/government/people/louise-sandher-jones","base_path":"/government/people/louise-sandher-jones","content_id":"1ac2a507-21a5-477c-a012-c12ea4a38b66","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-14T13:54:32Z","schema_name":"person","title":"Louise Sandher-Jones MP","web_url":"https://www.gov.uk/government/people/louise-sandher-jones","withdrawn":false},{"api_path":"/api/content/government/people/john-healey","api_url":"https://www.gov.uk/api/content/government/people/john-healey","base_path":"/government/people/john-healey","content_id":"6e000fab-7c45-479a-8362-53a971f31f28","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:50:11Z","schema_name":"person","title":"The Rt Hon John Healey MP","web_url":"https://www.gov.uk/government/people/john-healey","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--287","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--287","base_path":"/government/ministers/parliamentary-under-secretary-of-state--287","content_id":"f6a289aa-d881-4b3f-9607-825dad929c79","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the Department of State</li>\n  <li>Recruitment</li>\n  <li>Retention and incentivisation, including training, skills and development</li>\n  <li>Service resettlement and transition</li>\n  <li>Office for Veterans Affairs (including veterans policy, delivery and VALOUR)</li>\n  <li>Armed Forces Covenant</li>\n  <li>Armed Forces People</li>\n  <li>Armed Forces Families</li>\n  <li>Housing (including Defence Housing Service)</li>\n  <li>Civilian workforce (including Royal Fleet Auxillary)</li>\n  <li>Defence Business Services (including legal, pensions and compensation)</li>\n  <li>Defence culture – including oversight of the Raising our Standards Programme and Equality, Diversity and Inclusion</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/defence-armed-forces-military-awards-commemorations-remembrance","api_url":"https://www.gov.uk/api/content/defence/defence-armed-forces-military-awards-commemorations-remembrance","base_path":"/defence/defence-armed-forces-military-awards-commemorations-remembrance","content_id":"90f19461-cda0-4bd2-bdca-a20f08554c86","description":"","details":{"internal_name":"Remembrance [T]","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence/military-awards-commemorations","api_url":"https://www.gov.uk/api/content/defence/military-awards-commemorations","base_path":"/defence/military-awards-commemorations","content_id":"72241f43-600b-4c34-9205-5a07060a2711","details":{"internal_name":"Military awards and commemorations [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:52Z","schema_name":"taxon","title":"Military awards and commemorations","web_url":"https://www.gov.uk/defence/military-awards-commemorations","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2024-05-13T09:27:25Z","schema_name":"taxon","title":"Remembrance","web_url":"https://www.gov.uk/defence/defence-armed-forces-military-awards-commemorations-remembrance","withdrawn":false},{"api_path":"/api/content/defence-and-armed-forces/veterans-family-support","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces/veterans-family-support","base_path":"/defence-and-armed-forces/veterans-family-support","content_id":"1f21cce7-fc86-433c-a79b-1a4f0acb5a3a","description":"","details":{"internal_name":"Veterans and family support [T] (level 2, defence theme)","notes_for_editors":"","url_override":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces