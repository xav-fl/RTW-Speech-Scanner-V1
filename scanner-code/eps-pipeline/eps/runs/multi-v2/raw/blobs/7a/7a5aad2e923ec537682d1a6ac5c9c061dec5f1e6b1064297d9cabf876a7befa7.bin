":"ministry-of-justice","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false},{"analytics_identifier":"EA1213","api_path":"/api/content/government/organisations/hm-prison-and-probation-service","api_url":"https://www.gov.uk/api/content/government/organisations/hm-prison-and-probation-service","base_path":"/government/organisations/hm-prison-and-probation-service","content_id":"37a2a3c3-ccd7-46b0-8b81-199a746a2768","details":{"acronym":"HMPPS","brand":"ministry-of-justice","default_news_image":null,"logo":{"crest":"single-identity","formatted_title":"HM Prison &amp; Probation Service"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"HM Prison and Probation Service","web_url":"https://www.gov.uk/government/organisations/hm-prison-and-probation-service","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/jake-richards","api_url":"https://www.gov.uk/api/content/government/people/jake-richards","base_path":"/government/people/jake-richards","content_id":"a430c5f7-3299-497b-8d23-33a3ab9231e2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T11:44:01Z","schema_name":"person","title":"Jake Richards MP","web_url":"https://www.gov.uk/government/people/jake-richards","withdrawn":false},{"api_path":"/api/content/government/people/david-lammy","api_url":"https://www.gov.uk/api/content/government/people/david-lammy","base_path":"/government/people/david-lammy","content_id":"8f917a87-3701-4171-a1db-eb3a655d07a2","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T21:59:05Z","schema_name":"person","title":"The Rt Hon David Lammy MP","web_url":"https://www.gov.uk/government/people/david-lammy","withdrawn":false},{"api_path":"/api/content/government/people/james-timpson","api_url":"https://www.gov.uk/api/content/government/people/james-timpson","base_path":"/government/people/james-timpson","content_id":"e04ec36e-4c73-4f03-a265-aa9eaf251601","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T10:20:40Z","schema_name":"person","title":"Lord Timpson OBE","web_url":"https://www.gov.uk/government/people/james-timpson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D18","api_path":"/api/content/government/organisations/ministry-of-justice","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-justice","base_path":"/government/organisations/ministry-of-justice","content_id":"dcc907d6-433c-42df-9ffb-d9c68be5dc4d","details":{"acronym":"MOJ","brand":"ministry-of-justice","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/assistant-whip-house-of-commons--6","api_url":"https://www.gov.uk/api/content/government/ministers/assistant-whip-house-of-commons--6","base_path":"/government/ministers/assistant-whip-house-of-commons--6","content_id":"bc223999-f9f6-4052-a830-c5bb6a22ee5a","details":{"body":"\n","role_payment_type":null,"seniority":119,"whip_organisation":{"label":"Assistant Whips","sort_order":3}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-11-05T17:47:21Z","schema_name":"role","title":"Assistant Whip, House of Commons","web_url":"https://www.gov.uk/government/ministers/assistant-whip-house-of-commons--6","withdrawn":false},{"api_path":"/api/content/government/ministers/deputy-prime-minister--4","api_url":"https://www.gov.uk/api/content/government/ministers/deputy-prime-minister--4","base_path":"/government/ministers/deputy-prime-minister--4","content_id":"f3483a12-6f85-4b43-ae79-e3912bb5c9d5","details":{"body":"<p>The Deputy Prime Minister:</p>\n\n<ul>\n  <li>deputises for the Prime Minister domestically and internationally, including on House of Commons business and at Prime Minister’s Questions</li>\n  <li>represents the Prime Minister and HM Government at leader-level internationally when the Prime Minister is unable to attend, promoting and protecting British interests overseas</li>\n  <li>maintains and strengthens relationships with Vice Presidents, Deputy Prime Ministers and deputy leaders of key international partners, including the United States; advancing UK strategic priorities in international engagement, including: jobs and growth, security and the rule of law, climate ambition and the transition to net zero, tackling irregular migration.</li>\n  <li>plays a key role on the National Security Council and cabinet committees on Domestic and Border Security, and Union and Constitution</li>\n  <li>leads cross-government work to reduce reoffending, bringing together the Home Office, Department of Health and Social Care, Department for Work and Pensions, and the Ministry of Housing, Communities and Local Government.</li>\n  <li>supports delivery of the government’s mission to halve knife crime, working alongside the Home Secretary</li>\n  <li>champions the rule of law globally, working with the Foreign Secretary, Home Secretary and Attorney General</li>\n  <li>with the Prime Minister and the Ministry of Housing, Communities and Local Government, helps drive a unifying story of citizenship, cohesion and the Union, including engagement across the nations and communities of the UK</li>\n  <li>leads work across government to improve outcomes for boys and men, convening departments and partners to deliver coordinated action</li>\n</ul>\n\n<p>The Deputy Prime Minister is supported by an Office of Deputy Prime Minister which coordinates work across departments and supports on the delivery of the Deputy Prime Minister’s priorities.</p>\n","role_payment_type":null,"seniority":5,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-03-30T10:56:51Z","schema_name":"role","title":"Deputy Prime Minister","web_url":"https://www.gov.uk/government/ministers/deputy-prime-minister--4","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state-minister-for-prisons","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state-minister-for-prisons","base_path":"/government/ministers/minister-of-state-minister-for-prisons","content_id":"1c617a67-4e7c-48c4-bcbb-131c1c133fc5","details":{"body":"<ul>\n  <li>Prison capacity and related policy </li>\n  <li>Prison operations policy, reform, industrial relations and workforce</li>\n  <li>Probation policy, operations, industrial relations, and transparency </li>\n  <li>His Majesty’s Prison and Probation Service administration </li>\n  <li>Sentencing Act implementation</li>\n  <li>Dame Lynne Owen Review into Release in Error</li>\n  <li>Public Protection (incl. Critical Public Protection Cases)</li>\n  <li>Parole Policy</li>\n  <li>Trans Prisoners</li>\n  <li>Female Offenders</li>\n  <li>Reducing Reoffending</li>\n  <li>Electronic Monitoring(EM)</li>\n  <li>Offender health and drugs</li>\n  <li>Prisoner Escort Contracts</li>\n  <li>Counter Terrorism</li>\n  <li>Amber Rudd Independent Review</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T09:38:00Z","schema_name":"role","title":"Minister of State for Prisons, Probation and Reducing Reoffending","web_url":"https://www.gov.uk/government/ministers/minister-of-state-minister-for-prisons","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/criminal-justice-reform","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/criminal-justice-reform","base_path":"/crime-justice-and-law/criminal-justice-reform","content_id":"23100f5c-25d2-4d3f-8a63-f32e619a32d5","details":{"internal_name":"Criminal justice reform [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","w