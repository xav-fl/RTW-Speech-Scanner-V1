ated_at":"2018-09-05T16:15:52Z","schema_name":"taxon","title":"Criminal justice reform","web_url":"https://www.gov.uk/crime-justice-and-law/criminal-justice-reform","withdrawn":false},{"api_path":"/api/content/crime-justice-and-law/prisons-probation","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/prisons-probation","base_path":"/crime-justice-and-law/prisons-probation","content_id":"1dd3f25a-9237-4143-b2d2-cd7f6863c9c0","details":{"internal_name":"Prisons and probation [T] (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:51Z","schema_name":"taxon","title":"Prisons and probation","web_url":"https://www.gov.uk/crime-justice-and-law/prisons-probation","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-03T15:58:30+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Dangerous extremists face “supermax” style restrictions behind bars","updated_at":"2026-08-17T11:47:22+01:00","withdrawn_notice":{}}