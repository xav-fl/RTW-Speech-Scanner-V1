-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/luke-pollard","api_url":"https://www.gov.uk/api/content/government/people/luke-pollard","base_path":"/government/people/luke-pollard","content_id":"0e11b976-f017-4c29-b0f2-94468466af99","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T15:26:00Z","schema_name":"person","title":"Luke Pollard MP","web_url":"https://www.gov.uk/government/people/luke-pollard","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--207","api_url":"https://www.gov.uk/api/content/government/min