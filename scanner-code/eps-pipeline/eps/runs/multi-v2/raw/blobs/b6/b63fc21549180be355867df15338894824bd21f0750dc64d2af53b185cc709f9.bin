1T14:04:12Z","schema_name":"person","title":"The Rt Hon Steve Reed OBE MP","web_url":"https://www.gov.uk/government/people/steve-reed","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1419","api_path":"/api/content/government/organisations/ministry-of-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-housing-communities-local-government","base_path":"/government/organisations/ministry-of-housing-communities-local-government","content_id":"1390d07f-12b3-4f55-9dd5-fec5fd9e3649","details":{"acronym":"MHCLG","brand":"ministry-of-housing-communities-local-government","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/668f9d9ea3c2a28abb50cd88/s960_2_Marsham_Street_1_-_960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/668f9d9eab418ab055592384/s300_2_Marsham_Street_1_-_960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry of Housing,<br/>Communities &amp; <br/>Local Government"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/organisations/ministry-of-housing-communities-local-government","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-housing-communities-local-government","base_path":"/government/ministers/secretary-of-state-for-housing-communities-local-government","content_id":"87779e9b-11a9-402a-9c4d-94dfa892f785","details":{"body":"<p>The Secretary of State has strategic oversight of the Department’s business and policy including: </p>\n\n<ul>\n  <li>Housing and planning </li>\n  <li>Local government and English devolution </li>\n  <li>Regional and local growth </li>\n  <li>Communities and faith </li>\n  <li>Democracy and elections</li>\n  <li>Building safety and remediation  </li>\n  <li>Public Appointments  </li>\n  <li>Planning casework </li>\n  <li>Corporate </li>\n</ul>\n","role_payment_type":null,"seniority":18,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T14:46:16Z","schema_name":"role","title":"Secretary of State for Housing, Communities and Local Government","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-housing-communities-local-government","withdrawn":false}],"taxons":[{"api_path":"/api/content/housing-local-and-community/house-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/house-building","base_path":"/housing-local-and-community/house-building","content_id":"3b35111d-dedf-47d7-af44-5125a0d9bfd3","details":{"internal_name":"House building [P] (level 3, housing theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/planning-and-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/planning-and-building","base_path":"/housing-local-and-community/planning-and-building","content_id":"e3147d4f-4bd5-4a14-a386-4ba7ccb058b4","details":{"internal_name":"Planning and building (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-24T11:05:58Z","schema_name":"taxon","title":"Planning and building","web_url":"https://www.gov.uk/housing-local-and-community/planning-and-building","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T12:54:44Z","schema_name":"taxon","title":"House building","web_url":"https://www.gov.uk/housing-local-and-community/house-building","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-03-25T14:00:58+00:00","publishing_app":"whitehall","publishing_request_id":"22-1774447258.241-10.13.21.35-2395","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Emergency action to kickstart London housebuilding","updated_at":"2026-08-14T15:46:20+01:00","withdrawn_notice":{}}