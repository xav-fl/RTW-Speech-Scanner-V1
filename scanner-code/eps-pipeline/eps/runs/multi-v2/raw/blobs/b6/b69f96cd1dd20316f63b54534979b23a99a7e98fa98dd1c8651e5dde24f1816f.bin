{"analytics_identifier":null,"base_path":"/government/publications/dfe-update-20-may-2026","content_id":"ecb19b2d-4539-4cef-8a90-7c6f68fdf3f3","description":"Latest information and actions from the Department for Education about funding, assurance and resource management, for academies, local authorities and further education providers.","details":{"attachments":[{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248142","isbn":"","title":"DfE Update further education: 20 May 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-20-may-2026/dfe-update-further-education-20-may-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248143","isbn":"","title":"DfE Update academies: 20 May 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-20-may-2026/dfe-update-academies-20-may-2026"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9248144","isbn":"","title":"DfE Update local authorities: 20 May 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/publications/dfe-update-20-may-2026/dfe-update-local-authorities-20-may-2026"}],"body":"<div class=\"govspeak\"><div class=\"call-to-action\">\n  <h2 id=\"have-your-say\">Have Your Say</h2>\n  <p>This is your chance to shape future DfE Updates. Please take a few minutes to complete our survey and share your views. See the feedback article for the link to the survey.</p>\n</div>\n\n<h2 id=\"latest-for-further-education\">Latest for further education</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Year-end funding claim for adult funding 2025 to 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Submit Care to Learn and 16 to 19 Bursary Fund for defined vulnerable groups funding claims</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Delayed publication of the subcontracting funding rules for post-16 education and training (excluding apprenticeships)</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Post-16 National Insurance contributions grant</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>2026 to 2027 student financial support scheme guides published</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Further education workforce data collection update</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Transfer of skills and apprenticeships responsibilities</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of the DfE Update newsletter</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help us improve adult funding information</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-academies\">Latest for academies</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Submit Care to Learn and 16 to 19 Bursary Fund for defined vulnerable groups funding claims</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free breakfast club payment</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Post-16 National Insurance contributions grant</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>2026 to 2027 student financial support scheme guides published</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Opening new schools – new process from 1 September 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free School Meals eligibility information webinars starting June 2026</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of the DfE Update newsletter</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Supply Teachers and Education Recruitment framework</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Risk protection arranegement Members only: Pupil Well-being Workshop</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Banking for schools</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Free School Meals Power Hour (for Headteacher, School Business Managers, and other staff involved in the delivery)</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"latest-for-local-authorities\">Latest for local authorities</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Article</th>\n      <th scope=\"col\">Title</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Action</td>\n      <td>Year-end funding claim for adult funding 2025 to 2026</td>\n    </tr>\n    <tr>\n      <td>Action</td>\n      <td>Submit Care to Learn and 16 to 19 Bursary Fund for defined vulnerable groups funding claims</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Delayed publication of the subcontracting funding rules for post-16 education and training (excluding apprenticeships)</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free breakfast club payment</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Post-16 National Insurance contributions grant</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>2026 to 2027 student financial support scheme guides published</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Further education workforce data collection update</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Transfer of skills and apprenticeships responsibilities</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Opening new schools – new process from Tuesday 1 September 2026</td>\n    </tr>\n    <tr>\n      <td>Information</td>\n      <td>Free School Meals eligibility information webinars starting June 2026</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Tell us about your experience of the DfE Update newsletter</td>\n    </tr>\n    <tr>\n      <td>Feedback</td>\n      <td>Help us improve adult funding information</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Supply Teachers and Education Recruitment framework</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Risk protection arrangement Members only: Pupil Well-being Workshop</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Banking for schools</td>\n    </tr>\n    <tr>\n      <td>Events and webinars</td>\n      <td>Free School Meals Power Hour (for LA officials involved in the delivery)</td>\n    </tr>\n  </tbody>\n</table>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-05-20T12:27:50Z"}],"document_type_label":"Correspondence","emphasised_organisations":["ebd15ade-73b2-4eaf-b1c3-43034a42eb37"],"featured_attachments":["9248142","9248143","9248144"],"first_public_at":"2026-05-20T13:27:50.000+01:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotland"},"wales":{"alternative_url":"","applicable":false,"label":"Wales"}},"political":false,"tags":{"browse_pages":[]}},"document_type":"correspondence","first_published_at":"2026-05-20T13:27:50+01:00","links":{"available_translations":[{"api_path":"/api/content/government/publications/dfe-update-20-may-2026","api_url":"https://www.gov.uk/api/content/government/publications/dfe-update-20-may-2026","base_path":"/government/publications/dfe-update-20-may-2026","content_id":"ecb19b2d-4539-4cef-8a90-7c6f68fdf3f3","document_type":"cor