and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"International defence commitments","web_url":"https://www.gov.uk/defence/international-defence-commitments","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-23T14:28:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"UK submarine arrives in Australia in AUKUS partnership first","updated_at":"2026-08-14T17:43:16+01:00","withdrawn_notice":{}}