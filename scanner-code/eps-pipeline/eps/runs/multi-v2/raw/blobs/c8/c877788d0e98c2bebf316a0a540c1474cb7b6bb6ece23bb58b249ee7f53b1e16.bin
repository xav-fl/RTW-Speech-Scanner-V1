s":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community/planning-and-building","api_url":"https://www.gov.uk/api/content/housing-local-and-community/planning-and-building","base_path":"/housing-local-and-community/planning-and-building","content_id":"e3147d4f-4bd5-4a14-a386-4ba7ccb058b4","details":{"internal_name":"Planning and building (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/housing-local-and-community","api_url":"https://www.gov.uk/api/content/housing-local-and-community","base_path":"/housing-local-and-community","content_id":"4794066e-e3cc-425e-8cc4-e7ff3edb4c39","description":"","details":{"internal_name":"Housing, local and community","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:32:02Z","schema_name":"taxon","title":"Housing, local and community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-24T11:05:58Z","schema_name":"taxon","title":"Planning and building","web_url":"https://www.gov.uk/housing-local-and-community/planning-and-building","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T12:54:44Z","schema_name":"taxon","title":"Building regulation","web_url":"https://www.gov.uk/housing-local-and-community/building-regulation","withdrawn":false},{"api_path":"/api/content/housing-local-and-community/house-bu