":"/government/organisations/nhs-england","content_id":"f07b4bb8-8af6-42da-a161-3d90027e980c","details":{"acronym":"","brand":"department-of-health-social-care","default_news_image":null,"logo":{"crest":"no-identity","formatted_title":"NHS England"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"http://www.england.nhs.uk/"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"NHS England","web_url":"https://www.gov.uk/government/organisations/nhs-england","withdrawn":false},{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"government":[{"api_path":"/api/content/government/2024-starmer-labour-government","api_url":"https://www.gov.uk/api/content/government/2024-starmer-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false},{"analytics_identifier":"EA1328","api_path":"/api/content/government/organisations/uk-health-security-agency","api_url":"https://www.gov.uk/api/content/government/organisations/uk-health-security-agency","base_path":"/government/organisations/uk-health-security-agency","content_id":"80091cd8-7a8f-41ef-8faf-8af91fce4fdb","details":{"acronym":"UKHSA","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/674de56feb52380f5456af9f/s960_News_logo.png","url":"https://assets.publishing.service.gov.uk/media/674de56f20e5fc28f0a59fbb/s300_News_logo.png"},"logo":{"crest":"single-identity","formatted_title":"UK Health<br/>Security<br/>Agency"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"UK Health Security Agency","web_url":"https://www.gov.uk/government/organisations/uk-health-security-agency","withdrawn":false},{"analytics_identifier":"PB481","api_path":"/api/content/government/organisations/nhs-england","api_url":"https://www.gov.uk/api/content/government/organisations/nhs-england","base_path":"/government/organisations/nhs-england","content_id":"f07b4bb8-8af6-42da-a161-3d90027e980c","details":{"acronym":"","brand":"department-of-health-social-care","default_news_image":null,"logo":{"crest":"no-identity","formatted_title":"NHS England"},"organisation_govuk_status":{"status":"exempt","updated_at":null,"url":"http://www.england.nhs.uk/"}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"NHS England","web_url":"https://www.gov.uk/government/organisations/nhs-england","withdrawn":false},{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/james-murray","api_url":"https://www.gov.uk/api/content/government/people/james-murray","base_path":"/government/people/james-murray","content_id":"ac0e5e69-9c5d-4b52-8ef5-5f6dec83d8df","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T08:29:43Z","schema_name":"person","title":"The Rt Hon James Murray MP","web_url":"https://www.gov.uk/government/people/james-murray","withdrawn":false},{"api_path":"/api/content/government/people/jacqui-smith","api_url":"https://www.gov.uk/api/content/government/people/jacqui-smith","base_path":"/government/people/jacqui-smith","content_id":"8d7c6906-f1dd-4a7d-ba70-ecd1a08aefe6","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T12:37:23Z","schema_name":"person","title":"The Rt Hon Baroness Smith of Malvern","web_url":"https://www.gov.uk/government/people/jacqui-smith","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D12","api_path":"/api/content/government/organisations/department-of-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/organisations/department-of-health-and-social-care","base_path":"/government/organisations/department-of-health-and-social-care","content_id":"7cd6bf12-bbe9-4118-8523-f927b0442156","details":{"acronym":"DHSC","brand":"department-of-health-social-care","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/627508178fa8f520738d5474/s960_DHSC_plaque.jpg","url":"https://assets.publishing.service.gov.uk/media/62750817e90e070dbf5acad5/s300_DHSC_plaque.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>of Health &amp;<br/>Social Care"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department of Health and Social Care","web_url":"https://www.gov.uk/government/organisations/department-of-health-and-social-care","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-health-and-social-care","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-health-and-social-care","base_path":"/government/ministers/secretary-of-state-for-health-and-social-care","content_id":"25fa7393-375b-46ef-ab91-1b2bb9ef0e7f","details":{"body":"<p>The Secretary of State is responsible for the work of the Department of Health and Social Care, including:</p>\n\n<ul>\n  <li>overall financial control and oversight of NHS delivery and performance</li>\n  <li>oversight of social care policy</li>\n</ul>\n","role_payment_type":null,"seniority":13,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2018-01-23T10:09:56Z","schema_name":"role","title":"Secretary of State for Health and Social Care","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-health-and-social-care","withdrawn":false},{"api_path":"/api/content/government/ministers/minister-of-state--175","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--175","base_path":"/government/ministers/minister-of-state--175","content_id":"5dc89f34-86e1-4173-9980-0a525d4ef2f3","details":{"body":"<p>The minister’s Department for Education (DfE) responsibilities include:</p>\n\n<ul>\n  <li>governance, intervention and accountability of further education colleges</li>\n  <li>funding for education and training, provision and outcomes for 16- to 19-year-olds</li>\n  <li>further education financial stability and workforce</li>\n  <li>access to higher education, participation and lifelong learning entitlement</li>\n  <li>quality of higher education and the student experience (including the <a rel=\"external\" href=\"https://www.officeforstudents.org.uk/\">Office for Students</a>)</li>\n  <li>student finance (including the <a href=\"https://www.gov.uk/government/organisations/student-loans-company\">Student Loans Company</a>)</li>\n  <li>technical and vocational qualifications (level 3 and below), including T Levels</li>\n  <li>higher technical education (levels 4 and 5)</li>\n  <li>careers advice</li>\n  <li>support for young people aged 16 to 19 not in employment, education or training (NEET)</li>\n  <li>skills strategy and delivery</li>\n  <li>technical excellence colleges</li>\n  <li>international education</li>\n</ul>\n\n<p>The minister’s Department for Work and Pensions (DWP) responsibilities include:</p>\n\n<ul>\n  <li>\n<a href=\"https://www.gov.uk/government/organisations/skills-england\">Skills England</a> and Industry Training Boards</li>\n  <li>adult education, including basic skills</li>\n  <li>apprenticeships, including the growth and skills levy</li>\n  <li>skills bootcamps</li>\n  <li>sector skills packages</li>\n  <li>careers advice and support for young people over the age of 19 not in employment, education or training (NEET)</li>\n  <li>Youth Guarantee</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:15:41Z","schema_name":"role","title":"Minister of State (Minister for Skills)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--175","withdrawn":false}],"taxons":[{"api_path":"/api/content/health-and-social-care/national-health-service","api_url":"https://www.gov.uk/api/content/health-and-social-care/national-health-service","base_path":"/health-and-social-care/national-health-service","content_id":"f3dcc290-752f-4bbe-b379-9155d919a58d","details":{"internal_name":"National Health Service (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/health-and-social-care","api_url":"https://www