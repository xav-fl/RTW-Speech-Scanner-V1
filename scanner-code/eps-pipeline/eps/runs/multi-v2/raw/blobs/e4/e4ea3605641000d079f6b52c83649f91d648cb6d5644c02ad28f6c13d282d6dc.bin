":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false},{"analytics_identifier":"OT532","api_path":"/api/content/government/organisations/prime-ministers-office-10-downing-street","api_url":"https://www.gov.uk/api/content/government/organisations/prime-ministers-office-10-downing-street","base_path":"/government/organisations/prime-ministers-office-10-downing-street","content_id":"705dbea4-8bd7-422e-ba9c-254557f77f81","details":{"acronym":"Number 10","brand":"prime-ministers-office-10-downing-street","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37daeaed915d5a5f96602b/s960_number10.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dae940f0b649cceb1841/s300_number10.jpg"},"logo":{"crest":"eo","formatted_title":"Prime Minister&#39;s Office <br/>10 Downing Street"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Prime Minister's Office, 10 Downing Street","web_url":"https://www.gov.uk/government/organisations/prime-ministers-office-10-downing-street","withdrawn":false},{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/yvette-cooper","api_url":"https://www.gov.uk/api/content/government/people/yvette-cooper","base_path":"/government/people/yvette-cooper","content_id":"e3145327-542d-43d8-9c4e-f6908f265478","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T19:08:19Z","schema_name":"person","title":"The Rt Hon Yvette Cooper MP","web_url":"https://www.gov.uk/government/people/yvette-cooper","withdrawn":false},{"api_path":"/api/content/government/people/keir-starmer","api_url":"https://www.gov.uk/api/content/government/people/keir-starmer","base_path":"/government/people/keir-starmer","content_id":"86d507f5-c34e-466b-b622-4d4585b75916","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T10:49:41Z","schema_name":"person","title":"The Rt Hon Sir Keir Starmer KCB KC MP","web_url":"https://www.gov.uk/government/people/keir-starmer","withdrawn":false},{"api_path":"/api/content/government/people/john-healey","api_url":"https://www.gov.uk/api/content/government/people/john-healey","base_path":"/government/people/john-healey","content_id":"6e000fab-7c45-479a-8362-53a971f31f28","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:50:11Z","schema_name":"person","title":"The Rt Hon John Healey MP","web_url":"https://www.gov.uk/government/people/john-healey","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1315","api_path":"/api/content/government/organisations/foreign-commonwealth-development-office","api_url":"https://www.gov.uk/api/content/government/organisations/foreign-commonwealth-development-office","base_path":"/government/organisations/foreign-commonwealth-development-office","content_id":"f9fcf3fe-2751-4dca-97ca-becaeceb4b26","details":{"acronym":"FCDO","brand":"foreign-commonwealth-development-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/621e4de4e90e0710be0354d7/s960_fcdo-main-building.jpg","url":"https://assets.publishing.service.gov.uk/media/621e4de48fa8f5490aff83b4/s300_fcdo-main-building.jpg"},"logo":{"crest":"single-identity","formatted_title":"Foreign, Commonwealth<br/>&amp; Development Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Foreign, Commonwealth & Development Office","web_url":"https://www.gov.uk/government/organisations/foreign-commonwealth-development-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","base_path":"/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","content_id":"6cdc189e-191e-4cab-bcc1-350478e77c78","details":{"body":"<p>The Secretary of State has overarching responsibility for FCDO and the Ministerial team, and the strategy and delivery of HMG international priorities, including:</p>\n\n<ul>\n  <li>\n    <p>intelligence policy  </p>\n  </li>\n  <li>\n    <p>National Security Council engagement</p>\n  </li>\n  <li>\n    <p>honours  </p>\n  </li>\n  <li>\n    <p>EU strategy</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":9,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-31T11:39:31Z","schema_name":"role","title":"Secretary of State for Foreign, Commonwealth and Development Affairs","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-foreign-commonwealth-and-development-affairs","withdrawn":false},{"api_path":"/api/content/government/ministers/prime-minister","api_url":"https://www.gov.uk/api/content/government/ministers/prime-minister","base_path":"/government/ministers/prime-minister","content_id":"845e5811-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Prime Minister is the leader of His Majesty’s Government and is ultimately responsible for the policy and decisions of the government. </p>\n\n<p>As leader of the UK government the Prime Minister also: </p>\n\n<ul>\n  <li>oversees the <a href=\"https://www.gov.uk/government/ministers/minister-for-the-civil-service\">operation of the Civil Service</a> and government agencies </li>\n  <li>chooses members of the government </li>\n  <li>is the principal government figure in the House of Commons </li>\n</ul>\n","role_payment_type":null,"seniority":1,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2024-07-05T11:32:36Z","schema_name":"role","title":"Prime Minister","web_url":"https://www.gov.uk/government/ministers/prime-minister","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false}],"taxons":[{"api_path":"/api/content/international/foreign-affairs","api_url":"https://www.gov.uk/api/content/international/foreign-affairs","base_path":"/international/foreign-affairs","content_id":"d6dba75a-42bd-4e1e-984c-2bddb6b41951","details":{"internal_name":"Foreign affairs [P]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/international","api_url":"https://www.gov.uk/api/content/international","base_path":"/international","content_id":"37d0fa26-abed-4c74-8835-b3b51ae1c8b2","description":"","details":{"internal_name":"International","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:28Z","schema_name":"taxon","title":"International","web_url":"https://www.gov.uk/international","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:14:19Z","schema_name":"taxon","title":"Foreign affairs","web_url":"https://www.gov.uk/international/foreign-affairs","withdrawn":false}],"world_locations":[{"analytics_identifier":"WL154","content_id":"5e9f274b-7706-11e4-a3cb-005056011aef","document_type":"world_location","links":{},"locale":"en","public_updated_at":"2022-02-23T11:37:06Z","schema_name":"world_location","title":"Ukraine","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-02-24T00:01:00+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-02-24T00:01:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":14,"schema_name":"news_article","title":"UK steps up support for Ukraine four years on from Putin's full-scale invasion","updated_at":"2026-08-26T03:04:11+01:00","withdrawn_notice":{}}