ishing.service.gov.uk/media/6708fb1de84ae1fd8592f1ec/s300_NIO_Gov.uk_banner.png"},"logo":{"crest":"single-identity","formatted_title":"Northern<br/>Ireland<br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Northern Ireland Office","web_url":"https://www.gov.uk/government/organisations/northern-ireland-office","withdrawn":false},{"analytics_identifier":"D2","api_path":"/api/content/government/organisations/cabinet-office","api_url":"https://www.gov.uk/api/content/government/organisations/cabinet-office","base_path":"/government/organisations/cabinet-office","content_id":"96ae61d6-c2a1-48cb-8e67-da9d105ae381","details":{"acronym":"","brand":"cabinet-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37da9d40f0b649cfaf7b27/s960_cabinet-office.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37da9ded915d5a5f965f9c/s300_cabinet-office.jpg"},"logo":{"crest":"single-identity","formatted_title":"Cabinet Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Cabinet Office","web_url":"https://www.gov.uk/government/organisations/cabinet-office","withdrawn":false},{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/olivia-bailey","api_url":"https://www.gov.uk/api/content/government/people/olivia-bailey","base_path":"/government/people/olivia-bailey","content_id":"d6a17b3c-e267-4014-b95b-e4881d814a20","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:06:48Z","schema_name":"person","title":"Olivia Bailey MP","web_url":"https://www.gov.uk/government/people/olivia-bailey","withdrawn":false},{"api_path":"/api/content/government/people/matthew-patrick","api_url":"https://www.gov.uk/api/content/government/people/matthew-patrick","base_path":"/government/people/matthew-patrick","content_id":"899aef7d-932a-4735-be61-4357ff7441d4","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-23T08:22:08Z","schema_name":"person","title":"Matthew Patrick MP","web_url":"https://www.gov.uk/government/people/matthew-patrick","withdrawn":false},{"api_path":"/api/content/government/people/nick-thomas-symonds","api_url":"https://www.gov.uk/api/content/government/people/nick-thomas-symonds","base_path":"/government/people/nick-thomas-symonds","content_id":"f1c761dd-762f-469a-93b6-28a244cd2e4d","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T18:09:04Z","schema_name":"person","title":"The Rt Hon Nick Thomas–Symonds MP","web_url":"https://www.gov.uk/government/people/nick-thomas-symonds","withdrawn":false},{"api_path":"/api/content/government/people/hilary-benn","api_url":"https://www.gov.uk/api/content/government/people/hilary-benn","base_path":"/government/people/hilary-benn","content_id":"535cf4f7-82f5-4707-b14e-99aefa22191e","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T07:45:00Z","schema_name":"person","title":"The Rt Hon Hilary Benn MP","web_url":"https://www.gov.uk/government/people/hilary-benn","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D19","api_path":"/api/content/government/organisations/northern-ireland-office","api_url":"https://www.gov.uk/api/content/government/organisations/northern-ireland-office","base_path":"/government/organisations/northern-ireland-office","content_id":"234148b2-66d6-457c-9d06-2bf2b98533ca","details":{"acronym":"NIO","brand":"northern-ireland-office","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/6708fb1c366f494ab2e7b725/s960_NIO_Gov.uk_banner.png","url":"https://assets.publishing.service.gov.uk/media/6708fb1de84ae1fd8592f1ec/s300_NIO_Gov.uk_banner.png"},"logo":{"crest":"single-identity","formatted_title":"Northern<br/>Ireland<br/>Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Northern Ireland Office","web_url":"https://www.gov.uk/government/organisations/northern-ireland-office","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--256","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--256","base_path":"/government/ministers/parliamentary-under-secretary-of-state--256","content_id":"d9972b0f-b836-4161-825e-004db0281512","details":{"body":"<p>The minister’s responsibilities include:</p>\n\n<ul>\n  <li>early years education including for children with special educational needs and disabilities (SEND)</li>\n  <li>childcare and the home learning environment</li>\n  <li>early years workforce</li>\n  <li>early communication skills and early intervention</li>\n  <li>Best Start Family Hubs and parenting</li>\n  <li>breakfast clubs</li>\n  <li>school food, including free school meals</li>\n  <li>holiday activities and food (HAF) programme</li>\n  <li>school attendance, including register of children who are not in school</li>\n  <li>reception admissions</li>\n  <li>changes to existing schools</li>\n  <li>home-to-school transport</li>\n  <li>mental health support in schools</li>\n  <li>behaviour, preventing bullying and exclusions in schools</li>\n  <li>school uniform</li>\n  <li>young carers</li>\n  <li>independent schools</li>\n  <li>illegal schools</li>\n  <li>faith schools</li>\n  <li>intervention in failing schools and school improvement</li>\n  <li>use of data, digital technology and artificial intelligence (AI) in education</li>\n  <li>use of research, science and evidence at DfE</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:16:04Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Early Education)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--256","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--297","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--297","base_path":"/government/ministers/parliamentary-under-secretary-of-state--297","content_id":"b0705070-d25c-4043-9264-9dec83a79595","details":{"body":"\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-09-07T14:57:26Z","schema_name":"role","title":"Parliamentary Under-Secretary of State","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--297","withdrawn":false},{"api_path":"/api/content/government/ministers/paymaster-general","api_url":"https://www.gov.uk/api/content/government/ministers/paymaster-general","base_path":"/government/ministers/paymaster-general","content_id":"1647e073-8e16-4944-85f4-cf665ce21cba","details":{"body":"\n","role_payment_type":null,"seniority":33,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-27T11:05:33Z","schema_name":"role","title":"Paymaster General","web_url":"https://www.gov.uk/government/ministers/paymaster-general","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-northern-ireland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-northern-ireland","base_path":"/government/ministers/secretary-of-state-for-northern-ireland","content_id":"845e6581-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for the ministerial work of the Northern Ireland Office.</p>\n\n<p>The Secretary of State leads on:</p>\n\n<ul>\n  <li>engagement with the NI Executive (focusing on the Executive Office, Department of Justice, Department of Finance and Department of Agriculture, Environment and Rural Affairs)</li>\n  <li>political stability</li>\n  <li>relationships with other governments</li>\n  <li>implementation of the Windsor Framework</li>\n  <li>legacy</li>\n  <li>national security</li>\n  <li>work to ensure that NI is fully engaged in the development and delivery of new government policy, especially the Missions-led approach</li>\n</ul>\n\n<p>He also has overall responsibility for the NIO’s parliamentary activity.</p>\n","role_payment_type":null,"seniority":25,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-07-21T07:40:27Z","schema_name":"role","title":"Secretary of State for Northern Ireland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-northern-ireland","withdrawn":false}],"taxons":[{"api_path":"/api/content/regional-and-local-government/northern-ireland","api_url":"https://www.gov.uk/api/content/regional-and-local-government/northern-ireland","base_path":"/regional-and-local-government/northern-ireland","content_id":"a1e624ed-e268-44ab-ac3f-4d3cb2bb8cb5","details":{"internal_name":"Northern Ireland [PA]","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/regional-and-local-government","api_url":"https://www.gov.uk/api/content/regional-and-local-government","base_path":"/regional-and-local-government","content_id":"503c5bc7-809a-47b9-83e2-bd0c212dbabb","description":"","details":{"internal_name":"Regional and local government","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:30:05Z","schema_name":"taxon","title":"Regional and local government","web_url":"https://www.gov.uk/regional-and-local-government","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-08-22T13:09:40Z","schema_name":"taxon","title":"Northern Ireland","web_url":"https://www.gov.uk/regional-and-local-government/northern-ireland","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-22T00:01:03+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-01-22T00:01:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":7,"schema_name":"news_article","title":"UK Government Ministers to meet with Northern Ireland schools ahead of East-West Council","updated_at":"2026-08-11T13:41:10+01:00","withdrawn_notice":{}}