ov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/alistair-carns","api_url":"https://www.gov.uk/api/content/government/people/alistair-carns","base_path":"/government/people/alistair-carns","content_id":"85567506-c566-4a74-9f4d-412d540102f5","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-06-11T19:45:19Z","schema_name":"person","title":"Alistair Carns DSO OBE MC MP","web_url":"https://www.gov.uk/government/people/alistair-carns","withdrawn":false},{"api_path":"/api/content/government/people/louise-sandher-jones","api_url":"https://www.gov.uk/api/content/government/people/louise-sandher-jones","base_path":"/government/people/louise-sandher-jones","content_id":"1ac2a507-21a5-477c-a012-c12ea4a38b66","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-14T13:54:32Z","schema_name":"person","title":"Louise Sandher-Jones MP","web_url":"https://www.gov.uk/government/people/louise-sandher-jones","withdrawn":false},{"api_path":"/api/content/government/people/john-healey","api_url":"https://www.gov.uk/api/content/government/people/john-healey","base_path":"/government/people/john-healey","content_id":"6e000fab-7c45-479a-8362-53a971f31f28","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:50:11Z","schema_name":"person","title":"The Rt Hon John Healey MP","web_url":"https://www.gov.uk/government/people/john-healey","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--245","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--245","base_path":"/government/ministers/parliamentary-under-secretary-of-state--245","content_id":"4f2c5528-8485-4290-9394-8d57cc648c00","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of Military Strategic Headquarters (MSHQ)</li>\n  <li>Global Operations and commitments</li>\n  <li>Force Posture and Deployment</li>\n  <li>Homeland Defence and the National Conversation</li>\n  <li>Ukraine support – operations</li>\n  <li>Implementation and delivery of the Uncrewed Systems Centre and Uncrewed Systems Force</li>\n  <li>Intelligence</li>\n  <li>North Atlantic Treaty Organisation (NATO) operations and planning</li>\n  <li>Permanent Joint Operational Bases and Overseas Territories</li>\n  <li>Crisis response</li>\n  <li>Military Aid to Civilian Authority (MACA)</li>\n  <li>Armed Forces Bill</li>\n  <li>UN Peacekeeping and Human Security Call Out Orders</li>\n  <li>Overseas Security and Justice Assistance Reports</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:29:43Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for the Armed Forces)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--245","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--287","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--287","base_path":"/government/ministers/parliamentary-under-secretary-of-state--287","content_id":"f6a289aa-d881-4b3f-9607-825dad929c79","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the Department of State</li>\n  <li>Recruitment</li>\n  <li>Retention and incentivisation, including training, skills and development</li>\n  <li>Service resettlement and transition</li>\n  <li>Office for Veterans Affairs (including veterans policy, delivery and VALOUR)</li>\n  <li>Armed Forces Covenant</li>\n  <li>Armed Forces People</li>\n  <li>Armed Forces Families</li>\n  <li>Housing (including Defence Housing Service)</li>\n  <li>Civilian workforce (including Royal Fleet Auxillary)</li>\n  <li>Defence Business Services (including legal, pensions and compensation)</li>\n  <li>Defence culture – including oversight of the Raising our Standards Programme and Equality, Diversity and Inclusion</li>\n  <li>Service Justice System and Service Complaints</li>\n  <li>Armed Forces Commissioner</li>\n  <li>Reserves (including strategic reserves)</li>\n  <li>Cadets</li>\n  <li>Northern Ireland</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T10:09:12Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Veterans and People) ","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--287","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/working-armed-forces","api_url":"https://www.gov.uk/api/content/defence/working-armed-forces","base_path":"/defence/working-armed-forces","content_id":"8ff8cf05-a6e6-4757-a896-4fabd9f3229a","details":{"internal_name":"Armed forces [M] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:52Z","schema_name":"taxon","title":"Armed forces","web_url":"https://www.gov.uk/defence/working-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-15T18:35:15+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"news_article","title":"Major boost to pool of skilled former military personnel called upon in crises as UK strengthen preparedness","updated_at":"2026-08-25T11:09:14+01:00","withdrawn_notice":{}}