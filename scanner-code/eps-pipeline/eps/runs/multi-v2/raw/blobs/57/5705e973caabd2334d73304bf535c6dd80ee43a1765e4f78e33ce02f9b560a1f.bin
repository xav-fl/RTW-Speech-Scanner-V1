er-labour-government","base_path":"/government/2024-starmer-labour-government","content_id":"9dbff654-cdeb-4ebe-9a12-cd4cc20a033e","details":{"current":false,"ended_on":"2026-07-20T00:00:00+00:00","started_on":"2024-07-05T00:00:00+00:00"},"document_type":"government","links":{},"locale":"en","title":"2024 to 2026 Starmer Labour government","web_url":"https://www.gov.uk/government/2024-starmer-labour-government"}],"organisations":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false},{"analytics_identifier":"D10","api_path":"/api/content/government/organisations/department-for-work-pensions","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-work-pensions","base_path":"/government/organisations/department-for-work-pensions","content_id":"b548a09f-8b35-4104-89f4-f1a40bf3136d","details":{"acronym":"DWP","brand":"department-for-work-pensions","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/5a37dab1e5274a7908e35204/s960_dwp-caxton-house-logo-960.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37dab040f0b649cfaf7b4b/s300_dwp-caxton-house-logo-960.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department<br/>for Work &amp; <br/>Pensions"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Work and Pensions","web_url":"https://www.gov.uk/government/organisations/department-for-work-pensions","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/jacqui-smith","api_url":"https://www.gov.uk/api/content/government/people/jacqui-smith","base_path":"/government/people/jacqui-smith","content_id":"8d7c6906-f1dd-4a7d-ba70-ecd1a08aefe6","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-08-11T12:37:23Z","schema_name":"person","title":"The Rt Hon Baroness Smith of Malvern","web_url":"https://www.gov.uk/government/people/jacqui-smith","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--175","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--175","base_path":"/government/ministers/minister-of-state--175","content_id":"5dc89f34-86e1-4173-9980-0a525d4ef2f3","details":{"body":"<p>The minister’s Department for Education (DfE) responsibilities include:</p>\n\n<ul>\n  <li>governance, intervention and accountability of further education colleges</li>\n  <li>funding for education and training, provision and outcomes for 16- to 19-year-olds</li>\n  <li>further education financial stability and workforce</li>\n  <li>access to higher education, participation and lifelong learning entitlement</li>\n  <li>quality of higher education and the student experience (including the <a rel=\"external\" href=\"https://www.officeforstudents.org.uk/\">Office for Students</a>)</li>\n  <li>student finance (including the <a href=\"https://www.gov.uk/government/organisations/student-loans-company\">Student Loans Company</a>)</li>\n  <li>technical and vocational qualifications (level 3 and below), including T Levels</li>\n  <li>higher technical education (levels 4 and 5)</li>\n  <li>careers advice</li>\n  <li>support for young people aged 16 to 19 not in employment, education or training (NEET)</li>\n  <li>skills strategy and delivery</li>\n  <li>technical excellence colleges</li>\n  <li>international education</li>\n</ul>\n\n<p>The minister’s Department for Work and Pensions (DWP) responsibilities include:</p>\n\n<ul>\n  <li>\n<a href=\"https://www.gov.uk/government/organisations/skills-england\">Skills England</a> and Industry Training Boards</li>\n  <li>adult education, including basic skills</li>\n  <li>apprenticeships, including the growth and skills levy</li>\n  <li>skills bootcamps</li>\n  <li>sector skills packages</li>\n  <li>careers advice and support for young people over the age of 19 not in employment, education or training (NEET)</li>\n  <li>Youth Guarantee</li>\n</ul>\n\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:15:41Z","schema_name":"role","title":"Minister of State (Minister for Skills)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--175","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/apprenticeships-traineeships-and-internships","api_url":"https://www.gov.uk/api/content/education/apprenticeships-traineeships-and-internships","base_path":"/education/apprenticeships-traineeships-and-internships","content_id":"aaeb7f58-d410-4c42-8775-05b0bdeceeea","description":"Finding an apprenticeship, internship or traineeship plus guidance for employers on offering training opportunities.","details":{"internal_name":"Apprenticeships, traineeships and internships","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-05-30T09:56:25Z","schema_name":"taxon","title":"Apprenticeships, traineeships and internships","web_url":"https://www.gov.uk/education/apprenticeships-traineeships-and-internships","withdrawn":false},{"api_path":"/api/content/education/school-buildings-and-land","api_url":"https://www.gov.uk/api/content/education/school-buildings-and-land","base_path":"/education/school-buildings-and-land","content_id":"059e1b97-c18b-4043-94a5-59004df8282d","description":"How to develop school land sustainably. Design and maintenance, transactions and guidelines, standards for school premises.","details":{"internal_name":"School buildings and land","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/running-and-managing-a-school","api_url":"https://www.gov.uk/api/content/education/runni