mat_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"699722c7339ee33f3ad0b971","filename":"Feb_2026_Community__Update_Urdu.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":264738,"filename":"Feb_2026_Community__Update_Urdu.pdf","hoc_paper_number":"","id":"9142866","isbn":"","number_of_pages":2,"title":"Grenfell Tower: community update February 2026 - Urdu","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/699722c7339ee33f3ad0b971/Feb_2026_Community__Update_Urdu.pdf"},{"accessible":true,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"699722d9bfdab2546272bffb","filename":"Feb_2026_Community__Update_Vietnamese.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":238684,"filename":"Feb_2026_Community__Update_Vietnamese.pdf","hoc_paper_number":"","id":"9142867","isbn":"","number_of_pages":3,"title":"Grenfell Tower: community update February 2026 - Vietnamese","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/699722d9bfdab2546272bffb/Feb_2026_Community__Update_Vietnamese.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"698b30ec95285e721cd71285","filename":"Noise_Monitoring_Report_5_January_to_1_February_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":1689364,"filename":"Noise_Monitoring_Report_5_January_to_1_February_2026.pdf","id":"9126726","isbn":"","number_of_pages":16,"title":"Noise Monitoring Report 5 January to 1 February 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/698b30ec95285e721cd71285/Noise_Monitoring_Report_5_January_to_1_February_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"69971ddc047739fe61889e53","filename":"Dust_Monitoring_Report_5_January_to_1_February_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":3910538,"filename":"Dust_Monitoring_Report_5_January_to_1_February_2026.pdf","hoc_paper_number":"","id":"9126727","isbn":"","number_of_pages":17,"title":"Dust Monitoring Report 5 January to 1 February 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/69971ddc047739fe61889e53/Dust_Monitoring_Report_5_January_to_1_February_2026.pdf"},{"accessible":false,"alternative_format_contact_email":"alternativeformats@communities.gov.uk","assets":[{"asset_manager_id":"698b310c8492b54795c1be2d","filename":"Vibration_Monitoring_Report_5_January_to_1_February_2026.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":2035848,"filename":"Vibration_Monitoring_Report_5_January_to_1_February_2026.pdf","id":"9126728","isbn":"","number_of_pages":13,"title":"Vibration Monitoring Report 5 January to 1 February 2026","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/698b310c8492b54795c1be2d/Vibration_Monitoring_Report_5_January_to_1_February_2026.pdf"}],"body":"<div class=\"govspeak\"><p>The government recognises that Grenfell Tower has a deep personal significance to those most affected by the tragedy and that all work at the Grenfell Tower site is sensitive. We are continuing to share information about the Tower, and listen to bereaved families, survivors and residents in the immediate community. </p>\n\n<p>In this community update we provide information about how the government and its contractors are starting to take down Grenfell Tower with respect and care. This update is translated into 12 additional languages.</p>\n\n<p>We are also publishing information about our monitoring of noise, dust and vibration levels.</p>\n\n<ul>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/698b30ec95285e721cd71285/Noise_Monitoring_Report_5_January_to_1_February_2026.pdf\">Noise monitoring report: 5 January to 1 February 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/69971ddc047739fe61889e53/Dust_Monitoring_Report_5_January_to_1_February_2026.pdf\">Dust monitoring report: 5 January to 1 February 2026</a></li>\n  <li><a rel=\"external\" href=\"https://assets.publishing.service.gov.uk/media/698b310c8492b54795c1be2d/Vibration_Monitoring_Report_5_January_to_1_February_2026.pdf\">Vibration monitoring report: 5 January to 1 February 2026</a></li>\n</ul>\n\n<p>If you would like a translation of these documents please email <a href=\"mailto:GrenfellTowerSite@communities.gov.uk\">GrenfellTowerSite@communities.gov.uk</a>.</p>\n</div>","change_history":[{"note":"First published.","public_timestamp":"2026-02-24T09:00:03Z"}],"document_type_label":"Correspondence","documents":["<section data-module=\"ga4-link-tracker\" class=\"gem-c-attachment govuk-!-margin-bottom-6\">\n  <div class=\"gem-c-attachment__thumbnail govuk-!-display-none-print\">\n    <a class=\"govuk-link\" target=\"_self\" tabindex=\"-1\" aria-hidden=\"true\" data-ga4-link=\"{&quot;event_name&quot;:&quot;file_download&quot;,&quot;type&quot;:&quot;attachment&quot;}\" href=\"https://assets.publishing.service.gov.uk/media/69972200047739fe61889e55/Feb_2026_Community__Update.pdf\">\n        <svg class=\"gem-c-attachment__thumbnail-image gem-c-attachment__thumbnail-image--pdf\" version=\"1.1\" viewBox=\"0 0 99 140\">\n  <path d=\"M12,59h9v9h-9v-9ZM30,77v9h39v-9H30ZM30,104h57v-9H30v9ZM30,122h48v-9H30v9ZM12,86h9v-