fadden","content_id":"8edaa0e5-56c0-435a-bf6d-8185f04e4805","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-28T10:00:29Z","schema_name":"person","title":"The Rt Hon Pat McFadden MP","web_url":"https://www.gov.uk/government/people/pat-mcfadden","withdrawn":false},{"api_path":"/api/content/government/people/bridget-phillipson","api_url":"https://www.gov.uk/api/content/government/people/bridget-phillipson","base_path":"/government/people/bridget-phillipson","content_id":"a7dd7b5e-8729-4de4-9cab-90af6d8747f9","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-21T10:45:09Z","schema_name":"person","title":"The Rt Hon Bridget Phillipson MP","web_url":"https://www.gov.uk/government/people/bridget-phillipson","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D6","api_path":"/api/content/government/organisations/department-for-education","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-education","base_path":"/government/organisations/department-for-education","content_id":"ebd15ade-73b2-4eaf-b1c3-43034a42eb37","details":{"acronym":"DfE","brand":"department-for-education","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/69de23bb9af91e9ee4b2c327/s960_DfE_Sanctuary_Building_London_office.jpeg","url":"https://assets.publishing.service.gov.uk/media/69de23bb3e81003ae042250c/s300_DfE_Sanctuary_Building_London_office.jpeg"},"logo":{"crest":"single-identity","formatted_title":"Department <br/>for Education"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Education","web_url":"https://www.gov.uk/government/organisations/department-for-education","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/secretary-of-state-for-work-and-pensions","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-work-and-pensions","base_path":"/government/ministers/secretary-of-state-for-work-and-pensions","content_id":"845e6272-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State has overall responsibility for the business of the department, including the Departmental Strategy, planning and performance, reporting and governance requirements. They have direct responsibility for departmental expenditure.</p>\n\n<p><abbr title=\"Department for Work and Pensions\">DWP</abbr> is responsible for the administration of the State Pension and working age benefits system, providing support to:</p>\n\n<ul>\n  <li>people of working age</li>\n  <li>employers</li>\n  <li>pensioners</li>\n  <li>families and children</li>\n  <li>disabled people</li>\n</ul>\n\n","role_payment_type":null,"seniority":10,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-14T08:51:13Z","schema_name":"role","title":"Secretary of State for Work and Pensions","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-work-and-pensions","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-education","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-education","base_path":"/government/ministers/secretary-of-state-for-education","content_id":"845e63b4-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State is responsible for the work of the Department for Education, including:</p>\n\n<ul>\n  <li>early years and childcare</li>\n  <li>children’s social care</li>\n  <li>teacher quality, recruitment and retention</li>\n  <li>the school curriculum</li>\n  <li>school improvement</li>\n  <li>academies and free schools</li>\n  <li>further education</li>\n  <li>apprenticeships and skills</li>\n  <li>higher education</li>\n</ul>\n\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2022-11-08T09:31:05Z","schema_name":"role","title":"Secretary of State for Education","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-education","withdrawn":false}],"taxons":[{"api_path":"/api/content/education/apprenticeships-traineeships-and-internships","api_url":"https://www.gov.uk/api/content/education/apprenticeships-traineeships-and-internships","base_path":"/education/apprenticeships-traineeships-and-internships","content_id":"aaeb7f58-d410-4c42-8775-05b0bdeceeea","description":"Finding an apprenticeship, internship or traineeship plus guidance for employers on offering training opportunities.","details":{"internal_name":"Apprenticeships, traineeships and internships","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education/further-and-higher-education-skills-and-vocational-training","api_url":"https://www.gov.uk/api/content/education/further-and-higher-education-skills-and-vocational-training","base_path":"/education/further-and-higher-education-skills-and-vocational-training","content_id":"dd767840-363e-43ad-8835-c9ab516633de","description":"University and college qualifications. Apprenticeships, traineeships and internships. Funding for further education providers.","details":{"internal_name":"Further and higher education, skills and vocational training","notes_for_editors":""},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/education","api_url":"https://www.gov.uk/api/content/education","base_path":"/education","content_id":"c58fdadd-7743-46d6-9629-90bb3ccc4ef0","description":"Schools and academies, further and higher education, apprenticeships and other skills training, student funding, early years.","details":{"internal_name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":