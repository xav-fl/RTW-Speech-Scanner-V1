name":"Education, training and skills","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-06-07T15:19:07Z","schema_name":"taxon","title":"Education, training and skills","web_url":"https://www.gov.uk/education","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2017-03-06T09:19:22Z","schema_name":"taxon","title":"Further and higher education, skills and vocational training","web_url":"https://www.gov.uk/education/further-and-higher-education-skills-and-vocational-training","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2019-05-30T10:01:59Z","schema_name":"taxon","title":"Further and higher education courses and qualifications","web_url":"https://www.gov.uk/education/further-and-higher-education-courses-and-qualifications","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-01-21T06:30:06+00:00","publishing_app":"whitehall","publishing_request_id":"21-1776165817.491-10.13.22.123-160236","publishing_scheduled_at":"2026-01-21T06:30:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":7,"schema_name":"news_article","title":"Cutting-edge drone degree to train military forces of the future unveiled","updated_at":"2026-08-25T10:29:45+01:00","withdrawn_notice":{}}