ps://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false},{"analytics_identifier":"D1423","api_path":"/api/content/government/organisations/scotland-office","api_url":"https://www.gov.uk/api/content/government/organisations/scotland-office","base_path":"/government/organisations/scotland-office","content_id":"63953ed9-98ac-4d08-a1b9-8ea38dbd0832","details":{"acronym":"","brand":"scotland-office","default_news_image":null,"logo":{"crest":"so","formatted_title":"Scotland Office"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Scotland Office","web_url":"https://www.gov.uk/government/organisations/scotland-office","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/luke-pollard","api_url":"https://www.gov.uk/api/content/government/people/luke-pollard","base_path":"/government/people/luke-pollard","content_id":"0e11b976-f017-4c29-b0f2-94468466af99","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-22T15:26:00Z","schema_name":"person","title":"Luke Pollard MP","web_url":"https://www.gov.uk/government/people/luke-pollard","withdrawn":false},{"api_path":"/api/content/government/people/douglas-alexander","api_url":"https://www.gov.uk/api/content/government/people/douglas-alexander","base_path":"/government/people/douglas-alexander","content_id":"93f2d702-c240-4895-bbdd-bde1d2fbc16d","document_type":"person","links":{},"locale":"en","public_updated_at":"2025-09-05T19:03:52Z","schema_name":"person","title":"The Rt Hon Douglas Alexander MP","web_url":"https://www.gov.uk/government/people/douglas-alexander","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/minister-of-state--207","api_url":"https://www.gov.uk/api/content/government/ministers/minister-of-state--207","base_path":"/government/ministers/minister-of-state--207","content_id":"47758af5-c983-42a1-bce4-e27428d164fb","details":{"body":"<ul>\n  <li>Implementation of relevant SDR Vision and Defence Investment Plan</li>\n  <li>Oversight of the National Armaments Director Group</li>\n  <li>Departmental communications strategy and reform</li>\n  <li>Armed forces readiness and stockpiles</li>\n  <li>Defence procurement, including reform and UK Defence Innovation</li>\n  <li>Submarine delivery</li>\n  <li>Defence Industrial Strategy implementation and Growth</li>\n  <li>Defence Exports Campaigns and Office</li>\n  <li>Defence Readiness Bill</li>\n  <li>Ukraine support - military aid and industrial partnerships, including HIRST and KINDRED</li>\n  <li>Defence industry relationships and the Defence Industrial Joint Council</li>\n  <li>UK Defence Innovation and artificial intelligence</li>\n  <li>Climate change and sustainability</li>\n  <li>Science and technology</li>\n  <li>Defence Afghanistan Relocation and Assistance Programme (ARAP) including eligibility applications and asylum</li>\n  <li>Oversight of Parliamentary engagement and AFPS</li>\n  <li>Defence Infrastructure Organisation and defence estates</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-25T09:12:36Z","schema_name":"role","title":"Minister of State (Minister for Defence Readiness and Industry)","web_url":"https://www.gov.uk/government/ministers/minister-of-state--207","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-scotland","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-scotland","base_path":"/government/ministers/secretary-of-state-for-scotland","content_id":"845e65ce-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Scotland is the UK Government Cabinet Minister representing Scotland. They act as the custodian of the Scottish devolution settlement, represent Scottish interests within the UK Government, and advocate for the UK Government’s policies in Scotland. </p>\n\n<p>They also promote partnership between the UK Government and the Scottish Government, as well as relations between the UK and Scottish Parliaments.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Industrial Strategy Delivery</li>\n  <li>Local Growth and City Deals Strategy</li>\n  <li>Data, Digital and AI</li>\n  <li>Investment, Economy and Fiscal</li>\n  <li>Defence</li>\n  <li>Energy and North Sea Policy</li>\n  <li>Brand Scotland Programme</li>\n  <li>International &amp; Trade Missions</li>\n  <li>Constitutional and Devolution Policy</li>\n  <li>UK Internal Market</li>\n  <li>Intergovernmental Relations</li>\n  <li>Home Affairs</li>\n  <li>Corporate</li>\n</ul>\n","role_payment_type":null,"seniority":24,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T13:41:13Z","schema_name":"role","title":"Secretary of State for Scotland","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-scotland","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence/military-equipment-logistics-technology","api_url":"https://www.gov.uk/api/content/defence/military-equipment-logistics-technology","base_path":"/defence/military-equipment-logistics-technology","content_id":"ac5d432a-11a9-40e1-bb83-0de26106b9d6","details":{"internal_name":"Military equipment, logistics and technology [T] (level 2, defence theme)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"Military equipment, logistics and technology","web_url":"https://www.gov.uk/defence/military-equipment-logistics-technology","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-03-12T12:00:03+00:00","publishing_app":"whitehall","publishing_request_id":"21-1773658115.790-10.13.22.163-2742","publishing_scheduled_at":"2026-03-12T12:00:00+00:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":3,"schema_name":"news_article","title":"Scotland set for skills and innovation boost as £50 million defence growth deal unveiled","updated_at":"2026-08-25T10:12:39+01:00","withdrawn_notice":{}}