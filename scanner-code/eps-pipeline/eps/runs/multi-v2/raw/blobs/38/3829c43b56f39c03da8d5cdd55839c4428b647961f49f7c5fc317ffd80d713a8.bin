37db21ed915d5a62fdc762/s960_ministry-of-justice.jpg","url":"https://assets.publishing.service.gov.uk/media/5a37db21e5274a7908e352d9/s300_ministry-of-justice.jpg"},"logo":{"crest":"single-identity","formatted_title":"Ministry<br/>of Justice"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Justice","web_url":"https://www.gov.uk/government/organisations/ministry-of-justice","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--257","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--257","base_path":"/government/ministers/parliamentary-under-secretary-of-state--257","content_id":"56176f90-5f7c-4549-a35e-e87ea391daee","details":{"body":"<p>The minister’s responsibilities include:</p>\n\n<ul>\n  <li>children’s social care</li>\n  <li>children in care and children in need</li>\n  <li>looked-after children</li>\n  <li>child protection</li>\n  <li>adoption</li>\n  <li>kinship care and family justice</li>\n  <li>fostering and regional care cooperatives</li>\n  <li>care leavers</li>\n  <li>children’s social care workforce</li>\n  <li>unaccompanied asylum-seeking children</li>\n  <li>single unique identifier for children and use of children’s social care data</li>\n  <li>child protection, safeguarding and serious incidents</li>\n  <li>local authority intervention and improvement</li>\n  <li>family support including the families first programme</li>\n  <li>tackling antisemitism</li>\n  <li>prevention of serious violence in schools and post-16 settings</li>\n  <li>counter extremism in schools and post-16 settings</li>\n  <li>out-of-school settings</li>\n  <li>school safeguarding and guidance on keeping children safe in education</li>\n  <li>creation of new free schools</li>\n  <li>maintenance and improvement of the education estate</li>\n  <li>environmental sustainability in the education sectors</li>\n  <li>deputising for the Secretary of State for Education in emergencies</li>\n</ul>\n","role_payment_type":null,"seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-05-15T17:15:07Z","schema_name":"role","title":"Parliamentary Under-Secretary of State (Minister for Children and Families)","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--257","withdrawn":false},{"api_path":"/api/content/government/ministers/parliamentary-under-secretary-of-state--301","api_url":"https://www.gov.uk/api/content/government/ministers/parliamentary-under-secretary-of-state--301","base_path":"/government/ministers/parliamentary-under-secretary-of-state--301","content_id":"f0651ae4-36ac-4703-9064-826c4f0ddd93","details":{"body":"<ul>\n  <li>Sentencing Policy</li>\n  <li>Sentencing Bill</li>\n  <li>Youth Justice policy</li>\n  <li>Youth Custody operations</li>\n  <li>Human Rights and ECHR</li>\n  <li>International Justice (including Private International Law)</li>\n  <li>Crown Dependencies and Overseas Territories</li>\n  <li>Devolution and the Union</li>\n  <li>Commons Minister for Prisons, Probation and Reducing Reoffending</li>\n  <li>Transparency</li>\n  <li>Cross-cutting corporate portfolio</li>\n  <li>MOJ Mission lead for Breakdown barriers to opportunity</li>\n</ul>\n","role_payment_type":"Paid as a whip","seniority":100,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2025-10-16T13:30:57Z","schema_name":"role","title":"Parliamentary Under-Secretary of State for Sentencing, Youth Justice and International","web_url":"https://www.gov.uk/government/ministers/parliamentary-under-secretary-of-state--301","withdrawn":false}],"taxons":[{"api_path":"/api/content/crime-justice-and-law/prisons-probation","api_url":"https://www.gov.uk/api/content/crime-justice-and-law/prisons-probation","base_path":"/crime-justice-and-law/prisons-probation","content_id":"1dd3f25a-9237-4143-b2d2-cd7f6863c9c0","details":{"internal_name":"Prisons and probation [T] (merged, level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/crime-justice-and-law","api_url":"https://www.gov.uk/api/content/crime-justice-and-law","base_path":"/crime-justice-and-law","content_id":"ba951b09-5146-43be-87af-44075eac3ae9","description":"","details":{"internal_name":"Crime, justice and law","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:51Z","schema_name":"taxon","title":"Crime, justice and law","web_url":"https://www.gov.uk/crime-justice-and-law","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:15:51Z","schema_name":"taxon","title":"Prisons and probation","web_url":"https://www.gov.uk/crime-justice-and-law/prisons-probation","withdrawn":false},{"api_path":"/api/content/childcare-parenting/childrens-health-and-welfare","api_url":"https://www.gov.uk/api/content/childcare-parenting/childrens-health-and-welfare","base_path":"/childcare-parenting/childrens-health-and-welfare","content_id":"2389dfd4-a0c4-4bd2-b7e6-06f465463d22","description":"Children's rights, child poverty, mental health, young carers, special educational needs and disabilities (SEND).","details":{"internal_name":"Children's health and welfare","notes_for_editors":"","visible_to_departmental_editors":false},"d