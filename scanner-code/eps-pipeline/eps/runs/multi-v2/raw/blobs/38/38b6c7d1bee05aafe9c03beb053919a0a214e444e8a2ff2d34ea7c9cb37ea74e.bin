{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/656df1fd1104cf000dfa74a1/s960_whitehall-place-exterior-960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/656df1fd0f12ef07a53e01be/s300_whitehall-place-exterior-960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Energy Security<br/>&amp; Net Zero"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Energy Security and Net Zero","web_url":"https://www.gov.uk/government/organisations/department-for-energy-security-and-net-zero","withdrawn":false},{"analytics_identifier":"D17","api_path":"/api/content/government/organisations/ministry-of-defence","api_url":"https://www.gov.uk/api/content/government/organisations/ministry-of-defence","base_path":"/government/organisations/ministry-of-defence","content_id":"d994e55c-48c9-4795-b872-58d8ec98af12","details":{"acronym":"MOD","brand":"ministry-of-defence","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/63495d46d3bf7f618eda94d2/s960_ministry-of-defence-building.jpg","url":"https://assets.publishing.service.gov.uk/media/63495d468fa8f5346732690e/s300_ministry-of-defence-building.jpg"},"logo":{"crest":"mod","formatted_title":"Ministry<br/>of Defence"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Ministry of Defence","web_url":"https://www.gov.uk/government/organisations/ministry-of-defence","withdrawn":false}],"people":[{"api_path":"/api/content/government/people/rachel-reeves","api_url":"https://www.gov.uk/api/content/government/people/rachel-reeves","base_path":"/government/people/rachel-reeves","content_id":"18ff123b-9f73-4e6d-98a2-a693ecefbc37","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:48:57Z","schema_name":"person","title":"The Rt Hon Rachel Reeves MP","web_url":"https://www.gov.uk/government/people/rachel-reeves","withdrawn":false},{"api_path":"/api/content/government/people/john-healey","api_url":"https://www.gov.uk/api/content/government/people/john-healey","base_path":"/government/people/john-healey","content_id":"6e000fab-7c45-479a-8362-53a971f31f28","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:50:11Z","schema_name":"person","title":"The Rt Hon John Healey MP","web_url":"https://www.gov.uk/government/people/john-healey","withdrawn":false},{"api_path":"/api/content/government/people/ed-miliband","api_url":"https://www.gov.uk/api/content/government/people/ed-miliband","base_path":"/government/people/ed-miliband","content_id":"0fdeeed1-bdca-46f9-b6f2-1aade6bf10e0","document_type":"person","links":{},"locale":"en","public_updated_at":"2026-07-20T17:56:00Z","schema_name":"person","title":"The Rt Hon Ed Miliband MP","web_url":"https://www.gov.uk/government/people/ed-miliband","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"D1380","api_path":"/api/content/government/organisations/department-for-energy-security-and-net-zero","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-energy-security-and-net-zero","base_path":"/government/organisations/department-for-energy-security-and-net-zero","content_id":"6315817c-ef11-4905-bb4d-b6dca8e9052c","details":{"acronym":"DESNZ","brand":"department-for-business-innovation-skills","default_news_image":{"high_resolution_url":"https://assets.publishing.service.gov.uk/media/656df1fd1104cf000dfa74a1/s960_whitehall-place-exterior-960x640.jpg","url":"https://assets.publishing.service.gov.uk/media/656df1fd0f12ef07a53e01be/s300_whitehall-place-exterior-960x640.jpg"},"logo":{"crest":"single-identity","formatted_title":"Department for<br/>Energy Security<br/>&amp; Net Zero"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Department for Energy Security and Net Zero","web_url":"https://www.gov.uk/government/organisations/department-for-energy-security-and-net-zero","withdrawn":false}],"roles":[{"api_path":"/api/content/government/ministers/chancellor-of-the-exchequer","api_url":"https://www.gov.uk/api/content/government/ministers/chancellor-of-the-exchequer","base_path":"/government/ministers/chancellor-of-the-exchequer","content_id":"845e5c6b-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Chancellor of the Exchequer is the government’s chief financial minister and is responsible for growing the UK economy, raising revenue through taxation or borrowing and for controlling public spending. He has overall responsibility for the work of the Treasury. </p>\n\n<p>The Chancellor’s responsibilities cover:  </p>\n\n<ul>\n  <li>\n    <p>Economic and fiscal policy (including presenting the annual Budget) </p>\n  </li>\n  <li>\n    <p>Oversight of the monetary framework, including setting the inflation remit, and liaison with the Governor of the Bank of England on monetary policy </p>\n  </li>\n  <li>\n    <p>UK growth and productivity, including working across government on innovation, new technologies, skills, labour markets, migration and competition.   </p>\n  </li>\n  <li>\n    <p>UK public financial institutions  </p>\n  </li>\n  <li>\n    <p>Capital markets and listings </p>\n  </li>\n  <li>\n    <p>Leading on international economic and financial affairs including at the G7 and G20 and acting as the UK Governor of the IMF, EBRD and AIIB.  </p>\n  </li>\n  <li>\n    <p>Economic security and resilience policy </p>\n  </li>\n  <li>\n    <p>International defence and security financing</p>\n  </li>\n</ul>\n","role_payment_type":null,"seniority":8,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T17:12:00Z","schema_name":"role","title":"Chancellor of the Exchequer","web_url":"https://www.gov.uk/government/ministers/chancellor-of-the-exchequer","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state-for-defence","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state-for-defence","base_path":"/government/ministers/secretary-of-state-for-defence","content_id":"845e5e80-c0f1-11e4-8223-005056011aef","details":{"body":"<p>The Secretary of State for Defence has overall responsibility for the business of the department.</p>\n\n<p>Responsibilities include:</p>\n\n<ul>\n  <li>Strategic policy and operational oversight including as a member of the National Security Council</li>\n  <li>Nuclear deterrent (CASD) and operations policy and enterprise</li>\n  <li>Strategic overview of the Strategic Defence Review Implementation and Defence Investment Plan</li>\n  <li>Defence budget</li>\n  <li>Euro-Atlantic strategy and planning</li>\n  <li>Defence strategy, planning, programme, and resource allocation</li>\n  <li>Relationships with strategic international partners: US, France, Germany, Australia, Ukraine</li>\n  <li>One Defence Reform Programme</li>\n  <li>Oversight of Veterans</li>\n  <li>Service Personnel deaths on duty and letters of condolence</li>\n  <li>Strategic multilateral programmes – AUKUS and GCAP</li>\n  <li>Regulatory functions</li>\n  <li>Support on Afghan Inquiry</li>\n</ul>\n","role_payment_type":null,"seniority":11,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2026-08-14T12:39:26Z","schema_name":"role","title":"Secretary of State for Defence","web_url":"https://www.gov.uk/government/ministers/secretary-of-state-for-defence","withdrawn":false},{"api_path":"/api/content/government/ministers/secretary-of-state","api_url":"https://www.gov.uk/api/content/government/ministers/secretary-of-state","base_path":"/government/ministers/secretary-of-state","content_id":"acde07a8-5971-4b2c-a34c-5ad9eed5ef9d","details":{"body":"<p>The Secretary of State has overall responsibility for the Department for Energy Security and Net Zero.</p>\n","role_payment_type":null,"seniority":16,"whip_organisation":{}},"document_type":"ministerial_role","links":{},"locale":"en","public_updated_at":"2023-02-28T11:43:03Z","schema_name":"role","title":"Secretary of State for Energy Security and Net Zero","web_url":"https://www.gov.uk/government/ministers/secretary-of-state","withdrawn":false}],"taxons":[{"api_path":"/api/content/defence-and-armed-forces/uk-nuclear-deterrent","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces/uk-nuclear-deterrent","base_path":"/defence-and-armed-forces/uk-nuclear-deterrent","content_id":"d6fc8b39-351d-4d3f-a938-4a86f38906bc","description":"","details":{"internal_name":"UK nuclear deterrent [P] (level 2)","notes_for_editors":"","visible_to_departmental_editors":false},"document_type":"taxon","links":{"parent_taxons":[{"api_path":"/api/content/defence-and-armed-forces","api_url":"https://www.gov.uk/api/content/defence-and-armed-forces","base_path":"/defence-and-armed-forces","content_id":"e491505c-77ae-45b2-84be-8c94b94f6a2b","description":"","details":{"internal_name":"Defence and armed forces","notes_for_editors":"","visible_to_departmental_editors":true},"document_type":"taxon","links":{"root_taxon":[{"api_path":"/api/content/","api_url":"https://www.gov.uk/api/content/","base_path":"/","content_id":"f3bbdec2-0e62-4520-a7fd-6ffd5d36e03a","document_type":"homepage","links":{},"locale":"en","public_updated_at":"2026-02-18T13:00:23Z","schema_name":"homepage","title":"GOV.UK homepage","web_url":"https://www.gov.uk/","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-16T20:34:16Z","schema_name":"taxon","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_upd