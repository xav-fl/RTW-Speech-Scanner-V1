community","web_url":"https://www.gov.uk/housing-local-and-community","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2022-02-14T14:24:18Z","schema_name":"taxon","title":"Housing and communities","web_url":"https://www.gov.uk/housing-local-and-community/housing-and-communities","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-16T14:28:29+01:00","publishing_app":"whitehall","publishing_request_id":"21-1781616509.118-10.13.20.128-2317","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"speech","title":"New Local's Stronger Things Conference","updated_at":"2026-08-14T15:46:18+01:00","withdrawn_notice":{}}