","title":"Defence and armed forces","web_url":"https://www.gov.uk/defence-and-armed-forces","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2018-09-05T16:16:53Z","schema_name":"taxon","title":"Military equipment, logistics and technology","web_url":"https://www.gov.uk/defence/military-equipment-logistics-technology","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-06-30T15:48:43+01:00","publishing_app":"whitehall","publishing_request_id":"21-1782830923.295-10.13.22.246-2350","publishing_scheduled_at":null,"rendering_app":"frontend","scheduled_publishing_delay_seconds":null,"schema_name":"speech","title":"Defence Investment Plan - Oral Statement","updated_at":"2026-08-14T17:39:55+01:00","withdrawn_notice":{}}