_url":"https://www.gov.uk/childcare-parenting/safeguarding-child-protection","withdrawn":false}]},"locale":"en","phase":"live","public_updated_at":"2026-04-16T00:01:05+01:00","publishing_app":"whitehall","publishing_request_id":"21-1776269489.931-10.13.22.123-2385","publishing_scheduled_at":"2026-04-16T00:01:00+01:00","rendering_app":"frontend","scheduled_publishing_delay_seconds":6,"schema_name":"news_article","title":"Government to examine deaths of vulnerable care leavers","updated_at":"2026-08-11T13:44:45+01:00","withdrawn_notice":{}}